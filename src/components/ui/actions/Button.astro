---
type ButtonVariant = 'primary' | 'secondary' | 'nav-accent' | 'warning' | 'danger' | 'ghost' | 'add' | 'preset' | 'iconDanger' | 'step' | 'toolbar';

interface Props {
	variant?: ButtonVariant;
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
	disabled?: boolean;
	block?: boolean;
	large?: boolean;
	name?: string;
	value?: string;
	confirm?: string;
	formaction?: string;
	formnovalidate?: boolean;
	id?: string;
	dataset?: Record<string, string>;
}

const {
	variant = 'primary',
	href,
	type = 'button',
	class: className = '',
	disabled,
	block,
	large,
	name,
	value,
	confirm,
	formaction,
	formnovalidate,
	id,
	dataset = {},
} = Astro.props;

const dataAttrs = Object.fromEntries(
	Object.entries(dataset)
		.filter(([, value]) => value !== undefined)
		.map(([key, value]) => [`data-${key}`, value ?? '']),
);

const variantClass =
	variant === 'iconDanger' ? 'ui-btn--icon-danger' : `ui-btn--${variant}`;

const classes = [
	'ui-btn',
	variantClass,
	block ? 'ui-btn--block' : '',
	large ? 'ui-btn--lg' : '',
	className,
]
	.filter(Boolean)
	.join(' ');
---

{
	href ? (
		<a href={href} class={classes} id={id}>
			<slot />
		</a>
	) : (
		<button
			type={type}
			class={classes}
			disabled={disabled}
			name={name}
			value={value}
			formaction={formaction}
			formnovalidate={formnovalidate}
			id={id}
			data-confirm={confirm}
			{...dataAttrs}
		>
			<slot />
		</button>
	)
}
