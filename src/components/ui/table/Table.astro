---
interface Props {
	dense?: boolean;
	wrap?: boolean;
	class?: string;
	id?: string;
}

const { dense, wrap = true, class: className = '', id } = Astro.props;
const tableClass = dense ? 'ui-table-dense' : 'ui-table';
---

{
	wrap ? (
		<div class={`ui-table-wrap ${className}`}>
			<table class={tableClass} {id}>
				<slot />
			</table>
		</div>
	) : (
		<table class:list={[tableClass, className]} {id}>
			<slot />
		</table>
	)
}
