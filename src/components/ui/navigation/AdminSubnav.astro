---
import Button from '@/components/ui/actions/Button.astro';

interface Link {
	href: string;
	label: string;
	accent?: boolean;
}

interface Props {
	links: Link[];
}

const { links } = Astro.props;
---

<nav class="ui-subnav" aria-label="Nawigacja administracji">
	{
		links.map((link) =>
			link.accent ? (
				<Button href={link.href} variant="nav-accent">
					{link.label}
				</Button>
			) : (
				<Button href={link.href} variant="secondary">
					{link.label}
				</Button>
			),
		)
	}
</nav>
