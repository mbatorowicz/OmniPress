---
export type PanelVariant = 'default' | 'accent' | 'info' | 'danger' | 'amber' | 'sky';

interface Props {
	variant?: PanelVariant;
	class?: string;
	id?: string;
	tag?: 'section' | 'div' | 'article' | 'form' | 'ul';
}

const { variant = 'default', class: className = '', id, tag: Tag = 'section' } = Astro.props;
---

<Tag id={id} class={`ui-panel ui-panel--${variant} ${className}`}>
	<slot />
</Tag>
