---
interface Props {
	id?: string;
	name?: string;
	value?: string;
	checked?: boolean;
	disabled?: boolean;
	class?: string;
}

const { id, name, value, checked, disabled, class: className = '' } = Astro.props;
---

<input
	type="checkbox"
	{id}
	{name}
	{value}
	checked={checked}
	{disabled}
	class:list={['ui-checkbox', className]}
/>
