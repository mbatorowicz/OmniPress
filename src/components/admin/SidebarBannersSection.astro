---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import type { CategoryDefinition, SidebarBanner } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	banners: SidebarBanner[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { banners, categories, publishedPages } = Astro.props;
const { fields, actions, bannerLinkTypes, bannerStyles, bannerImageVariants } = adminLayout;
---

<Panel class="ui-form-section">
	<h2 class="ui-section-title">{adminLayout.sections.banners}</h2>
	<p class="ui-hint">{adminLayout.bannersHint}</p>

	<div class="overflow-x-auto">
		<table class="ui-table-dense min-w-[72rem]" id="banners-table">
			<thead>
				<tr class="ui-table-dense-head">
					<th class="ui-table-dense-th">{fields.bannerLabel}</th>
					<th class="ui-table-dense-th">{fields.bannerStyle}</th>
					<th class="ui-table-dense-th">{fields.bannerImageUrl}</th>
					<th class="ui-table-dense-th">{fields.bannerImageVariant}</th>
					<th class="ui-table-dense-th">{fields.bannerTextTitle}</th>
					<th class="ui-table-dense-th">{fields.bannerTextButton}</th>
					<th class="ui-table-dense-th">{fields.bannerLinkType}</th>
					<th class="ui-table-dense-th">{fields.bannerCategory}</th>
					<th class="ui-table-dense-th">{fields.bannerPage}</th>
					<th class="ui-table-dense-th">{fields.bannerExternalUrl}</th>
					<th class="ui-table-dense-th">{fields.widgetOrder}</th>
					<th class="ui-table-dense-th">{fields.widgetEnabled}</th>
					<th class="ui-table-dense-th">{actions.removeBanner}</th>
				</tr>
			</thead>
			<tbody id="banners-body">
				{
					banners.map((banner) => (
						<tr class="banner-row ui-table-dense-row" data-banner-id={banner.id}>
							<td class="ui-table-dense-td">
								<input type="hidden" name="banner_id" value={banner.id} />
								<input name="banner_label" value={banner.label} required class="ui-input-compact w-36" />
							</td>
							<td class="ui-table-dense-td">
								<select name="banner_style" class="banner-style ui-select-compact">
									<option value="image" selected={banner.style !== 'text'}>{bannerStyles.image}</option>
									<option value="text" selected={banner.style === 'text'}>{bannerStyles.text}</option>
								</select>
							</td>
							<td class="ui-table-dense-td banner-field-image">
								<input name="banner_image_url" value={banner.imageUrl ?? ''} class="ui-input-compact ui-input-compact--mono w-44" />
							</td>
							<td class="ui-table-dense-td banner-field-image">
								<select name="banner_image_variant" class="ui-select-compact">
									<option value="default" selected={banner.imageVariant !== 'blue'}>{bannerImageVariants.default}</option>
									<option value="blue" selected={banner.imageVariant === 'blue'}>{bannerImageVariants.blue}</option>
								</select>
							</td>
							<td class="ui-table-dense-td banner-field-text">
								<input name="banner_text_title" value={banner.textTitle ?? ''} class="ui-input-compact w-32" />
							</td>
							<td class="ui-table-dense-td banner-field-text">
								<input name="banner_text_button" value={banner.textButton ?? ''} class="ui-input-compact w-28" />
							</td>
							<td class="ui-table-dense-td">
								<select name="banner_link_type" class="banner-link-type ui-select-compact">
									<option value="category" selected={banner.linkType === 'category'}>{bannerLinkTypes.category}</option>
									<option value="page" selected={banner.linkType === 'page'}>{bannerLinkTypes.page}</option>
									<option value="external" selected={banner.linkType === 'external'}>{bannerLinkTypes.external}</option>
								</select>
							</td>
							<td class="ui-table-dense-td banner-field-category">
								<select name="banner_category_slug" class="ui-select-compact w-36">
									<option value="">—</option>
									{categories.map((cat) => (
										<option value={cat.slug} selected={banner.categorySlug === cat.slug}>
											{cat.name}
										</option>
									))}
								</select>
							</td>
							<td class="ui-table-dense-td banner-field-page">
								<select name="banner_page_path" class="ui-select-compact w-44">
									<option value="">—</option>
									{publishedPages.length === 0 ? (
										<option value="" disabled>{adminLayout.noPublishedPages}</option>
									) : (
										publishedPages.map((page) => (
											<option value={page.path} selected={banner.pagePath === page.path}>
												{page.title} ({page.path})
											</option>
										))
									)}
								</select>
							</td>
							<td class="ui-table-dense-td banner-field-external">
								<input
									name="banner_external_url"
									value={banner.externalUrl ?? ''}
									class="ui-input-compact ui-input-compact--mono w-40"
									placeholder="https://"
								/>
							</td>
							<td class="ui-table-dense-td">
								<input name="banner_order" type="number" min="0" value={banner.order ?? ''} class="ui-input-compact w-16" />
							</td>
							<td class="ui-table-dense-td text-center">
								<input type="checkbox" name={`banner_enabled_${banner.id}`} checked={banner.enabled !== false} />
							</td>
							<td class="ui-table-dense-td">
								<button type="button" class="remove-banner ui-link--danger">{actions.removeBanner}</button>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<Button type="button" id="add-banner" variant="add">
		{actions.addBanner}
	</Button>

	<template id="banner-category-options">
		<option value="">—</option>
		{categories.map((cat) => (
			<option value={cat.slug}>{cat.name}</option>
		))}
	</template>

	<template id="banner-page-options">
		<option value="">—</option>
		{
			publishedPages.map((page) => (
				<option value={page.path}>{page.title} ({page.path})</option>
			))
		}
	</template>
</Panel>

<script
	define:vars={{
		addBannerLabel: actions.addBanner,
		removeBannerLabel: actions.removeBanner,
		styleImage: bannerStyles.image,
		styleText: bannerStyles.text,
		variantDefault: bannerImageVariants.default,
		variantBlue: bannerImageVariants.blue,
		linkCategory: bannerLinkTypes.category,
		linkPage: bannerLinkTypes.page,
		linkExternal: bannerLinkTypes.external,
	}}
>
	const bannersBody = document.getElementById('banners-body');
	const addBannerBtn = document.getElementById('add-banner');
	const categoryOptionsTpl = document.getElementById('banner-category-options');
	const pageOptionsTpl = document.getElementById('banner-page-options');

	function syncBannerRowVisibility(row) {
		const style = row.querySelector('.banner-style')?.value ?? 'image';
		const linkType = row.querySelector('.banner-link-type')?.value ?? 'category';
		row.querySelectorAll('.banner-field-image').forEach((el) => {
			el.classList.toggle('banner-cell-hidden', style !== 'image');
		});
		row.querySelectorAll('.banner-field-text').forEach((el) => {
			el.classList.toggle('banner-cell-hidden', style !== 'text');
		});
		row.querySelectorAll('.banner-field-category').forEach((el) => {
			el.classList.toggle('banner-cell-hidden', linkType !== 'category');
		});
		row.querySelectorAll('.banner-field-page').forEach((el) => {
			el.classList.toggle('banner-cell-hidden', linkType !== 'page');
		});
		row.querySelectorAll('.banner-field-external').forEach((el) => {
			el.classList.toggle('banner-cell-hidden', linkType !== 'external');
		});
	}

	function bindBannerRow(row) {
		row.querySelector('.banner-style')?.addEventListener('change', () => syncBannerRowVisibility(row));
		row.querySelector('.banner-link-type')?.addEventListener('change', () => syncBannerRowVisibility(row));
		row.querySelector('.remove-banner')?.addEventListener('click', () => row.remove());
		syncBannerRowVisibility(row);
	}

	bannersBody?.querySelectorAll('.banner-row').forEach(bindBannerRow);

	addBannerBtn?.addEventListener('click', () => {
		const id = `banner_${Date.now()}`;
		const tr = document.createElement('tr');
		tr.className = 'banner-row ui-table-dense-row';
		tr.dataset.bannerId = id;
		const categoryOptions = categoryOptionsTpl?.innerHTML ?? '<option value="">—</option>';
		const pageOptions = pageOptionsTpl?.innerHTML ?? '<option value="">—</option>';
		tr.innerHTML = `
			<td class="ui-table-dense-td">
				<input type="hidden" name="banner_id" value="${id}" />
				<input name="banner_label" required class="ui-input-compact w-36" />
			</td>
			<td class="ui-table-dense-td">
				<select name="banner_style" class="banner-style ui-select-compact">
					<option value="image">${styleImage}</option>
					<option value="text">${styleText}</option>
				</select>
			</td>
			<td class="ui-table-dense-td banner-field-image">
				<input name="banner_image_url" class="ui-input-compact ui-input-compact--mono w-44" />
			</td>
			<td class="ui-table-dense-td banner-field-image">
				<select name="banner_image_variant" class="ui-select-compact">
					<option value="default">${variantDefault}</option>
					<option value="blue">${variantBlue}</option>
				</select>
			</td>
			<td class="ui-table-dense-td banner-field-text">
				<input name="banner_text_title" class="ui-input-compact w-32" />
			</td>
			<td class="ui-table-dense-td banner-field-text">
				<input name="banner_text_button" class="ui-input-compact w-28" />
			</td>
			<td class="ui-table-dense-td">
				<select name="banner_link_type" class="banner-link-type ui-select-compact">
					<option value="category">${linkCategory}</option>
					<option value="page">${linkPage}</option>
					<option value="external">${linkExternal}</option>
				</select>
			</td>
			<td class="ui-table-dense-td banner-field-category">
				<select name="banner_category_slug" class="ui-select-compact w-36">${categoryOptions}</select>
			</td>
			<td class="ui-table-dense-td banner-field-page">
				<select name="banner_page_path" class="ui-select-compact w-44">${pageOptions}</select>
			</td>
			<td class="ui-table-dense-td banner-field-external">
				<input name="banner_external_url" class="ui-input-compact ui-input-compact--mono w-40" placeholder="https://" />
			</td>
			<td class="ui-table-dense-td">
				<input name="banner_order" type="number" min="0" class="ui-input-compact w-16" />
			</td>
			<td class="ui-table-dense-td text-center">
				<input type="checkbox" name="banner_enabled_${id}" checked />
			</td>
			<td class="ui-table-dense-td">
				<button type="button" class="remove-banner ui-link--danger">${removeBannerLabel}</button>
			</td>
		`;
		bannersBody?.appendChild(tr);
		bindBannerRow(tr);
	});
</script>

<style is:global>
	#banners-table td.banner-cell-hidden {
		visibility: hidden;
		pointer-events: none;
	}
</style>
