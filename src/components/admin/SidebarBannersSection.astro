---
import { adminLayout } from '@/i18n';
import type { CategoryDefinition, SidebarBanner } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	banners: SidebarBanner[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { banners, categories, publishedPages } = Astro.props;
const { fields, actions, bannerLinkTypes, bannerStyles, bannerImageVariants } = adminLayout;
---

<section class="space-y-3 rounded-xl border bg-white p-6">
	<h2 class="text-sm font-semibold text-slate-800">{adminLayout.sections.banners}</h2>
	<p class="text-xs text-slate-500">{adminLayout.bannersHint}</p>

	<div class="overflow-x-auto">
		<table class="w-full min-w-[72rem] text-left text-sm" id="banners-table">
			<thead>
				<tr class="border-b text-xs text-slate-500">
					<th class="py-2 pr-2">{fields.bannerLabel}</th>
					<th class="py-2 pr-2">{fields.bannerStyle}</th>
					<th class="py-2 pr-2">{fields.bannerImageUrl}</th>
					<th class="py-2 pr-2">{fields.bannerImageVariant}</th>
					<th class="py-2 pr-2">{fields.bannerTextTitle}</th>
					<th class="py-2 pr-2">{fields.bannerTextButton}</th>
					<th class="py-2 pr-2">{fields.bannerLinkType}</th>
					<th class="py-2 pr-2">{fields.bannerCategory}</th>
					<th class="py-2 pr-2">{fields.bannerPage}</th>
					<th class="py-2 pr-2">{fields.bannerExternalUrl}</th>
					<th class="py-2 pr-2">{fields.widgetOrder}</th>
					<th class="py-2 pr-2">{fields.widgetEnabled}</th>
					<th class="py-2">{actions.removeBanner}</th>
				</tr>
			</thead>
			<tbody id="banners-body">
				{
					banners.map((banner) => (
						<tr class="banner-row border-b border-slate-50" data-banner-id={banner.id}>
							<td class="py-2 pr-2">
								<input type="hidden" name="banner_id" value={banner.id} />
								<input name="banner_label" value={banner.label} required class="w-36 rounded border px-2 py-1 text-xs" />
							</td>
							<td class="py-2 pr-2">
								<select name="banner_style" class="banner-style rounded border px-2 py-1 text-xs">
									<option value="image" selected={banner.style !== 'text'}>{bannerStyles.image}</option>
									<option value="text" selected={banner.style === 'text'}>{bannerStyles.text}</option>
								</select>
							</td>
							<td class="py-2 pr-2 banner-field-image">
								<input name="banner_image_url" value={banner.imageUrl ?? ''} class="w-44 rounded border px-2 py-1 font-mono text-xs" />
							</td>
							<td class="py-2 pr-2 banner-field-image">
								<select name="banner_image_variant" class="rounded border px-2 py-1 text-xs">
									<option value="default" selected={banner.imageVariant !== 'blue'}>{bannerImageVariants.default}</option>
									<option value="blue" selected={banner.imageVariant === 'blue'}>{bannerImageVariants.blue}</option>
								</select>
							</td>
							<td class="py-2 pr-2 banner-field-text">
								<input name="banner_text_title" value={banner.textTitle ?? ''} class="w-32 rounded border px-2 py-1 text-xs" />
							</td>
							<td class="py-2 pr-2 banner-field-text">
								<input name="banner_text_button" value={banner.textButton ?? ''} class="w-28 rounded border px-2 py-1 text-xs" />
							</td>
							<td class="py-2 pr-2">
								<select name="banner_link_type" class="banner-link-type rounded border px-2 py-1 text-xs">
									<option value="category" selected={banner.linkType === 'category'}>{bannerLinkTypes.category}</option>
									<option value="page" selected={banner.linkType === 'page'}>{bannerLinkTypes.page}</option>
									<option value="external" selected={banner.linkType === 'external'}>{bannerLinkTypes.external}</option>
								</select>
							</td>
							<td class="py-2 pr-2 banner-field-category">
								<select name="banner_category_slug" class="w-36 rounded border px-2 py-1 text-xs">
									<option value="">—</option>
									{categories.map((cat) => (
										<option value={cat.slug} selected={banner.categorySlug === cat.slug}>
											{cat.name}
										</option>
									))}
								</select>
							</td>
							<td class="py-2 pr-2 banner-field-page">
								<select name="banner_page_path" class="w-44 rounded border px-2 py-1 text-xs">
									<option value="">—</option>
									{publishedPages.length === 0 ? (
										<option value="" disabled>{adminLayout.noPublishedPages}</option>
									) : (
										publishedPages.map((page) => (
											<option value={page.path} selected={banner.pagePath === page.path}>
												{page.title} ({page.path})
											</option>
										))
									)}
								</select>
							</td>
							<td class="py-2 pr-2 banner-field-external">
								<input
									name="banner_external_url"
									value={banner.externalUrl ?? ''}
									class="w-40 rounded border px-2 py-1 font-mono text-xs"
									placeholder="https://"
								/>
							</td>
							<td class="py-2 pr-2">
								<input name="banner_order" type="number" min="0" value={banner.order ?? ''} class="w-16 rounded border px-2 py-1 text-xs" />
							</td>
							<td class="py-2 pr-2 text-center">
								<input type="checkbox" name={`banner_enabled_${banner.id}`} checked={banner.enabled !== false} />
							</td>
							<td class="py-2">
								<button type="button" class="remove-banner text-xs text-red-700 hover:underline">{actions.removeBanner}</button>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<button type="button" id="add-banner" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs text-slate-700 hover:border-brand">
		{actions.addBanner}
	</button>

	<template id="banner-category-options">
		<option value="">—</option>
		{categories.map((cat) => (
			<option value={cat.slug}>{cat.name}</option>
		))}
	</template>

	<template id="banner-page-options">
		<option value="">—</option>
		{
			publishedPages.map((page) => (
				<option value={page.path}>{page.title} ({page.path})</option>
			))
		}
	</template>
</section>

<script
	define:vars={{
		addBannerLabel: actions.addBanner,
		removeBannerLabel: actions.removeBanner,
		styleImage: bannerStyles.image,
		styleText: bannerStyles.text,
		variantDefault: bannerImageVariants.default,
		variantBlue: bannerImageVariants.blue,
		linkCategory: bannerLinkTypes.category,
		linkPage: bannerLinkTypes.page,
		linkExternal: bannerLinkTypes.external,
	}}
>
	const bannersBody = document.getElementById('banners-body');
	const addBannerBtn = document.getElementById('add-banner');
	const categoryOptionsTpl = document.getElementById('banner-category-options');
	const pageOptionsTpl = document.getElementById('banner-page-options');

	function syncBannerRowVisibility(row) {
		const style = row.querySelector('.banner-style')?.value ?? 'image';
		const linkType = row.querySelector('.banner-link-type')?.value ?? 'category';
		row.querySelectorAll('.banner-field-image').forEach((el) => {
			el.classList.toggle('hidden', style !== 'image');
		});
		row.querySelectorAll('.banner-field-text').forEach((el) => {
			el.classList.toggle('hidden', style !== 'text');
		});
		row.querySelectorAll('.banner-field-category').forEach((el) => {
			el.classList.toggle('hidden', linkType !== 'category');
		});
		row.querySelectorAll('.banner-field-page').forEach((el) => {
			el.classList.toggle('hidden', linkType !== 'page');
		});
		row.querySelectorAll('.banner-field-external').forEach((el) => {
			el.classList.toggle('hidden', linkType !== 'external');
		});
	}

	function bindBannerRow(row) {
		row.querySelector('.banner-style')?.addEventListener('change', () => syncBannerRowVisibility(row));
		row.querySelector('.banner-link-type')?.addEventListener('change', () => syncBannerRowVisibility(row));
		row.querySelector('.remove-banner')?.addEventListener('click', () => row.remove());
		syncBannerRowVisibility(row);
	}

	bannersBody?.querySelectorAll('.banner-row').forEach(bindBannerRow);

	addBannerBtn?.addEventListener('click', () => {
		const id = `banner_${Date.now()}`;
		const tr = document.createElement('tr');
		tr.className = 'banner-row border-b border-slate-50';
		tr.dataset.bannerId = id;
		const categoryOptions = categoryOptionsTpl?.innerHTML ?? '<option value="">—</option>';
		const pageOptions = pageOptionsTpl?.innerHTML ?? '<option value="">—</option>';
		tr.innerHTML = `
			<td class="py-2 pr-2">
				<input type="hidden" name="banner_id" value="${id}" />
				<input name="banner_label" required class="w-36 rounded border px-2 py-1 text-xs" />
			</td>
			<td class="py-2 pr-2">
				<select name="banner_style" class="banner-style rounded border px-2 py-1 text-xs">
					<option value="image">${styleImage}</option>
					<option value="text">${styleText}</option>
				</select>
			</td>
			<td class="py-2 pr-2 banner-field-image">
				<input name="banner_image_url" class="w-44 rounded border px-2 py-1 font-mono text-xs" />
			</td>
			<td class="py-2 pr-2 banner-field-image">
				<select name="banner_image_variant" class="rounded border px-2 py-1 text-xs">
					<option value="default">${variantDefault}</option>
					<option value="blue">${variantBlue}</option>
				</select>
			</td>
			<td class="py-2 pr-2 banner-field-text">
				<input name="banner_text_title" class="w-32 rounded border px-2 py-1 text-xs" />
			</td>
			<td class="py-2 pr-2 banner-field-text">
				<input name="banner_text_button" class="w-28 rounded border px-2 py-1 text-xs" />
			</td>
			<td class="py-2 pr-2">
				<select name="banner_link_type" class="banner-link-type rounded border px-2 py-1 text-xs">
					<option value="category">${linkCategory}</option>
					<option value="page">${linkPage}</option>
					<option value="external">${linkExternal}</option>
				</select>
			</td>
			<td class="py-2 pr-2 banner-field-category">
				<select name="banner_category_slug" class="w-36 rounded border px-2 py-1 text-xs">${categoryOptions}</select>
			</td>
			<td class="py-2 pr-2 banner-field-page">
				<select name="banner_page_path" class="w-44 rounded border px-2 py-1 text-xs">${pageOptions}</select>
			</td>
			<td class="py-2 pr-2 banner-field-external">
				<input name="banner_external_url" class="w-40 rounded border px-2 py-1 font-mono text-xs" placeholder="https://" />
			</td>
			<td class="py-2 pr-2">
				<input name="banner_order" type="number" min="0" class="w-16 rounded border px-2 py-1 text-xs" />
			</td>
			<td class="py-2 pr-2 text-center">
				<input type="checkbox" name="banner_enabled_${id}" checked />
			</td>
			<td class="py-2">
				<button type="button" class="remove-banner text-xs text-red-700 hover:underline">${removeBannerLabel}</button>
			</td>
		`;
		bannersBody?.appendChild(tr);
		bindBannerRow(tr);
	});
</script>

<style>
	.hidden {
		display: none;
	}
</style>
