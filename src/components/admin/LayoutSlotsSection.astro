---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import LayoutSlotTableRow from '@/components/admin/LayoutSlotTableRow.astro';
import { CERT_CATEGORIES } from '@/lib/cert';
import { LAYOUT_COMPONENT_IDS } from '@/lib/astro-layout/components';
import type { CategoryDefinition, DisplaySlot } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	slots: DisplaySlot[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { slots, categories, publishedPages } = Astro.props;
const { fields, actions } = adminLayout;
const weatherSlots = slots.filter((slot) => slot.component === 'sidebar.weather');

const componentOptionsHtml = LAYOUT_COMPONENT_IDS.map(
	(id) => `<option value="${id}">${adminLayout.componentLabels[id]}</option>`,
).join('');
---

<Panel class="ui-form-section">
	<h2 class="ui-section-title">{adminLayout.sections.slots}</h2>
	<p class="ui-hint">{adminLayout.slotsHint}</p>
	<p class="ui-hint">{adminLayout.slotsOrderHint}</p>

	<div class="overflow-x-auto">
		<table class="ui-table-dense min-w-[80rem]" id="slots-table">
			<thead>
				<tr class="ui-table-dense-head">
					<th class="ui-table-dense-th">{fields.slotId}</th>
					<th class="ui-table-dense-th">{fields.slotLabel}</th>
					<th class="ui-table-dense-th">{fields.slotComponent}</th>
					<th class="ui-table-dense-th">{fields.widgetOrder}</th>
					<th class="ui-table-dense-th">{fields.widgetEnabled}</th>
					<th class="ui-table-dense-th">{fields.widgetTitle}</th>
					<th class="ui-table-dense-th">{fields.widgetSectionTitle}</th>
					<th class="ui-table-dense-th">{fields.widgetLimit}</th>
					<th class="ui-table-dense-th">{fields.widgetEmptyText}</th>
					<th class="ui-table-dense-th">{fields.widgetMoreLink}</th>
					<th class="ui-table-dense-th">{fields.widgetVariant}</th>
					<th class="ui-table-dense-th">{fields.certAdvisoriesCategory}</th>
					<th class="ui-table-dense-th">{fields.bannerStyle}</th>
					<th class="ui-table-dense-th">{fields.bannerImageUrl}</th>
					<th class="ui-table-dense-th">{fields.bannerImageVariant}</th>
					<th class="ui-table-dense-th">{fields.bannerTextTitle}</th>
					<th class="ui-table-dense-th">{fields.bannerTextButton}</th>
					<th class="ui-table-dense-th">{fields.bannerLinkType}</th>
					<th class="ui-table-dense-th">{fields.bannerCategory}</th>
					<th class="ui-table-dense-th">{fields.bannerPage}</th>
					<th class="ui-table-dense-th">{fields.bannerExternalUrl}</th>
					<th class="ui-table-dense-th">{actions.removeSlot}</th>
				</tr>
			</thead>
			<tbody id="slots-body">
				{slots.map((slot) => (
					<LayoutSlotTableRow slot={slot} categories={categories} publishedPages={publishedPages} />
				))}
			</tbody>
		</table>
	</div>

	<div class="mt-3 flex flex-wrap items-center gap-2">
		<select id="add-slot-component" class="ui-select-compact">
			{
				LAYOUT_COMPONENT_IDS.map((id) => (
					<option value={id}>{adminLayout.componentLabels[id]}</option>
				))
			}
		</select>
		<Button type="button" id="add-slot" variant="add">
			{actions.addComponent}
		</Button>
	</div>

	{
		weatherSlots.length > 0 && (
			<div class="ui-divider-section">
				<h3 class="ui-subheading">{fields.weatherHeading}</h3>
				<p class="ui-hint">{adminLayout.weatherHint}</p>
				{
					weatherSlots.map((slot) => (
						<div class="ui-fieldset-nested">
							<input type="hidden" name="slot_weather_id" value={slot.id} />
							<p class="ui-label-text text-xs font-medium sm:col-span-2">
								{slot.label} · <code class="ui-code">{slot.id}</code>
							</p>
							<label class="ui-label">
								<span class="font-medium">{fields.weatherTerytPowiat}</span>
								<input
									name="slot_weather_teryt_powiat"
									value={slot.widget?.terytPowiat ?? ''}
									pattern="[0-9]{4}"
									class="ui-input font-mono"
								/>
							</label>
							<label class="ui-label">
								<span class="font-medium">{fields.weatherMapZoom}</span>
								<input
									name="slot_weather_map_zoom"
									type="number"
									min="1"
									max="18"
									value={slot.widget?.mapZoom ?? 11}
									class="ui-input"
								/>
							</label>
							<label class="ui-label">
								<span class="font-medium">{fields.weatherLat}</span>
								<input
									name="slot_weather_lat"
									type="number"
									step="any"
									value={slot.widget?.mapCenter?.lat ?? ''}
									class="ui-input"
								/>
							</label>
							<label class="ui-label">
								<span class="font-medium">{fields.weatherLon}</span>
								<input
									name="slot_weather_lon"
									type="number"
									step="any"
									value={slot.widget?.mapCenter?.lon ?? ''}
									class="ui-input"
								/>
							</label>
							<label class="ui-label sm:col-span-2">
								<span class="font-medium">{fields.weatherMapScope}</span>
								<input
									name="slot_weather_map_scope"
									value={slot.widget?.mapScopePowiaty?.join(', ') ?? ''}
									class="ui-input font-mono"
								/>
							</label>
							<label class="ui-label-inline flex items-center gap-2 sm:col-span-2">
								<input
									type="checkbox"
									name={`slot_weather_show_map_${slot.id}`}
									checked={slot.widget?.showMap !== false}
								/>
								{fields.weatherShowMap}
							</label>
						</div>
					))
				}
			</div>
		)
	}
</Panel>

<template id="slot-cert-category-options">
	<option value="">{adminLayout.certCategories.all}</option>
	{CERT_CATEGORIES.map((category) => (
		<option value={category}>{category}</option>
	))}
</template>

<template id="slot-banner-category-options">
	<option value="">—</option>
	{categories.map((cat) => (
		<option value={cat.slug}>{cat.name}</option>
	))}
</template>

<template id="slot-banner-page-options">
	<option value="">—</option>
	{
		publishedPages.map((page) => (
			<option value={page.path}>{page.title} ({page.path})</option>
		))
	}
</template>

<script
	define:vars={{
		removeSlotLabel: actions.removeSlot,
		variantDefault: adminLayout.variants.default,
		variantAlert: adminLayout.variants.alert,
		styleImage: adminLayout.bannerStyles.image,
		styleText: adminLayout.bannerStyles.text,
		variantBannerDefault: adminLayout.bannerImageVariants.default,
		variantBannerBlue: adminLayout.bannerImageVariants.blue,
		linkCategory: adminLayout.bannerLinkTypes.category,
		linkPage: adminLayout.bannerLinkTypes.page,
		linkExternal: adminLayout.bannerLinkTypes.external,
		componentOptionsHtml,
		singletonComponents: ['sidebar.weather', 'sidebar.recent_changes', 'sidebar.cert_advisories'],
		certAllLabel: adminLayout.certCategories.all,
	}}
>
	const slotsBody = document.getElementById('slots-body');
	const addSlotBtn = document.getElementById('add-slot');
	const addComponentSelect = document.getElementById('add-slot-component');
	const categoryOptionsTpl = document.getElementById('slot-banner-category-options');
	const pageOptionsTpl = document.getElementById('slot-banner-page-options');
	const certOptionsTpl = document.getElementById('slot-cert-category-options');
	const layoutForm = slotsBody?.closest('form');

	const FEED = ['home.pinned', 'home.latest', 'sidebar.recent_changes', 'sidebar.cert_advisories'];
	const BANNER = 'sidebar.banner';
	const CERT = 'sidebar.cert_advisories';

	function nextSlotOrder() {
		let max = 0;
		slotsBody?.querySelectorAll('input[name="slot_widget_order"]').forEach((input) => {
			const n = Number(input.value);
			if (Number.isFinite(n) && n > max) max = n;
		});
		return max > 0 ? max + 10 : 10;
	}

	function usedSingletons() {
		const used = new Set();
		slotsBody?.querySelectorAll('.slot-component').forEach((sel) => {
			if (singletonComponents.includes(sel.value)) used.add(sel.value);
		});
		return used;
	}

	function syncSlotRowVisibility(row) {
		const component = row.querySelector('.slot-component')?.value ?? '';
		const isFeed = FEED.includes(component);
		const isBanner = component === BANNER;
		const isCert = component === CERT;
		row.querySelectorAll('.slot-field-feed').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', !isFeed);
		});
		row.querySelectorAll('.slot-field-cert').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', !isCert);
		});
		row.querySelectorAll('.slot-field-banner').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', !isBanner);
		});
		if (isBanner) syncBannerSubfields(row);
	}

	function syncBannerSubfields(row) {
		const style = row.querySelector('.slot-banner-style')?.value ?? 'image';
		const linkType = row.querySelector('.slot-banner-link-type')?.value ?? 'category';
		row.querySelectorAll('.slot-banner-field-image').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', style !== 'image');
		});
		row.querySelectorAll('.slot-banner-field-text').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', style !== 'text');
		});
		row.querySelectorAll('.slot-banner-field-category').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', linkType !== 'category');
		});
		row.querySelectorAll('.slot-banner-field-page').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', linkType !== 'page');
		});
		row.querySelectorAll('.slot-banner-field-external').forEach((el) => {
			el.classList.toggle('slot-cell-hidden', linkType !== 'external');
		});
	}

	function bindSlotRow(row) {
		row.querySelector('.slot-component')?.addEventListener('change', () => syncSlotRowVisibility(row));
		row.querySelector('.slot-banner-style')?.addEventListener('change', () => syncBannerSubfields(row));
		row.querySelector('.slot-banner-link-type')?.addEventListener('change', () => syncBannerSubfields(row));
		row.querySelector('.remove-slot')?.addEventListener('click', () => {
			if (slotsBody.querySelectorAll('.slot-row').length <= 1) return;
			row.remove();
		});
		syncSlotRowVisibility(row);
	}

	slotsBody?.querySelectorAll('.slot-row').forEach(bindSlotRow);

	layoutForm?.addEventListener('submit', () => {
		slotsBody?.querySelectorAll('.slot-row').forEach((row) => {
			const label = row.querySelector('input[name="slot_label"]')?.value?.trim();
			const id = row.querySelector('input[name="slot_id"]')?.value?.trim();
			if (!label || !id) row.remove();
		});
	});

	addSlotBtn?.addEventListener('click', () => {
		const component = addComponentSelect?.value ?? 'home.pinned';
		if (singletonComponents.includes(component) && usedSingletons().has(component)) return;

		const id = `slot_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
		const order = nextSlotOrder();
		const categoryOptions = categoryOptionsTpl?.innerHTML ?? '<option value="">—</option>';
		const pageOptions = pageOptionsTpl?.innerHTML ?? '<option value="">—</option>';
		const certOptions = certOptionsTpl?.innerHTML ?? `<option value="">${certAllLabel}</option>`;
		const tr = document.createElement('tr');
		tr.className = 'slot-row ui-table-dense-row';
		tr.dataset.slotId = id;
		tr.innerHTML = `
			<td class="ui-table-dense-td"><input name="slot_id" value="${id}" required class="ui-input-compact ui-input-compact--mono w-24" /></td>
			<td class="ui-table-dense-td"><input name="slot_label" required class="ui-input-compact w-32" /></td>
			<td class="ui-table-dense-td"><select name="slot_component" class="slot-component ui-select-compact w-40">${componentOptionsHtml}</select></td>
			<td class="ui-table-dense-td"><input name="slot_widget_order" type="number" min="0" value="${order}" class="ui-input-compact w-16" /></td>
			<td class="ui-table-dense-td text-center"><input type="checkbox" name="slot_enabled_${id}" checked /></td>
			<td class="ui-table-dense-td slot-field-feed"><input name="slot_widget_title" class="ui-input-compact w-32" /></td>
			<td class="ui-table-dense-td slot-field-feed"><input name="slot_widget_section_title" class="ui-input-compact w-32" /></td>
			<td class="ui-table-dense-td slot-field-feed"><input name="slot_widget_limit" type="number" min="1" class="ui-input-compact w-16" /></td>
			<td class="ui-table-dense-td slot-field-feed"><input name="slot_widget_empty_text" class="ui-input-compact w-32" /></td>
			<td class="ui-table-dense-td slot-field-feed"><input name="slot_widget_more_link" class="ui-input-compact ui-input-compact--mono w-28" /></td>
			<td class="ui-table-dense-td slot-field-feed"><select name="slot_widget_variant" class="ui-select-compact"><option value="default">${variantDefault}</option><option value="alert">${variantAlert}</option></select></td>
			<td class="ui-table-dense-td slot-field-cert"><select name="slot_cert_category_filter" class="ui-select-compact w-36">${certOptions}</select></td>
			<td class="ui-table-dense-td slot-field-banner"><select name="slot_banner_style" class="slot-banner-style ui-select-compact"><option value="image">${styleImage}</option><option value="text">${styleText}</option></select></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-image"><input name="slot_banner_image_url" class="ui-input-compact ui-input-compact--mono w-36" /></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-image"><select name="slot_banner_image_variant" class="ui-select-compact"><option value="default">${variantBannerDefault}</option><option value="blue">${variantBannerBlue}</option></select></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-text"><input name="slot_banner_text_title" class="ui-input-compact w-28" /></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-text"><input name="slot_banner_text_button" class="ui-input-compact w-24" /></td>
			<td class="ui-table-dense-td slot-field-banner"><select name="slot_banner_link_type" class="slot-banner-link-type ui-select-compact"><option value="category">${linkCategory}</option><option value="page">${linkPage}</option><option value="external">${linkExternal}</option></select></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-category"><select name="slot_banner_category_slug" class="ui-select-compact w-32">${categoryOptions}</select></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-page"><select name="slot_banner_page_path" class="ui-select-compact w-36">${pageOptions}</select></td>
			<td class="ui-table-dense-td slot-field-banner slot-banner-field-external"><input name="slot_banner_external_url" class="ui-input-compact ui-input-compact--mono w-36" placeholder="https://" /></td>
			<td class="ui-table-dense-td"><button type="button" class="remove-slot ui-link--danger">${removeSlotLabel}</button></td>
		`;
		const compSelect = tr.querySelector('.slot-component');
		if (compSelect) compSelect.value = component;
		slotsBody?.appendChild(tr);
		bindSlotRow(tr);
	});
</script>

<style is:global>
	#slots-table td.slot-cell-hidden {
		visibility: hidden;
		pointer-events: none;
	}
</style>
