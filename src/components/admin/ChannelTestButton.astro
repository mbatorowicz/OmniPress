---
import { adminDestinations } from '@/i18n';

interface Props {
	destinationId?: string;
}

const { destinationId } = Astro.props;
---

<div
	class="channel-test mt-2"
	data-channel-test="github_astro"
	data-test-api="/api/admin/channels/test-github-astro"
	data-dest-field="astro_destination_id"
	data-destination-id={destinationId ?? ''}
>
	<button type="button" data-test-btn class="ui-btn ui-btn--secondary px-3 py-1.5">
		{adminDestinations.actions.testChannel}
	</button>
	<p class="mt-2 hidden text-sm" data-test-result role="status"></p>
</div>

<script>
	function bindChannelTests() {
		document.querySelectorAll('[data-channel-test]').forEach((root) => {
			const el = root as HTMLElement;
			const btn = el.querySelector('[data-test-btn]') as HTMLButtonElement | null;
			const result = el.querySelector('[data-test-result]') as HTMLParagraphElement | null;
			const api = el.dataset.testApi;
			const destField = el.dataset.destField ?? '';
			const fallbackDestId = el.dataset.destinationId ?? '';
			if (!btn || !result || !api) return;

			const labelTest = btn.textContent?.trim() ?? 'Testuj połączenie';
			const labelTesting = 'Testowanie…';

			btn.addEventListener('click', async () => {
				const form = el.closest('form');
				if (!form) return;

				btn.disabled = true;
				btn.textContent = labelTesting;
				result.classList.add('hidden');
				result.classList.remove('ui-alert', 'ui-alert--success', 'ui-alert--error');

				const fd = new FormData(form);
				if (destField && !fd.get(destField) && fallbackDestId) {
					fd.set(destField, fallbackDestId);
				}

				try {
					const res = await fetch(api, { method: 'POST', body: fd });
					const data = (await res.json()) as { ok?: boolean; message?: string };
					const ok = Boolean(data.ok);
					result.textContent = data.message ?? (ok ? 'OK' : 'Błąd testu');
					result.classList.add('ui-alert', ok ? 'ui-alert--success' : 'ui-alert--error');
					result.classList.remove('hidden');
				} catch {
					result.textContent = 'Błąd sieci — spróbuj ponownie.';
					result.classList.add('ui-alert', 'ui-alert--error');
					result.classList.remove('hidden');
				} finally {
					btn.disabled = false;
					btn.textContent = labelTest;
				}
			});
		});
	}

	bindChannelTests();
	document.addEventListener('astro:page-load', bindChannelTests);
</script>
