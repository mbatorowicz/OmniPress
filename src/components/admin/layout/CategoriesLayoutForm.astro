---
import { adminLayout } from '@/i18n';
import Alert from '@/components/ui/feedback/Alert.astro';
import LayoutSyncActions from '@/components/admin/layout/LayoutSyncActions.astro';
import CategoryMatrixSection from '@/components/admin/layout/CategoryMatrixSection.astro';
import type { SiteAstroLayout } from '@/lib/astro-layout/types';

interface Props {
	siteId: string;
	layout: SiteAstroLayout;
	hasAstroChannel: boolean;
	returnTab?: import('@/lib/admin/layout-editor-tabs').LayoutEditorTab;
}

const { siteId, layout, hasAstroChannel, returnTab = 'categories' } = Astro.props;
---

<form
	method="post"
	action={`/api/admin/sites/${siteId}/layout/save`}
	class="ui-form-stack max-w-5xl"
	data-categories-form
>
	<input type="hidden" name="section" value="categories" />
	<input type="hidden" name="return_tab" value={returnTab} />
	<h2 class="ui-section-title">{adminLayout.categoriesTitle}</h2>
	<Alert variant="info" class="ui-alert--note">{adminLayout.categoriesSlugWarning}</Alert>
	<Alert variant="info" class="ui-alert--note">{adminLayout.categoriesFeedAssignHint}</Alert>
	<CategoryMatrixSection {layout} />
	<LayoutSyncActions section="categories" />
</form>
