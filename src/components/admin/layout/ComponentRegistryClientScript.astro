---
import { buildLayoutSlotsClientScriptVars } from '@/lib/admin/layout-slots-client-vars';
import { adminLayout } from '@/i18n';
import { layoutZoneTitles } from '@/lib/admin/layout-editor-i18n';
import { buildZoneComponentOptionsHtml } from '@/lib/admin/layout-slots-sections';
import { UNIT_COMPONENTS_FORM_ID } from '@/lib/admin/layout-form-ids';

const componentOptionsHtml = buildZoneComponentOptionsHtml('home', adminLayout.componentLabels);
const scriptVars = buildLayoutSlotsClientScriptVars(componentOptionsHtml);
const zoneTitles = layoutZoneTitles();
---

<script define:vars={{
	...scriptVars,
	componentsFormId: UNIT_COMPONENTS_FORM_ID,
	zoneLabels: {
		home: zoneTitles.home,
		sidebar: zoneTitles.sidebar,
		footer: zoneTitles.footer,
	},
	zoneBadgePrefix: adminLayout.slotZoneBadge,
	templateLabels: {
		category: adminLayout.addTemplateCategory,
		external_link: adminLayout.addTemplateExternalLink,
		static_page: adminLayout.addTemplateStaticPage,
		banner: adminLayout.addTemplateBanner,
	},
}}>
	import { initComponentRegistryEditor, initLayoutSlotCardSummaries } from '@/lib/admin/layout-slots-client';
	import { initLayoutSlotDialogs } from '@/lib/admin/layout-slot-dialog-client';

	initLayoutSlotDialogs();

	initComponentRegistryEditor({
		formId: componentsFormId,
		removeSlotLabel,
		variantDefault,
		variantAlert,
		styleImage,
		styleText,
		variantBannerDefault,
		variantBannerBlue,
		linkCategory,
		linkPage,
		linkExternal,
		componentOptionsHtml,
		componentLabels,
		slotPanelSectionTitleLabel,
		homeFeedCategoriesLabel,
		homeFeedCategoriesHint,
		homeFeedPinnedHint,
		homeFeedTileHeightHint,
		singletonComponents,
		certAllLabel,
		weatherDetailsDisplayModal,
		weatherDetailsDisplayInline,
		weatherDetailsLayoutStacked,
		weatherDetailsLayoutGrid,
		settingsLabel,
		closeLabel,
		fieldLabels,
		homeFeedCategoryCheckboxesHtml: '',
		disabledLabel,
		zoneLabels,
		zoneBadgePrefix,
		templateLabels,
	});

	initLayoutSlotCardSummaries();
</script>
