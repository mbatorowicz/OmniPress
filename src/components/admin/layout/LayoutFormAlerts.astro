---
import { adminLayout } from '@/i18n';
import Alert from '@/components/ui/feedback/Alert.astro';

interface Props {
	errorMessage?: string | null;
	errorDetail?: string | null;
	syncSummary?: string | null;
	navWarningLines?: string[];
	navHasMissingHref?: boolean;
	saved?: boolean;
	published?: boolean;
	imported?: boolean;
	importHrefCount?: number | null;
	importPath?: string | null;
	hasAstroChannel?: boolean;
}

const {
	errorMessage,
	errorDetail,
	syncSummary,
	navWarningLines = [],
	navHasMissingHref = false,
	saved,
	published,
	imported,
	importHrefCount,
	importPath,
	hasAstroChannel = true,
} = Astro.props;

const importMessage =
	imported && importHrefCount !== null && importPath
		? adminLayout.importedMenu(importHrefCount, importPath)
		: imported
			? adminLayout.imported
			: null;
---

{saved && !published && (
	<Alert variant="success">{adminLayout.savedDraft}</Alert>
)}
{published && (
	<Alert variant="success">
		{adminLayout.publishedLayout}
		{syncSummary && (
			<p class="mt-1 text-sm font-normal opacity-90">
				{adminLayout.syncSummaryPrefix} {syncSummary}
			</p>
		)}
	</Alert>
)}
{importMessage && <Alert variant="success">{importMessage}</Alert>}
{errorMessage && (
	<Alert variant="error">
		{errorMessage}
		{errorDetail && <p class="mt-1 text-sm font-normal opacity-90">{errorDetail}</p>}
	</Alert>
)}
{
	navWarningLines.length > 0 && (
		<Alert variant={navHasMissingHref ? 'error' : 'warning'}>
			<p class="font-medium">{adminLayout.navValidationHeading}</p>
			<p class="mt-1 text-sm">
				{navHasMissingHref
					? adminLayout.publishBlockedMissingHref
					: adminLayout.navValidationHint}
			</p>
			<ul class="mt-2 list-inside list-disc text-sm">
				{navWarningLines.slice(0, 12).map((line) => (
					<li>{line}</li>
				))}
			</ul>
		</Alert>
	)
}
{!hasAstroChannel && <Alert variant="warning">{adminLayout.noAstroChannel}</Alert>}
