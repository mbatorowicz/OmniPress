---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import type { DraftLiveStatus } from '@/lib/astro-layout/layout-sync-meta';
import type { LayoutContract } from '@/lib/astro-layout/types';
import type { LayoutEditorSection } from '@/lib/admin/layout-editor-context';
import {
	buildLayoutSyncBarView,
} from '@/lib/admin/layout-sync-bar-view';
import { layoutSyncBarMessagesFromI18n } from '@/lib/admin/layout-sync-bar-i18n';

interface Props {
	siteId: string;
	hasAstroChannel: boolean;
	currentSection: LayoutEditorSection;
	combinedDraftStatus: DraftLiveStatus;
	navHasMissingHref?: boolean;
	lastDraftSavedAt?: string;
	layoutContract?: LayoutContract;
}

const {
	siteId,
	hasAstroChannel,
	currentSection,
	combinedDraftStatus,
	navHasMissingHref = false,
	lastDraftSavedAt,
	layoutContract,
} = Astro.props;

const messages = layoutSyncBarMessagesFromI18n(adminLayout);
const view = buildLayoutSyncBarView(
	{
		hasAstroChannel,
		status: combinedDraftStatus,
		layoutContract,
		currentSection,
		navHasMissingHref,
		lastDraftSavedAt,
	},
	messages,
);

const publishAction = `/api/admin/sites/${siteId}/layout/publish-all`;
const pullAction = `/api/admin/sites/${siteId}/layout/import`;
const panelClass = `layout-parity-bar layout-parity-bar--${view.tone} mb-4 max-w-5xl`;
---

{
	view.show && (
		<Panel class={panelClass}>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
				<div>
					<p class="text-xs font-semibold uppercase tracking-wide opacity-70">
						{messages.parityTitle}
					</p>
					<p class="mt-1 font-medium">{view.title}</p>
					{view.detail && <p class="ui-muted mt-1 text-sm">{view.detail}</p>}
					{view.meta && <p class="ui-muted mt-1 text-sm">{view.meta}</p>}
					{view.hint && <p class="ui-hint mt-2 text-sm">{view.hint}</p>}
				</div>
				{view.action && (
					<div class="flex flex-wrap gap-2">
						<form method="post" action={view.action === 'pull' ? pullAction : publishAction}>
							<input type="hidden" name="return_section" value={currentSection} />
							<Button
								type="submit"
								variant={view.action === 'pull' ? 'secondary' : 'primary'}
								disabled={view.actionDisabled}
							>
								{view.actionLabel}
							</Button>
						</form>
					</div>
				)}
			</div>
		</Panel>
	)
}

<style>
	.layout-parity-bar--sync {
		border-left: 4px solid var(--color-success, #16a34a);
		background: color-mix(in srgb, var(--color-success, #16a34a) 6%, transparent);
	}

	.layout-parity-bar--draft {
		border-left: 4px solid var(--color-warning, #d97706);
		background: color-mix(in srgb, var(--color-warning, #d97706) 6%, transparent);
	}

	.layout-parity-bar--alert {
		border-left: 4px solid var(--color-danger, #dc2626);
		background: color-mix(in srgb, var(--color-danger, #dc2626) 6%, transparent);
	}
</style>
