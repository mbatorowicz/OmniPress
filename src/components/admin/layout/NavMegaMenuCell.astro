---
import { adminLayout } from '@/i18n';

interface Props {
	depth: 0 | 1 | 2;
	checked?: boolean;
	asCell?: boolean;
}

const { depth, checked = false, asCell = true } = Astro.props;
const visible = depth === 0;
const cellClass = `nav-mega-cell ui-table-dense-td--wide text-center ${visible ? '' : 'hidden'}`;
---

{
	asCell ? (
		<td class={cellClass}>
			<label class="inline-flex flex-col items-center gap-1">
				<input
					type="checkbox"
					name={visible ? 'nav_is_mega' : undefined}
					checked={checked}
					disabled={!visible}
					class="nav-mega ui-checkbox"
				/>
				<span class="ui-hint max-w-[6rem] text-[10px] leading-tight">{adminLayout.megaMenuHint}</span>
			</label>
		</td>
	) : (
		<div class={cellClass}>
			<label class="inline-flex flex-col items-center gap-1">
				<input
					type="checkbox"
					name={visible ? 'nav_is_mega' : undefined}
					checked={checked}
					disabled={!visible}
					class="nav-mega ui-checkbox"
				/>
				<span class="ui-hint max-w-[6rem] text-[10px] leading-tight">{adminLayout.megaMenuHint}</span>
			</label>
		</div>
	)
}
