---
import { adminLayout, ui } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import SectionTitle from '@/components/ui/layout/SectionTitle.astro';
import NavDepthSelect from '@/components/admin/layout/NavDepthSelect.astro';
import NavMegaMenuCell from '@/components/admin/layout/NavMegaMenuCell.astro';
import NavLinkTypeSelect from '@/components/admin/layout/NavLinkTypeSelect.astro';
import NavTargetCell from '@/components/admin/layout/NavTargetCell.astro';
import NavParentSelect from '@/components/admin/layout/NavParentSelect.astro';
import { flattenNavigation, collectNavInternalPageOptions } from '@/lib/admin/navigation-tree';
import { buildCategoryLinkOptions, mergePageOptionsForNavEditor, type PageOption } from '@/lib/admin/link-options';
import { buildNavTargetOptions, formatNavTargetSummary } from '@/lib/admin/nav-target-options';
import {
	navEditorDepthColorsToStyle,
	resolveNavEditorDepthColors,
	type NavEditorDepthColors,
} from '@/lib/admin/nav-editor-colors';
import type { CategoryDefinition, NavItem } from '@/lib/astro-layout/types';

interface Props {
	navigation: NavItem[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
	navEditorDepthColors?: NavEditorDepthColors;
}

const { navigation, categories, publishedPages, navEditorDepthColors } = Astro.props;
const pageOptions = mergePageOptionsForNavEditor(
	publishedPages,
	collectNavInternalPageOptions(navigation),
);
const rows =
	navigation.length > 0
		? flattenNavigation(navigation, categories, pageOptions)
		: [{ label: '', depth: 0, parentRowIndex: null, hrefKind: 'none' as const, hrefValue: '', isMegaMenu: false }];

const parentRowMeta = rows.map((row) => ({ label: row.label, depth: row.depth }));

const categoryOptions = buildCategoryLinkOptions(categories);
const navigationJsonPreview =
	navigation.length > 0 ? `${JSON.stringify(navigation, null, '\t')}\n` : '';

function navHrefSubmitValue(row: (typeof rows)[number]): string {
	if (row.hrefKind === 'none') return '';
	return row.hrefValue;
}

const depthLabels = adminLayout.navDepthLabels;
const depthColors = resolveNavEditorDepthColors(navEditorDepthColors);
const navBodyStyle = navEditorDepthColorsToStyle(depthColors);
const navTableLabels = {
	remove: adminLayout.actions.removeNavRow,
	edit: adminLayout.actions.editNavRow,
	closeEdit: ui.actions.close,
	depth0: depthLabels[0],
	depth1: depthLabels[1],
	depth2: depthLabels[2],
	megaHint: adminLayout.megaMenuHint,
	megaLabel: adminLayout.fields.navMegaMenu,
	addNavChild: adminLayout.actions.addNavChild,
	navParentRoot: adminLayout.navParentRoot,
	navParentMissing: adminLayout.navParentMissing,
	navParentPrefix: 'pod:',
	hrefKinds: adminLayout.navHrefKinds,
	fieldLabels: {
		navDepth: adminLayout.fields.navDepth,
		navParent: adminLayout.fields.navParent,
		navLabel: adminLayout.fields.navLabel,
		navLinkType: adminLayout.fields.navLinkType,
		navLinkTarget: adminLayout.fields.navLinkTarget,
		navMegaMenu: adminLayout.fields.navMegaMenu,
	},
};
const navTargetOptions = buildNavTargetOptions(categoryOptions, pageOptions, {
	emptyCategory: adminLayout.noCategoriesForNav,
	emptyPage: adminLayout.noPublishedPages,
});
const navTargetOptionsJson = JSON.stringify(navTargetOptions);
---

<Panel class="ui-form-section">
	<SectionTitle>{adminLayout.sections.menu}</SectionTitle>
	<p class="ui-hint">{adminLayout.menuFormHint}</p>

	<script id="nav-target-options-json" type="application/json" is:inline set:html={navTargetOptionsJson} />

	<details class="nav-depth-colors-details mb-2">
		<summary class="ui-link inline-block text-xs cursor-pointer">
			{adminLayout.actions.navDepthColorPalettes}
		</summary>
		<div class="nav-depth-colors-panel mt-2">
			<p class="ui-hint">{adminLayout.navDepthColorsHint}</p>
			<div class="nav-depth-colors-grid">
				{
					depthColors.map((colors, depth) => (
						<label class="nav-depth-color-row">
							<span class="nav-depth-color-row-label">{depthLabels[depth]}</span>
							<input
								type="color"
								name={`nav_editor_depth_${depth}_accent`}
								value={colors.accent}
								class="nav-depth-color-input"
								data-nav-depth-color={String(depth)}
								aria-label={`${depthLabels[depth]} — ${adminLayout.fields.navDepthColor}`}
							/>
						</label>
					))
				}
			</div>
		</div>
	</details>

	<div id="navigation-body" class="nav-tile-list w-full" style={navBodyStyle}>
		{
			rows.map((row, rowIndex) => {
				const linkSummary = formatNavTargetSummary(
					row.hrefKind,
					row.hrefValue,
					navTargetOptions,
					adminLayout.navHrefKinds,
				);
				return (
					<div
						class:list={['nav-entry', `nav-row--depth-${row.depth}`]}
						data-nav-entry={String(rowIndex)}
					>
						<div class="nav-tile nav-row-summary">
							<div class="nav-tile-main">
								<span class="nav-summary-label">{row.label.trim() || '—'}</span>
								<span class="nav-summary-sep" aria-hidden="true">·</span>
								<span class="nav-summary-link-text">{linkSummary}</span>
								{
									row.depth === 0 && row.isMegaMenu && (
										<span class="nav-summary-mega ui-caption">{adminLayout.fields.navMegaMenu}</span>
									)
								}
							</div>
							<div class="nav-tile-actions">
								<button type="button" class="edit-nav-row ui-btn ui-btn--link text-xs">
									{adminLayout.actions.editNavRow}
								</button>
								{
									row.depth < 2 && (
										<button type="button" class="add-nav-child ui-btn ui-btn--link text-xs">
											{adminLayout.actions.addNavChild}
										</button>
									)
								}
								<button type="button" class="remove-nav-row ui-btn ui-btn--link-danger text-xs">
									{adminLayout.actions.removeNavRow}
								</button>
							</div>
						</div>
						<div
							class="nav-row-editor hidden"
							data-nav-kind={row.hrefKind}
							data-nav-href={row.hrefValue}
							data-nav-parent={row.parentRowIndex ?? ''}
						>
							<div class="nav-row-editor-panel">
								<div class="nav-row-editor-grid">
									<label class="nav-row-editor-field">
										<span class="nav-row-editor-label">{adminLayout.fields.navDepth}</span>
										<NavDepthSelect depth={row.depth as 0 | 1 | 2} />
									</label>
									<div class="nav-row-editor-field">
										<span class="nav-row-editor-label">{adminLayout.fields.navParent}</span>
										<NavParentSelect
											asCell={false}
											rowIndex={rowIndex}
											depth={row.depth as 0 | 1 | 2}
											parentRowIndex={row.parentRowIndex}
											rows={parentRowMeta}
										/>
									</div>
									<label class="nav-row-editor-field nav-row-editor-field--wide">
										<span class="nav-row-editor-label">{adminLayout.fields.navLabel}</span>
										<input
											name="nav_label"
											value={row.label}
											required
											class="ui-input-compact w-full"
										/>
									</label>
									<label class="nav-row-editor-field">
										<span class="nav-row-editor-label">{adminLayout.fields.navLinkType}</span>
										<NavLinkTypeSelect kind={row.hrefKind} />
									</label>
									<label class="nav-row-editor-field nav-row-editor-field--wide">
										<span class="nav-row-editor-label">{adminLayout.fields.navLinkTarget}</span>
										<div class="nav-href-values">
											<input
												type="hidden"
												name="nav_href_value"
												class="nav-href-value-submit"
												value={navHrefSubmitValue(row)}
											/>
											<NavTargetCell
												kind={row.hrefKind}
												value={row.hrefValue}
												options={navTargetOptions}
											/>
										</div>
									</label>
									<div class="nav-row-editor-field nav-mega-field">
										<span class="nav-row-editor-label">{adminLayout.fields.navMegaMenu}</span>
										<NavMegaMenuCell
											asCell={false}
											depth={row.depth as 0 | 1 | 2}
											checked={row.isMegaMenu}
										/>
									</div>
								</div>
								<div class="nav-row-editor-footer">
									<button type="button" class="close-nav-row ui-btn ui-btn--ghost text-xs">
										{ui.actions.close}
									</button>
								</div>
							</div>
						</div>
					</div>
				);
			})
		}
	</div>
	<Button type="button" id="add-nav-row" variant="add">
		{adminLayout.actions.addNavRow}
	</Button>

	<details class="mt-4">
		<summary class="ui-link text-sm cursor-pointer">{adminLayout.actions.editNavigationJson}</summary>
		<p class="ui-hint mt-2">{adminLayout.menuJsonFallbackHint}</p>
		<textarea
			name="navigation_json"
			rows={8}
			class="ui-textarea ui-textarea--mono mt-2 w-full"
			placeholder='[{"label":"Aktualności","href":"/aktualnosci"}]'
		>{navigationJsonPreview}</textarea>
	</details>
</Panel>

<script define:vars={{ navTableLabels }}>
	globalThis.__OP_NAV_TABLE_LABELS__ = navTableLabels;
</script>
<script>
	import { mountNavigationForm } from '@/lib/admin/navigation-form-client';
	mountNavigationForm(globalThis.__OP_NAV_TABLE_LABELS__);
</script>
