---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import SectionTitle from '@/components/ui/layout/SectionTitle.astro';
import Table from '@/components/ui/table/Table.astro';
import TableHead from '@/components/ui/table/TableHead.astro';
import TableRow from '@/components/ui/table/TableRow.astro';
import TableCell from '@/components/ui/table/TableCell.astro';
import NavDepthSelect from '@/components/admin/layout/NavDepthSelect.astro';
import NavMegaMenuCell from '@/components/admin/layout/NavMegaMenuCell.astro';
import { flattenNavigation, collectNavInternalPageOptions } from '@/lib/admin/navigation-tree';
import { STATIC_ROUTE_OPTIONS, buildCategoryLinkOptions, mergePageOptionsForNavEditor, type PageOption } from '@/lib/admin/link-options';
import type { CategoryDefinition, NavItem } from '@/lib/astro-layout/types';

interface Props {
	navigation: NavItem[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { navigation, categories, publishedPages } = Astro.props;
const pageOptions = mergePageOptionsForNavEditor(
	publishedPages,
	collectNavInternalPageOptions(navigation),
);
const rows =
	navigation.length > 0
		? flattenNavigation(navigation, categories, pageOptions)
		: [{ label: '', depth: 0, hrefKind: 'none' as const, hrefValue: '', isMegaMenu: false }];

const categoryOptions = buildCategoryLinkOptions(categories);
const linkKinds = adminLayout.navHrefKinds;
const navigationJsonPreview =
	navigation.length > 0 ? `${JSON.stringify(navigation, null, '\t')}\n` : '';

function navHrefSubmitValue(row: (typeof rows)[number]): string {
	if (row.hrefKind === 'none') return '';
	return row.hrefValue;
}
const depthLabels = adminLayout.navDepthLabels;
const navTableLabels = {
	remove: adminLayout.actions.removeNavRow,
	depth0: depthLabels[0],
	depth1: depthLabels[1],
	depth2: depthLabels[2],
	megaHint: adminLayout.megaMenuHint,
	hrefKinds: linkKinds,
};
---

<Panel class="ui-form-section">
	<SectionTitle>{adminLayout.sections.menu}</SectionTitle>
	<p class="ui-hint">{adminLayout.menuFormHint}</p>

	<Table dense wrap class="min-w-[48rem] w-full" id="navigation-table">
		<TableHead dense>
			<TableRow dense>
				<TableCell header dense>{adminLayout.fields.navDepth}</TableCell>
				<TableCell header dense>{adminLayout.fields.navLabel}</TableCell>
				<TableCell header dense>{adminLayout.fields.navLinkType}</TableCell>
				<TableCell header dense>{adminLayout.fields.navLinkTarget}</TableCell>
				<TableCell header dense>{adminLayout.fields.navMegaMenu}</TableCell>
				<TableCell header dense>{adminLayout.fields.removeRow}</TableCell>
			</TableRow>
		</TableHead>
		<tbody id="navigation-body">
			{
				rows.map((row) => (
					<tr
						class:list={['nav-row', 'ui-table-dense-row', `nav-row--depth-${row.depth}`]}
						data-nav-kind={row.hrefKind}
						data-nav-href={row.hrefValue}
					>
						<td class="ui-table-dense-td--wide">
							<NavDepthSelect depth={row.depth as 0 | 1 | 2} />
						</td>
						<td class="ui-table-dense-td--wide nav-label-cell">
							<input name="nav_label" value={row.label} required class="ui-input-compact w-full" />
						</td>
						<td class="ui-table-dense-td--wide">
							<input type="hidden" name="nav_href_kind" class="nav-href-kind-submit" value={row.hrefKind} />
							<select class="nav-href-kind ui-select-compact w-full" data-initial-kind={row.hrefKind}>
								{Object.entries(linkKinds).map(([value, label]) => (
									<option value={value} selected={row.hrefKind === value}>{label}</option>
								))}
							</select>
						</td>
						<td class="ui-table-dense-td--wide nav-href-values">
							<input type="hidden" name="nav_href_value" class="nav-href-value-submit" value={navHrefSubmitValue(row)} />
							<input
								value={row.hrefKind === 'custom' ? row.hrefValue : ''}
								class:list={[
									'nav-href-input-default nav-href-field nav-href-field-custom',
									{ 'nav-href-field--active': row.hrefKind === 'custom' },
								]}
								hidden={row.hrefKind !== 'custom'}
								disabled={row.hrefKind !== 'custom'}
							/>
							<input
								value={row.hrefKind === 'external' ? row.hrefValue : ''}
								class:list={[
									'nav-href-input-default nav-href-field nav-href-field-external',
									{ 'nav-href-field--active': row.hrefKind === 'external' },
								]}
								hidden={row.hrefKind !== 'external'}
								disabled={row.hrefKind !== 'external'}
							/>
							<select
								class:list={[
									'nav-href-select nav-href-field nav-href-field-category',
									{ 'nav-href-field--active': row.hrefKind === 'category' },
								]}
								hidden={row.hrefKind !== 'category'}
								disabled={row.hrefKind !== 'category'}
							>
								{categoryOptions.length === 0 ? (
									<option value="">{adminLayout.noCategoriesForNav}</option>
								) : (
									categoryOptions.map((opt) => (
										<option value={opt.path.replace(/^\//, '')} selected={row.hrefKind === 'category' && row.hrefValue === opt.path.replace(/^\//, '')}>
											{opt.title}
										</option>
									))
								)}
							</select>
							<select
								class:list={[
									'nav-href-select nav-href-field nav-href-field-page',
									{ 'nav-href-field--active': row.hrefKind === 'page' },
								]}
								hidden={row.hrefKind !== 'page'}
								disabled={row.hrefKind !== 'page'}
							>
								{pageOptions.length === 0 ? (
									<option value="">{adminLayout.noPublishedPages}</option>
								) : (
									pageOptions.map((page) => (
										<option value={page.path} selected={row.hrefKind === 'page' && row.hrefValue === page.path}>
											{page.title}
										</option>
									))
								)}
								{
									row.hrefKind === 'page' &&
										row.hrefValue &&
										!pageOptions.some((p) => p.path === row.hrefValue) && (
											<option value={row.hrefValue} selected>
												{row.hrefValue}
											</option>
										)
								}
							</select>
							<select
								class:list={[
									'nav-href-select nav-href-field nav-href-field-static',
									{ 'nav-href-field--active': row.hrefKind === 'static' },
								]}
								hidden={row.hrefKind !== 'static'}
								disabled={row.hrefKind !== 'static'}
							>
								{STATIC_ROUTE_OPTIONS.map((opt) => (
									<option value={opt.path} selected={row.hrefKind === 'static' && row.hrefValue === opt.path}>
										{opt.title}
									</option>
								))}
							</select>
						</td>
						<NavMegaMenuCell depth={row.depth as 0 | 1 | 2} checked={row.isMegaMenu} />
						<td class="ui-table-dense-td--wide">
							<button type="button" class="remove-nav-row ui-btn ui-btn--link-danger">{adminLayout.actions.removeNavRow}</button>
						</td>
					</tr>
				))
			}
		</tbody>
	</Table>
	<Button type="button" id="add-nav-row" variant="add">
		{adminLayout.actions.addNavRow}
	</Button>

	<details class="mt-4">
		<summary class="ui-link text-sm cursor-pointer">{adminLayout.actions.editNavigationJson}</summary>
		<p class="ui-hint mt-2">{adminLayout.menuJsonFallbackHint}</p>
		<textarea
			name="navigation_json"
			rows={8}
			class="ui-textarea ui-textarea--mono mt-2 w-full"
			placeholder='[{"label":"Aktualności","href":"/aktualnosci"}]'
		>{navigationJsonPreview}</textarea>
	</details>
</Panel>

<script define:vars={{ navTableLabels }}>
	import { mountNavigationForm } from '@/lib/admin/navigation-form-client';
	mountNavigationForm(navTableLabels);
</script>
