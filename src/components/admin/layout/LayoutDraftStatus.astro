---
import { adminLayout } from '@/i18n';
import Alert from '@/components/ui/feedback/Alert.astro';
import type { DraftLiveStatus } from '@/lib/astro-layout/layout-sync-meta';

interface Props {
	draftStatus?: DraftLiveStatus;
	navHasMissingHref?: boolean;
	lastPublishedAt?: string;
	lastPublishedSha?: string;
	lastDraftSavedAt?: string;
	hasAstroChannel?: boolean;
}

const {
	draftStatus = 'unknown',
	navHasMissingHref = false,
	lastPublishedAt,
	lastPublishedSha,
	lastDraftSavedAt,
	hasAstroChannel = false,
} = Astro.props;

function formatDate(iso?: string): string | null {
	if (!iso) return null;
	const d = new Date(iso);
	if (Number.isNaN(d.getTime())) return null;
	return d.toLocaleString('pl-PL', { dateStyle: 'short', timeStyle: 'short' });
}

const publishedLabel = formatDate(lastPublishedAt);
const draftLabel = formatDate(lastDraftSavedAt);

const showStatus = hasAstroChannel && (draftStatus !== 'unknown' || navHasMissingHref);
const statusVariant = navHasMissingHref ? 'error' : draftStatus === 'in_sync' ? 'success' : 'warning';
const statusMessage = navHasMissingHref
	? adminLayout.draftStatus.draftMissingHref
	: draftStatus === 'in_sync'
		? adminLayout.draftStatus.inSync
		: adminLayout.draftStatus.draftAhead;
---

{
	showStatus && (
		<Alert variant={statusVariant}>
			<p class="font-medium">{statusMessage}</p>
			{publishedLabel && (
				<p class="mt-1 text-sm font-normal opacity-90">
					{adminLayout.draftStatus.lastPublished}: {publishedLabel}
					{lastPublishedSha && ` (${lastPublishedSha})`}
				</p>
			)}
			{draftLabel && (
				<p class="mt-1 text-sm font-normal opacity-90">
					{adminLayout.draftStatus.lastDraft}: {draftLabel}
				</p>
			)}
		</Alert>
	)
}
