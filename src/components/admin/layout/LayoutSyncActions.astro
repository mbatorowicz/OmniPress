---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';

interface Props {
	section: 'navigation' | 'categories' | 'components';
}

const { section } = Astro.props;

const saveLabel =
	section === 'navigation'
		? adminLayout.actions.saveDraftNavigation
		: section === 'categories'
			? adminLayout.actions.saveDraftCategories
			: adminLayout.actions.saveDraftComponents;
---

<div class="flex flex-wrap items-center gap-3">
	<Button type="submit" variant="secondary">
		{saveLabel}
	</Button>
</div>
