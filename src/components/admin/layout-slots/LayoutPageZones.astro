---
import { adminLayout } from '@/i18n';
import { LAYOUT_EDITOR_ZONE_ORDER } from '@/lib/astro-layout/components';
import type { CategoryDefinition, DisplaySlot, SiteAstroLayout } from '@/lib/astro-layout/types';
import LayoutZoneSection from './LayoutZoneSection.astro';

type PageOption = { path: string; title: string };

interface Props {
	slots: DisplaySlot[];
	categories: CategoryDefinition[];
	categoryDisplays: SiteAstroLayout['categoryDisplays'];
	publishedPages: PageOption[];
}

const { slots, categories, categoryDisplays, publishedPages } = Astro.props;

const anchorLabels: Record<string, string> = {
	topbar: adminLayout.slotsZoneTopbar ?? 'Pasek górny',
	header: adminLayout.slotsZoneHeader ?? 'Nagłówek',
	home: adminLayout.slotsPreviewHomeZone,
	sidebar: adminLayout.slotsPreviewSidebarZone,
	footer: adminLayout.slotsZoneFooter ?? 'Stopka',
	site: adminLayout.slotsZoneSite ?? 'Meta',
};
---

<nav class="layout-page-nav" aria-label={adminLayout.layoutPageNavLabel ?? 'Sekcje strony'}>
	{
		LAYOUT_EDITOR_ZONE_ORDER.map((zone) => (
			<a href={`#zone-${zone}`} class="ui-btn ui-btn--secondary ui-btn--compact">
				{anchorLabels[zone]}
			</a>
		))
	}
	<a href="#zone-categories" class="ui-btn ui-btn--secondary ui-btn--compact">
		{adminLayout.categoriesTitle}
	</a>
</nav>

<div class="flex flex-col gap-8">
	{
		LAYOUT_EDITOR_ZONE_ORDER.map((zone) => (
			<LayoutZoneSection
				zone={zone}
				slots={slots}
				categories={categories}
				categoryDisplays={categoryDisplays}
				publishedPages={publishedPages}
			>
				{zone === 'header' ? <slot name="header-extra" slot="header-extra" /> : null}
			</LayoutZoneSection>
		))
	}
</div>
