---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import SectionTitle from '@/components/ui/layout/SectionTitle.astro';
import Table from '@/components/ui/table/Table.astro';
import TableHead from '@/components/ui/table/TableHead.astro';
import TableRow from '@/components/ui/table/TableRow.astro';
import TableCell from '@/components/ui/table/TableCell.astro';
import LayoutSlotRow from '@/components/admin/layout-slots/LayoutSlotRow.astro';
import LayoutSlotsPreview from '@/components/admin/layout-slots/LayoutSlotsPreview.astro';
import LayoutPageZones from '@/components/admin/layout-slots/LayoutPageZones.astro';
import LayoutSlotsTemplates from '@/components/admin/layout-slots/LayoutSlotsTemplates.astro';
import { buildComponentOptionsGroupedHtml } from '@/lib/admin/layout-slots-sections';
import { getSingletonComponentIds } from '@/lib/astro-layout/components';
import type { CategoryDefinition, DisplaySlot, SiteAstroLayout } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	slots: DisplaySlot[];
	categories: CategoryDefinition[];
	categoryDisplays: SiteAstroLayout['categoryDisplays'];
	publishedPages: PageOption[];
}

const { slots, categories, categoryDisplays, publishedPages } = Astro.props;
const { fields, actions } = adminLayout;

const zoneTitles: Record<string, string> = {
	topbar: adminLayout.slotsZoneTopbar ?? 'Pasek górny',
	header: adminLayout.slotsZoneHeader ?? 'Nagłówek',
	home: adminLayout.slotsPreviewHomeZone,
	sidebar: adminLayout.slotsPreviewSidebarZone,
	footer: adminLayout.slotsZoneFooter ?? 'Stopka',
	site: adminLayout.slotsZoneSite ?? 'Meta strony',
};

const componentOptionsHtml = buildComponentOptionsGroupedHtml(adminLayout.componentLabels, zoneTitles as Record<import('@/lib/astro-layout/components').LayoutZone, string>);
---

<Panel class="ui-form-section">
	<details class="rounded border border-slate-200 bg-slate-50/50 p-4">
		<summary class="cursor-pointer font-medium text-slate-800">{adminLayout.slotsPreviewTitle}</summary>
		<LayoutSlotsPreview />
	</details>

	<SectionTitle class="mt-6">{adminLayout.zonesEditorTitle ?? adminLayout.slotsConfigTitle}</SectionTitle>
	<p class="ui-hint">{adminLayout.zonesEditorHint ?? adminLayout.slotsConfigHint}</p>

	<LayoutPageZones
		slots={slots}
		categories={categories}
		categoryDisplays={categoryDisplays}
		publishedPages={publishedPages}
	>
		<slot name="header-extra" slot="header-extra" />
	</LayoutPageZones>

	<details class="mt-8 rounded border border-slate-200 bg-slate-50/50 p-4">
		<summary class="cursor-pointer font-medium text-slate-800">
			{adminLayout.slotsAdvancedTitle ?? 'Zaawansowane — identyfikatory i kolejność'}
		</summary>
		<p class="ui-hint mt-2">{adminLayout.slotsManageHint}</p>
		<p class="ui-hint">{adminLayout.slotsOrderHint}</p>

		<Table dense wrap class="min-w-[40rem] mt-3" id="slots-table">
			<TableHead dense>
				<TableRow dense>
					<TableCell header dense>{fields.slotId}</TableCell>
					<TableCell header dense>{fields.slotLabel}</TableCell>
					<TableCell header dense>{fields.slotComponent}</TableCell>
					<TableCell header dense>{fields.widgetOrder}</TableCell>
					<TableCell header dense>{fields.widgetEnabled}</TableCell>
					<TableCell header dense>{actions.removeSlot}</TableCell>
				</TableRow>
			</TableHead>
			<tbody id="slots-body">
				{slots.map((slot) => (
					<LayoutSlotRow slot={slot} zoneTitles={zoneTitles} />
				))}
			</tbody>
		</Table>

		<div class="mt-3 flex flex-wrap items-center gap-2">
			<select id="add-slot-component" class="ui-select-compact">
				<Fragment set:html={componentOptionsHtml} />
			</select>
			<Button type="button" id="add-slot" variant="add">
				{actions.addComponent}
			</Button>
		</div>
	</details>
</Panel>

<LayoutSlotsTemplates categories={categories} publishedPages={publishedPages} />

<script
	define:vars={{
		removeSlotLabel: actions.removeSlot,
		variantDefault: adminLayout.variants.default,
		variantAlert: adminLayout.variants.alert,
		styleImage: adminLayout.bannerStyles.image,
		styleText: adminLayout.bannerStyles.text,
		variantBannerDefault: adminLayout.bannerImageVariants.default,
		variantBannerBlue: adminLayout.bannerImageVariants.blue,
		linkCategory: adminLayout.bannerLinkTypes.category,
		linkPage: adminLayout.bannerLinkTypes.page,
		linkExternal: adminLayout.bannerLinkTypes.external,
		componentOptionsHtml,
		componentLabels: adminLayout.componentLabels,
		slotPanelSectionTitleLabel: adminLayout.slotPanelSectionTitleLabel,
		homeFeedCategoriesLabel: adminLayout.homeFeedCategoriesLabel,
		homeFeedCategoriesHint: adminLayout.homeFeedCategoriesHint,
		homeFeedPinnedHint: adminLayout.homeFeedPinnedHint,
		previewChipNoCategories: adminLayout.previewChipNoCategories,
		previewChipCategoriesPrefix: adminLayout.previewChipCategoriesPrefix,
		previewChipPinnedOnly: adminLayout.previewChipPinnedOnly,
		previewChipLinkPrefix: adminLayout.previewChipLinkPrefix,
		moveUp: adminLayout.slotsPreviewMoveUp,
		moveDown: adminLayout.slotsPreviewMoveDown,
		disabledLabel: adminLayout.slotsPreviewDisabled,
		emptyZone: adminLayout.slotsPreviewEmpty,
		singletonComponents: getSingletonComponentIds(),
		certAllLabel: adminLayout.certCategories.all,
		weatherDetailsDisplayModal: adminLayout.weatherDetailsDisplayOptions.modal,
		weatherDetailsDisplayInline: adminLayout.weatherDetailsDisplayOptions.inline,
		weatherDetailsLayoutStacked: adminLayout.weatherDetailsLayoutOptions.stacked,
		weatherDetailsLayoutGrid: adminLayout.weatherDetailsLayoutOptions.grid,
		settingsLabel: adminLayout.slotDialogOpen ?? 'Ustawienia',
		closeLabel: adminLayout.slotDialogClose ?? 'Zamknij',
		fieldLabels: {
			widgetTitle: fields.widgetTitle,
			widgetSectionTitle: fields.widgetSectionTitle,
			widgetLimit: fields.widgetLimit,
			widgetEmptyText: fields.widgetEmptyText,
			widgetHideWhenEmpty: fields.widgetHideWhenEmpty,
			widgetMoreLink: fields.widgetMoreLink,
			widgetVariant: fields.widgetVariant,
			certAdvisoriesCategory: fields.certAdvisoriesCategory,
			bannerStyle: fields.bannerStyle,
			bannerImageUrl: fields.bannerImageUrl,
			bannerImageVariant: fields.bannerImageVariant,
			bannerTextTitle: fields.bannerTextTitle,
			bannerTextButton: fields.bannerTextButton,
			bannerLinkType: fields.bannerLinkType,
			bannerCategory: fields.bannerCategory,
			bannerPage: fields.bannerPage,
			bannerExternalUrl: fields.bannerExternalUrl,
			weatherTerytPowiat: fields.weatherTerytPowiat,
			weatherLat: fields.weatherLat,
			weatherLon: fields.weatherLon,
			weatherMapZoom: fields.weatherMapZoom,
			weatherMapScope: fields.weatherMapScope,
			weatherShowMap: fields.weatherShowMap,
			weatherDetailsDisplay: fields.weatherDetailsDisplay,
			weatherDetailsLayout: fields.weatherDetailsLayout,
			weatherDetailsSummary: fields.weatherDetailsSummary,
			weatherDetailsCloseLabel: fields.weatherDetailsCloseLabel,
			topbarText: fields.topbarText,
			siteMetaName: fields.siteMetaName,
			siteMetaDescription: fields.siteMetaDescription,
			siteMetaUrl: fields.siteMetaUrl,
			headerBrandLogoUrl: fields.headerBrandLogoUrl,
			headerBrandLogoAlt: fields.headerBrandLogoAlt,
			headerBrandHomeHref: fields.headerBrandHomeHref,
			footerContactCtaLabel: fields.footerContactCtaLabel,
			footerContactCtaHref: fields.footerContactCtaHref,
			footerCopyrightSuffix: fields.footerCopyrightSuffix,
		},
	}}
>
	import { initLayoutSlotsTable, initLayoutSlotCardSummaries } from '@/lib/admin/layout-slots-client';
	import { initLayoutSlotsPreview } from '@/lib/admin/layout-slots-preview-client';
	import { initLayoutSlotDialogs } from '@/lib/admin/layout-slot-dialog-client';

	initLayoutSlotsPreview({
		componentLabels,
		moveUp,
		moveDown,
		disabledLabel,
		emptyZone,
		chipNoCategories: previewChipNoCategories,
		chipCategoriesPrefix: previewChipCategoriesPrefix,
		chipPinnedOnly: previewChipPinnedOnly,
		chipLinkPrefix: previewChipLinkPrefix,
	});

	initLayoutSlotsTable({
		removeSlotLabel,
		variantDefault,
		variantAlert,
		styleImage,
		styleText,
		variantBannerDefault,
		variantBannerBlue,
		linkCategory,
		linkPage,
		linkExternal,
		componentOptionsHtml,
		componentLabels,
		slotPanelSectionTitleLabel,
		homeFeedCategoriesLabel,
		homeFeedCategoriesHint,
		homeFeedPinnedHint,
		singletonComponents,
		certAllLabel,
		weatherDetailsDisplayModal,
		weatherDetailsDisplayInline,
		weatherDetailsLayoutStacked,
		weatherDetailsLayoutGrid,
		settingsLabel,
		closeLabel,
		fieldLabels,
		homeFeedCategoryCheckboxesHtml: '',
	});

	initLayoutSlotDialogs();
	initLayoutSlotCardSummaries();
</script>
