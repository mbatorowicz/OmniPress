---
import { adminLayout } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import SectionTitle from '@/components/ui/layout/SectionTitle.astro';
import Table from '@/components/ui/table/Table.astro';
import TableHead from '@/components/ui/table/TableHead.astro';
import TableRow from '@/components/ui/table/TableRow.astro';
import TableCell from '@/components/ui/table/TableCell.astro';
import LayoutSlotRow from '@/components/admin/layout-slots/LayoutSlotRow.astro';
import LayoutSlotsPreview from '@/components/admin/layout-slots/LayoutSlotsPreview.astro';
import LayoutSlotsHomeFeed from '@/components/admin/layout-slots/LayoutSlotsHomeFeed.astro';
import LayoutSlotsRecentChanges from '@/components/admin/layout-slots/LayoutSlotsRecentChanges.astro';
import LayoutSlotsCert from '@/components/admin/layout-slots/LayoutSlotsCert.astro';
import LayoutSlotsBanner from '@/components/admin/layout-slots/LayoutSlotsBanner.astro';
import LayoutSlotsWeather from '@/components/admin/layout-slots/LayoutSlotsWeather.astro';
import LayoutSlotsTemplates from '@/components/admin/layout-slots/LayoutSlotsTemplates.astro';
import { LAYOUT_COMPONENT_IDS } from '@/lib/astro-layout/components';
import type { CategoryDefinition, DisplaySlot } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	slots: DisplaySlot[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { slots, categories, publishedPages } = Astro.props;
const { fields, actions, sectionTitles } = adminLayout;

const componentOptionsHtml = LAYOUT_COMPONENT_IDS.map(
	(id) => `<option value="${id}">${adminLayout.componentLabels[id]}</option>`,
).join('');
---

<Panel class="ui-form-section">
	<SectionTitle>{adminLayout.sections.slots}</SectionTitle>
	<p class="ui-hint">{adminLayout.slotsHint}</p>
	<p class="ui-hint">{adminLayout.slotsOrderHint}</p>

	<LayoutSlotsPreview />

	<SectionTitle class="mt-2">{adminLayout.slotsListTitle}</SectionTitle>

	<Table dense wrap class="min-w-[40rem]" id="slots-table">
		<TableHead dense>
			<TableRow dense>
				<TableCell header dense>{fields.slotId}</TableCell>
				<TableCell header dense>{fields.slotLabel}</TableCell>
				<TableCell header dense>{fields.slotComponent}</TableCell>
				<TableCell header dense>{fields.widgetOrder}</TableCell>
				<TableCell header dense>{fields.widgetEnabled}</TableCell>
				<TableCell header dense>{actions.removeSlot}</TableCell>
			</TableRow>
		</TableHead>
		<tbody id="slots-body">
			{slots.map((slot) => (
				<LayoutSlotRow slot={slot} />
			))}
		</tbody>
	</Table>

	<div class="mt-3 flex flex-wrap items-center gap-2">
		<select id="add-slot-component" class="ui-select-compact">
			{LAYOUT_COMPONENT_IDS.map((id) => (
				<option value={id}>{adminLayout.componentLabels[id]}</option>
			))}
		</select>
		<Button type="button" id="add-slot" variant="add">
			{actions.addComponent}
		</Button>
	</div>

	<SectionTitle class="mt-6">{adminLayout.slotsConfigTitle}</SectionTitle>
	<p class="ui-hint">{adminLayout.slotsConfigHint}</p>

	<div id="slots-kind-sections">
		<LayoutSlotsHomeFeed slots={slots} />
		<LayoutSlotsRecentChanges slots={slots} />
		<LayoutSlotsCert slots={slots} />
		<LayoutSlotsBanner slots={slots} categories={categories} publishedPages={publishedPages} />
		<LayoutSlotsWeather slots={slots} />
	</div>
</Panel>

<LayoutSlotsTemplates categories={categories} publishedPages={publishedPages} />

<script
	define:vars={{
		removeSlotLabel: actions.removeSlot,
		variantDefault: adminLayout.variants.default,
		variantAlert: adminLayout.variants.alert,
		styleImage: adminLayout.bannerStyles.image,
		styleText: adminLayout.bannerStyles.text,
		variantBannerDefault: adminLayout.bannerImageVariants.default,
		variantBannerBlue: adminLayout.bannerImageVariants.blue,
		linkCategory: adminLayout.bannerLinkTypes.category,
		linkPage: adminLayout.bannerLinkTypes.page,
		linkExternal: adminLayout.bannerLinkTypes.external,
		componentOptionsHtml,
		singletonComponents: ['sidebar.weather', 'sidebar.recent_changes', 'sidebar.cert_advisories'],
		certAllLabel: adminLayout.certCategories.all,
		sectionTitles,
		weatherDetailsDisplayModal: adminLayout.weatherDetailsDisplayOptions.modal,
		weatherDetailsDisplayInline: adminLayout.weatherDetailsDisplayOptions.inline,
		weatherDetailsLayoutStacked: adminLayout.weatherDetailsLayoutOptions.stacked,
		weatherDetailsLayoutGrid: adminLayout.weatherDetailsLayoutOptions.grid,
		fieldLabels: {
			widgetTitle: fields.widgetTitle,
			widgetSectionTitle: fields.widgetSectionTitle,
			widgetLimit: fields.widgetLimit,
			widgetEmptyText: fields.widgetEmptyText,
			widgetHideWhenEmpty: fields.widgetHideWhenEmpty,
			widgetMoreLink: fields.widgetMoreLink,
			widgetVariant: fields.widgetVariant,
			certAdvisoriesCategory: fields.certAdvisoriesCategory,
			bannerStyle: fields.bannerStyle,
			bannerImageUrl: fields.bannerImageUrl,
			bannerImageVariant: fields.bannerImageVariant,
			bannerTextTitle: fields.bannerTextTitle,
			bannerTextButton: fields.bannerTextButton,
			bannerLinkType: fields.bannerLinkType,
			bannerCategory: fields.bannerCategory,
			bannerPage: fields.bannerPage,
			bannerExternalUrl: fields.bannerExternalUrl,
			weatherTerytPowiat: fields.weatherTerytPowiat,
			weatherLat: fields.weatherLat,
			weatherLon: fields.weatherLon,
			weatherMapZoom: fields.weatherMapZoom,
			weatherMapScope: fields.weatherMapScope,
			weatherShowMap: fields.weatherShowMap,
			weatherDetailsDisplay: fields.weatherDetailsDisplay,
			weatherDetailsLayout: fields.weatherDetailsLayout,
			weatherDetailsSummary: fields.weatherDetailsSummary,
			weatherDetailsCloseLabel: fields.weatherDetailsCloseLabel,
		},
	}}
>
	import { initLayoutSlotsTable } from '@/lib/admin/layout-slots-client';
	initLayoutSlotsTable({
		removeSlotLabel,
		variantDefault,
		variantAlert,
		styleImage,
		styleText,
		variantBannerDefault,
		variantBannerBlue,
		linkCategory,
		linkPage,
		linkExternal,
		componentOptionsHtml,
		singletonComponents,
		certAllLabel,
		sectionTitles,
		weatherDetailsDisplayModal,
		weatherDetailsDisplayInline,
		weatherDetailsLayoutStacked,
		weatherDetailsLayoutGrid,
		fieldLabels,
	});
</script>
