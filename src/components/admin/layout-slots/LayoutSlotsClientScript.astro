---
import { buildLayoutSlotsClientScriptVars } from '@/lib/admin/layout-slots-client-vars';
import { ZONE_COMPONENTS_FORM_ID } from '@/lib/admin/layout-form-ids';
import { toInlineJson } from '@/lib/ui/inline-json';
import type { LayoutZone } from '@/lib/astro-layout/components';

interface Props {
	componentOptionsHtml: string;
	zone?: LayoutZone;
	formId?: string;
	includePreview?: boolean;
	advancedTable?: boolean;
}

const {
	componentOptionsHtml,
	zone,
	formId = ZONE_COMPONENTS_FORM_ID,
	includePreview = false,
	advancedTable = false,
} = Astro.props;
const cspNonce = Astro.locals.cspNonce;
const payloadJson = toInlineJson({
	...buildLayoutSlotsClientScriptVars(componentOptionsHtml),
	includePreview,
	advancedTable,
	editorZone: zone ?? '',
	zoneFormId: formId,
});
---

<script
	type="application/json"
	is:inline
	nonce={cspNonce}
	data-op-layout-slots-boot
	set:html={payloadJson}
/>
<script>
	import { bootLayoutSlotsEditors } from '@/lib/admin/layout-slots-client-boot';
	bootLayoutSlotsEditors();
</script>
