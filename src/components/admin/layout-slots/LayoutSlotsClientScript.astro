---
import { buildLayoutSlotsClientScriptVars } from '@/lib/admin/layout-slots-client-vars';
import type { LayoutZone } from '@/lib/astro-layout/components';

interface Props {
	componentOptionsHtml: string;
	zone?: LayoutZone;
	includePreview?: boolean;
	advancedTable?: boolean;
}

const { componentOptionsHtml, zone, includePreview = false, advancedTable = false } = Astro.props;
const scriptVars = buildLayoutSlotsClientScriptVars(componentOptionsHtml);
---

<script define:vars={{ ...scriptVars, includePreview, advancedTable, editorZone: zone ?? '' }}>
	import { initLayoutSlotsTable, initLayoutSlotCardSummaries, initLayoutZoneEditor } from '@/lib/admin/layout-slots-client';
	import { initLayoutSlotsPreview } from '@/lib/admin/layout-slots-preview-client';

	if (includePreview) {
		initLayoutSlotsPreview({
			componentLabels,
			moveUp,
			moveDown,
			disabledLabel,
			emptyZone,
			chipNoCategories: previewChipNoCategories,
			chipCategoriesPrefix: previewChipCategoriesPrefix,
			chipPinnedOnly: previewChipPinnedOnly,
			chipLinkPrefix: previewChipLinkPrefix,
		});
	}

	if (advancedTable) {
		initLayoutSlotsTable(
			{
				removeSlotLabel,
				variantDefault,
				variantAlert,
				styleImage,
				styleText,
				variantBannerDefault,
				variantBannerBlue,
				linkCategory,
				linkPage,
				linkExternal,
				componentOptionsHtml,
				componentLabels,
				slotPanelSectionTitleLabel,
				homeFeedCategoriesLabel,
				homeFeedCategoriesHint,
				homeFeedPinnedHint,
				singletonComponents,
				certAllLabel,
				weatherDetailsDisplayModal,
				weatherDetailsDisplayInline,
				weatherDetailsLayoutStacked,
				weatherDetailsLayoutGrid,
				settingsLabel,
				closeLabel,
				fieldLabels,
				homeFeedCategoryCheckboxesHtml: '',
			},
			editorZone || undefined,
		);
	} else if (editorZone) {
		initLayoutZoneEditor(editorZone, {
			removeSlotLabel,
			variantDefault,
			variantAlert,
			styleImage,
			styleText,
			variantBannerDefault,
			variantBannerBlue,
			linkCategory,
			linkPage,
			linkExternal,
			componentOptionsHtml,
			componentLabels,
			slotPanelSectionTitleLabel,
			homeFeedCategoriesLabel,
			homeFeedCategoriesHint,
			homeFeedPinnedHint,
			singletonComponents,
			certAllLabel,
			weatherDetailsDisplayModal,
			weatherDetailsDisplayInline,
			weatherDetailsLayoutStacked,
			weatherDetailsLayoutGrid,
			settingsLabel,
			closeLabel,
			fieldLabels,
			homeFeedCategoryCheckboxesHtml: '',
		});
	}

	initLayoutSlotCardSummaries();
</script>
