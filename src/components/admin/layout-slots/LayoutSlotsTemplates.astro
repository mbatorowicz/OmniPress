---
import { adminLayout } from '@/i18n';
import { CERT_CATEGORIES } from '@/lib/cert';
import type { CategoryDefinition } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { categories, publishedPages } = Astro.props;
---

<template id="slot-home-feed-category-checkboxes">
	{
		categories.map((cat) => (
			<label class="flex items-start gap-2 text-sm">
				<input type="checkbox" form="__FORMID__" name={`display___SLOTID___${cat.slug}`} class="mt-0.5" />
				<span>
					{cat.name}
					<span class="ui-caption font-mono ml-1">{cat.slug}</span>
				</span>
			</label>
		))
	}
</template>

<template id="slot-cert-category-options">
	<option value="">{adminLayout.certCategories.all}</option>
	{CERT_CATEGORIES.map((category) => (
		<option value={category}>{category}</option>
	))}
</template>

<template id="slot-banner-category-options">
	<option value="">—</option>
	{categories.map((cat) => (
		<option value={cat.slug}>{cat.name}</option>
	))}
</template>

<template id="slot-banner-page-options">
	<option value="">—</option>
	{
		publishedPages.map((page) => (
			<option value={page.path}>{page.title} ({page.path})</option>
		))
	}
</template>
