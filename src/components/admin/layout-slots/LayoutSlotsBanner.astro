---
import { adminLayout } from '@/i18n';
import SectionTitle from '@/components/ui/layout/SectionTitle.astro';
import { getComponentKind } from '@/lib/astro-layout/components';
import { slotFormFields } from '@/lib/astro-layout/slot-form-fields';
import type { CategoryDefinition, DisplaySlot } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	slots: DisplaySlot[];
	categories: CategoryDefinition[];
	publishedPages: PageOption[];
}

const { slots, categories, publishedPages } = Astro.props;
const bannerSlots = slots.filter((s) => getComponentKind(s.component) === 'banner');
const { fields, bannerLinkTypes, bannerStyles, bannerImageVariants } = adminLayout;

if (bannerSlots.length === 0) return null;
---

<div class="ui-divider-section slot-kind-section" data-kind="banner">
	<SectionTitle>{adminLayout.sectionTitles.banner}</SectionTitle>
	{
		bannerSlots.map((slot) => {
			const w = slot.widget ?? {};
			const f = slotFormFields.banner;
			const style = w.style ?? 'image';
			const linkType = w.linkType ?? 'category';
			return (
				<div class="ui-fieldset-nested slot-detail-block" data-slot-id={slot.id}>
					<p class="ui-label-text text-xs font-medium sm:col-span-2">
						{slot.label} · <code class="ui-code">{slot.id}</code>
					</p>
					<label class="ui-label-inline">
						<span class="font-medium">{fields.bannerStyle}</span>
						<select name={f.style(slot.id)} class="slot-banner-style ui-select-compact w-full">
							<option value="image" selected={style !== 'text'}>{bannerStyles.image}</option>
							<option value="text" selected={style === 'text'}>{bannerStyles.text}</option>
						</select>
					</label>
					<label class={`ui-label-inline slot-banner-field-image${style !== 'image' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerImageUrl}</span>
						<input name={f.imageUrl(slot.id)} value={w.imageUrl ?? ''} class="ui-input-compact ui-input-compact--mono w-full" />
					</label>
					<label class={`ui-label-inline slot-banner-field-image${style !== 'image' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerImageVariant}</span>
						<select name={f.imageVariant(slot.id)} class="ui-select-compact w-full">
							<option value="default" selected={w.imageVariant !== 'blue'}>{bannerImageVariants.default}</option>
							<option value="blue" selected={w.imageVariant === 'blue'}>{bannerImageVariants.blue}</option>
						</select>
					</label>
					<label class={`ui-label-inline slot-banner-field-text${style !== 'text' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerTextTitle}</span>
						<input name={f.textTitle(slot.id)} value={w.textTitle ?? ''} class="ui-input-compact w-full" />
					</label>
					<label class={`ui-label-inline slot-banner-field-text${style !== 'text' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerTextButton}</span>
						<input name={f.textButton(slot.id)} value={w.textButton ?? ''} class="ui-input-compact w-full" />
					</label>
					<label class="ui-label-inline">
						<span class="font-medium">{fields.bannerLinkType}</span>
						<select name={f.linkType(slot.id)} class="slot-banner-link-type ui-select-compact w-full">
							<option value="category" selected={linkType === 'category'}>{bannerLinkTypes.category}</option>
							<option value="page" selected={linkType === 'page'}>{bannerLinkTypes.page}</option>
							<option value="external" selected={linkType === 'external'}>{bannerLinkTypes.external}</option>
						</select>
					</label>
					<label class={`ui-label-inline slot-banner-field-category${linkType !== 'category' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerCategory}</span>
						<select name={f.categorySlug(slot.id)} class="ui-select-compact w-full">
							<option value="">—</option>
							{categories.map((cat) => (
								<option value={cat.slug} selected={w.categorySlug === cat.slug}>
									{cat.name}
								</option>
							))}
						</select>
					</label>
					<label class={`ui-label-inline slot-banner-field-page${linkType !== 'page' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerPage}</span>
						<select name={f.pagePath(slot.id)} class="ui-select-compact w-full">
							<option value="">—</option>
							{
								publishedPages.length === 0 ? (
									<option value="" disabled>{adminLayout.noPublishedPages}</option>
								) : (
									publishedPages.map((page) => (
										<option value={page.path} selected={w.pagePath === page.path}>
											{page.title} ({page.path})
										</option>
									))
								)
							}
						</select>
					</label>
					<label class={`ui-label-inline slot-banner-field-external${linkType !== 'external' ? ' hidden' : ''}`}>
						<span class="font-medium">{fields.bannerExternalUrl}</span>
						<input
							name={f.externalUrl(slot.id)}
							value={w.externalUrl ?? ''}
							class="ui-input-compact ui-input-compact--mono w-full"
							placeholder="https://"
						/>
					</label>
				</div>
			);
		})
	}
</div>
