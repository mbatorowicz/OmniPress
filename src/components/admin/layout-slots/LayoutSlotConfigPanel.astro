---
import { getComponentKind } from '@/lib/astro-layout/components';
import type { CategoryDefinition, DisplaySlot, SiteAstroLayout } from '@/lib/astro-layout/types';
import LayoutSlotBannerPanel from './LayoutSlotBannerPanel.astro';
import LayoutSlotChromePanel from './LayoutSlotChromePanel.astro';
import LayoutSlotHomeFeedPanel from './LayoutSlotHomeFeedPanel.astro';
import LayoutSlotLiveFeedPanel from './LayoutSlotLiveFeedPanel.astro';
import LayoutSlotLocalFeedPanel from './LayoutSlotLocalFeedPanel.astro';

type PageOption = { path: string; title: string };

interface Props {
	formId: string;
	slot: DisplaySlot;
	categories: CategoryDefinition[];
	categoryDisplays: SiteAstroLayout['categoryDisplays'];
	publishedPages: PageOption[];
}

const { formId, slot, categories, categoryDisplays, publishedPages } = Astro.props;
const kind = getComponentKind(slot.component);
const selectedSlugs = categoryDisplays[slot.id] ?? [];
---

{
	kind === 'home_feed' ? (
		<LayoutSlotHomeFeedPanel formId={formId} slot={slot} categories={categories} selectedSlugs={selectedSlugs} />
	) : kind === 'local_feed' ? (
		<LayoutSlotLocalFeedPanel formId={formId} slot={slot} />
	) : kind === 'live_feed' ? (
		<LayoutSlotLiveFeedPanel formId={formId} slot={slot} />
	) : kind === 'banner' ? (
		<LayoutSlotBannerPanel formId={formId} slot={slot} categories={categories} publishedPages={publishedPages} />
	) : kind === 'chrome' ? (
		<LayoutSlotChromePanel formId={formId} slot={slot} />
	) : null
}
