---
import { getComponentKind } from '@/lib/astro-layout/components';
import type { CategoryDefinition, DisplaySlot, SiteAstroLayout } from '@/lib/astro-layout/types';
import LayoutSlotBannerPanel from './LayoutSlotBannerPanel.astro';
import LayoutSlotCertPanel from './LayoutSlotCertPanel.astro';
import LayoutSlotHomeFeedPanel from './LayoutSlotHomeFeedPanel.astro';
import LayoutSlotRecentPanel from './LayoutSlotRecentPanel.astro';
import LayoutSlotWeatherPanel from './LayoutSlotWeatherPanel.astro';

type PageOption = { path: string; title: string };

interface Props {
	slot: DisplaySlot;
	categories: CategoryDefinition[];
	categoryDisplays: SiteAstroLayout['categoryDisplays'];
	publishedPages: PageOption[];
}

const { slot, categories, categoryDisplays, publishedPages } = Astro.props;
const kind = getComponentKind(slot.component);
const selectedSlugs = categoryDisplays[slot.id] ?? [];
---

{
	kind === 'home_feed' ? (
		<LayoutSlotHomeFeedPanel slot={slot} categories={categories} selectedSlugs={selectedSlugs} />
	) : kind === 'recent_changes' ? (
		<LayoutSlotRecentPanel slot={slot} />
	) : kind === 'cert' ? (
		<LayoutSlotCertPanel slot={slot} />
	) : kind === 'banner' ? (
		<LayoutSlotBannerPanel slot={slot} categories={categories} publishedPages={publishedPages} />
	) : kind === 'weather' ? (
		<LayoutSlotWeatherPanel slot={slot} />
	) : null
}
