---
import { adminLayout } from '@/i18n';
import { CERT_CATEGORIES } from '@/lib/cert';
import { slotFormFields } from '@/lib/astro-layout/slot-form-fields';
import type { DisplaySlot } from '@/lib/astro-layout/types';
import LayoutSlotPanelHeader from './LayoutSlotPanelHeader.astro';

interface Props {
	slot: DisplaySlot;
}

const { slot } = Astro.props;
const w = slot.widget ?? {};
const f = slotFormFields.cert;
const { fields, variants } = adminLayout;
---

<div
	id={`slot-panel-${slot.id}`}
	class="ui-fieldset-nested slot-config-panel slot-detail-block"
	data-slot-id={slot.id}
	data-component={slot.component}
>
	<LayoutSlotPanelHeader slot={slot} />
	<p class="ui-hint sm:col-span-2">{adminLayout.certAdvisoriesHint}</p>
	<label class="ui-label-inline">
		<span class="font-medium">{fields.widgetTitle}</span>
		<input name={f.title(slot.id)} value={w.title ?? ''} class="ui-input-compact w-full" />
	</label>
	<label class="ui-label-inline">
		<span class="font-medium">{fields.widgetLimit}</span>
		<input name={f.limit(slot.id)} type="number" min="1" value={w.limit ?? ''} class="ui-input-compact w-full" />
	</label>
	<label class="ui-label-inline">
		<span class="font-medium">{fields.widgetEmptyText}</span>
		<input name={f.emptyText(slot.id)} value={w.emptyText ?? ''} class="ui-input-compact w-full" />
	</label>
	<label class="ui-label-inline flex items-center gap-2">
		<input type="checkbox" name={slotFormFields.hideWhenEmpty(slot.id)} checked={w.hideWhenEmpty === true} />
		<span class="font-medium">{fields.widgetHideWhenEmpty}</span>
	</label>
	<label class="ui-label-inline">
		<span class="font-medium">{fields.widgetVariant}</span>
		<select name={f.variant(slot.id)} class="ui-select-compact w-full">
			<option value="default" selected={w.variant !== 'alert'}>{variants.default}</option>
			<option value="alert" selected={w.variant === 'alert'}>{variants.alert}</option>
		</select>
	</label>
	<label class="ui-label-inline">
		<span class="font-medium">{fields.certAdvisoriesCategory}</span>
		<select name={f.categoryFilter(slot.id)} class="ui-select-compact w-full">
			<option value="" selected={!w.categoryFilter}>{adminLayout.certCategories.all}</option>
			{CERT_CATEGORIES.map((category) => (
				<option value={category} selected={w.categoryFilter === category}>
					{category}
				</option>
			))}
		</select>
	</label>
</div>
