---
import { adminLayout } from '@/i18n';
---

<div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" id="slots-preview">
	<h3 class="text-sm font-semibold text-slate-800">{adminLayout.slotsPreviewTitle}</h3>
	<p class="ui-hint mt-1">{adminLayout.slotsPreviewHint}</p>

	<div class="mt-4 overflow-hidden rounded-md border border-dashed border-slate-300">
		<div class="border-b border-slate-200 bg-slate-100 px-3 py-2 text-center text-xs text-slate-500">
			{adminLayout.slotsPreviewMenuPlaceholder}
		</div>
		<div class="grid gap-4 p-3 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
			<div>
				<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
					{adminLayout.slotsPreviewHomeZone}
				</p>
				<div id="slots-preview-home" class="flex flex-col gap-2"></div>
			</div>
			<div>
				<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
					{adminLayout.slotsPreviewSidebarZone}
				</p>
				<div id="slots-preview-sidebar" class="flex flex-col gap-2"></div>
			</div>
		</div>
	</div>
</div>

<script
	define:vars={{
		componentLabels: adminLayout.componentLabels,
		moveUp: adminLayout.slotsPreviewMoveUp,
		moveDown: adminLayout.slotsPreviewMoveDown,
		disabledLabel: adminLayout.slotsPreviewDisabled,
		emptyZone: adminLayout.slotsPreviewEmpty,
	}}
>
	import { initLayoutSlotsPreview } from '@/lib/admin/layout-slots-preview-client';
	initLayoutSlotsPreview({ componentLabels, moveUp, moveDown, disabledLabel, emptyZone });
</script>

<style is:global>
	.slot-row--highlighted {
		outline: 2px solid var(--color-brand, #2563eb);
		outline-offset: -2px;
		background-color: rgb(239 246 255);
	}

	.slot-preview-card:focus-visible {
		outline: 2px solid var(--color-brand, #2563eb);
		outline-offset: 2px;
	}
</style>
