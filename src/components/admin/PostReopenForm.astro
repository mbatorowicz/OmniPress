---
import { adminReview } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import ConfirmScript from '@/components/shared/ConfirmScript.astro';

type Props = {
	postId: string;
};

const { postId } = Astro.props;
---

<Panel variant="sky" class="mt-6">
	<form method="post" action={`/api/admin/posts/${postId}/reopen`} data-confirm={adminReview.reopenConfirm}>
		<p class="text-sm text-slate-700">{adminReview.reopenHint}</p>
		<Button type="submit" variant="secondary" class="mt-3">
			{adminReview.reopen}
		</Button>
	</form>
</Panel>

<ConfirmScript />
