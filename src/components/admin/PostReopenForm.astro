---
import { adminReview } from '@/i18n';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';

type Props = {
	postId: string;
};

const { postId } = Astro.props;
---

<Panel variant="sky" class="mt-6">
	<form method="post" action={`/api/admin/posts/${postId}/reopen`} data-reopen-form>
		<p class="text-sm text-slate-700">{adminReview.reopenHint}</p>
		<Button type="submit" variant="secondary" class="mt-3">
			{adminReview.reopen}
		</Button>
	</form>
</Panel>

<script define:vars={{ reopenConfirm: adminReview.reopenConfirm }}>
	for (const form of document.querySelectorAll('[data-reopen-form]')) {
		form.addEventListener('submit', (e) => {
			if (!confirm(reopenConfirm)) e.preventDefault();
		});
	}
</script>
