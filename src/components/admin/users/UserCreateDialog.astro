---
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import { adminUsers } from '@/i18n';
import type { SiteRow } from '@/lib/posts/site';

interface Props {
	sites: SiteRow[];
	errorMessage: string | null;
}

const { sites, errorMessage } = Astro.props;
const t = adminUsers.create;
---

<Button type="button" id="user-create-open">{t.open}</Button>

<dialog id="user-create-dialog" class="ui-dialog" data-open={errorMessage ? 'true' : 'false'}>
	<div class="ui-dialog-header">
		<div>
			<h2 class="ui-heading">{t.heading}</h2>
			<p class="ui-lead">{t.lead}</p>
		</div>
		<button type="button" id="user-create-close" class="ui-dialog-close" aria-label={t.closeAria}>
			✕
		</button>
	</div>

	{errorMessage && <Alert variant="error">{errorMessage}</Alert>}

	<form method="post" action="/api/admin/users/create" class="space-y-4">
		<label class="ui-label">
			<span class="font-medium">{t.email}</span>
			<input name="email" type="email" required class="ui-input" />
		</label>
		<label class="ui-label">
			<span>{t.displayName}</span>
			<input name="display_name" class="ui-input" />
		</label>
		<label class="ui-label">
			<span class="font-medium">{t.password}</span>
			<input
				name="password"
				type="password"
				required
				minlength={8}
				autocomplete="new-password"
				class="ui-input"
			/>
		</label>
		<label class="ui-label">
			<span class="font-medium">{t.role}</span>
			<select name="role" class="ui-input ui-select max-w-xs">
				<option value="editor">{adminUsers.roles.editor}</option>
				<option value="admin">{adminUsers.roles.admin}</option>
			</select>
		</label>
		{
			sites.length > 0 ? (
				<fieldset class="text-sm">
					<legend class="mb-2 font-medium">{t.sites}</legend>
					<ul class="space-y-2">
						{sites.map((s) => (
							<li>
								<label class="flex items-center gap-2">
									<input type="checkbox" name="site_ids" value={s.id} class="ui-checkbox" />
									{s.name}
								</label>
							</li>
						))}
					</ul>
				</fieldset>
			) : (
				<p class="text-sm text-amber-800">{t.noSites}</p>
			)
		}
		{
			sites.length > 0 && (
				<label class="ui-label">
					<span>{t.defaultSite}</span>
					<select name="default_site_id" class="ui-input ui-select">
						<option value="">{t.defaultSiteFirst}</option>
						{sites.map((s) => (
							<option value={s.id}>{s.name}</option>
						))}
					</select>
				</label>
			)
		}
		<div class="flex gap-3 pt-2">
			<Button type="submit">{t.submit}</Button>
			<Button type="button" variant="secondary" id="user-create-cancel">{t.cancel}</Button>
		</div>
	</form>
</dialog>

<script>
	const dialog = document.getElementById('user-create-dialog') as HTMLDialogElement | null;
	const open = () => dialog?.showModal();
	const close = () => dialog?.close();
	document.getElementById('user-create-open')?.addEventListener('click', open);
	document.getElementById('user-create-close')?.addEventListener('click', close);
	document.getElementById('user-create-cancel')?.addEventListener('click', close);
	if (dialog?.dataset.open === 'true') open();
</script>
