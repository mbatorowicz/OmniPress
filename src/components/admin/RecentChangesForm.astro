---
import { adminRecentChanges } from '@/i18n';
import type { RecentChangeEntry } from '@/lib/recent-changes/types';

interface Props {
	siteId: string;
	entries: RecentChangeEntry[];
	hasAstroChannel: boolean;
	errorMessage?: string | null;
	saved?: boolean;
}

const { siteId, entries, hasAstroChannel, errorMessage, saved } = Astro.props;

const kindLabels = adminRecentChanges.kinds;
---

{saved && (
	<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{adminRecentChanges.saved}</p>
)}
{errorMessage && (
	<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{errorMessage}</p>
)}
{!hasAstroChannel && (
	<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
		{adminRecentChanges.noAstroChannel}
	</p>
)}

<section class="mb-8 max-w-4xl space-y-3 rounded-xl border bg-white p-6">
	<h2 class="text-sm font-semibold text-slate-800">{adminRecentChanges.currentHeading}</h2>
	{
		entries.length === 0 ? (
			<p class="text-sm text-slate-500">{adminRecentChanges.currentEmpty}</p>
		) : (
			<div class="overflow-x-auto">
				<table class="w-full min-w-[32rem] text-left text-sm">
					<thead>
						<tr class="border-b text-xs text-slate-500">
							<th class="py-2 pr-3">{adminRecentChanges.table.title}</th>
							<th class="py-2 pr-3">{adminRecentChanges.table.href}</th>
							<th class="py-2 pr-3">{adminRecentChanges.table.kind}</th>
							<th class="py-2">{adminRecentChanges.table.date}</th>
						</tr>
					</thead>
					<tbody>
						{
							entries.map((entry) => (
								<tr class="border-b border-slate-50">
									<td class="py-2 pr-3">{entry.title}</td>
									<td class="py-2 pr-3 font-mono text-xs">{entry.href}</td>
									<td class="py-2 pr-3 text-xs">
										{entry.kind in kindLabels
											? kindLabels[entry.kind as keyof typeof kindLabels]
											: entry.kind}
									</td>
									<td class="py-2 text-xs text-slate-500">
										{new Date(entry.changedAt).toLocaleString('pl-PL')}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		)
	}
</section>

<section class="max-w-2xl space-y-4 rounded-xl border bg-white p-6">
	<h2 class="text-sm font-semibold text-slate-800">{adminRecentChanges.announceHeading}</h2>
	<p class="text-xs text-slate-500">{adminRecentChanges.announceHint}</p>

	<form method="post" action={`/api/admin/sites/${siteId}/changes/announce`} class="space-y-4">
		<label class="block text-sm">
			<span class="font-medium">{adminRecentChanges.fields.title}</span>
			<input
				name="change_title"
				required
				minlength={3}
				placeholder="Zaktualizowano numery rachunków bankowych"
				class="mt-1 w-full rounded-lg border px-3 py-2"
				disabled={!hasAstroChannel}
			/>
		</label>

		<label class="block text-sm">
			<span class="font-medium">{adminRecentChanges.fields.href}</span>
			<input
				name="change_href"
				id="change-href"
				required
				value="/kontakt"
				placeholder="/kontakt"
				class="mt-1 w-full rounded-lg border px-3 py-2 font-mono"
				disabled={!hasAstroChannel}
			/>
		</label>

		<div class="flex flex-wrap gap-2 text-xs">
			<span class="text-slate-500">{adminRecentChanges.presets.label}:</span>
			<button
				type="button"
				class="preset-href rounded border border-slate-200 px-2 py-1 hover:border-brand"
				data-href="/kontakt"
			>
				{adminRecentChanges.presets.kontakt}
			</button>
			<button
				type="button"
				class="preset-href rounded border border-slate-200 px-2 py-1 hover:border-brand"
				data-href="/"
			>
				{adminRecentChanges.presets.home}
			</button>
		</div>

		<label class="block text-sm">
			<span class="font-medium">{adminRecentChanges.fields.kind}</span>
			<select name="change_kind" class="mt-1 w-full rounded-lg border px-3 py-2" disabled={!hasAstroChannel}>
				<option value="page">{adminRecentChanges.kinds.page}</option>
				<option value="manual">{adminRecentChanges.kinds.manual}</option>
			</select>
		</label>

		<button
			type="submit"
			disabled={!hasAstroChannel}
			class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark disabled:opacity-50"
		>
			{adminRecentChanges.actions.announce}
		</button>
	</form>
</section>

<script>
	document.querySelectorAll('.preset-href').forEach((btn) => {
		btn.addEventListener('click', () => {
			const href = btn.getAttribute('data-href');
			const input = document.getElementById('change-href');
			if (href && input instanceof HTMLInputElement) input.value = href;
		});
	});
</script>
