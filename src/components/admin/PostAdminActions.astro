---
import { adminReview } from '@/i18n';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import ConfirmScript from '@/components/shared/ConfirmScript.astro';

type Props = {
	postId: string;
	status: string;
};

const { postId, status } = Astro.props;
const show = status === 'published';
---

{
	show && (
		<div class="mt-6 space-y-4">
			<Panel variant="amber">
				<form
					method="post"
					action={`/api/admin/posts/${postId}/deactivate`}
					data-confirm={adminReview.deactivateConfirm}
				>
					<p class="ui-subheading">{adminReview.deactivateHint}</p>
					<Button type="submit" variant="warning" class="mt-3">
						{adminReview.deactivate}
					</Button>
				</form>
			</Panel>

			<Panel variant="danger">
				<form
					method="post"
					action={`/api/admin/posts/${postId}/delete`}
					data-confirm={adminReview.deleteConfirm}
				>
					<p class="ui-subheading">{adminReview.deleteHint}</p>
					<Button type="submit" variant="danger" class="mt-3">
						{adminReview.delete}
					</Button>
				</form>
			</Panel>
		</div>
	)
}

<ConfirmScript />
