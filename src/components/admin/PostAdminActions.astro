---
import { adminReview } from '@/i18n';

type Props = {
	postId: string;
	status: string;
};

const { postId, status } = Astro.props;
const show = status === 'published';
---

{
	show && (
		<div class="mt-6 space-y-4">
			<form
				method="post"
				action={`/api/admin/posts/${postId}/deactivate`}
				class="rounded-xl border border-amber-100 bg-amber-50/40 p-6"
				data-confirm={adminReview.deactivateConfirm}
			>
				<p class="text-sm text-slate-700">{adminReview.deactivateHint}</p>
				<button
					type="submit"
					class="mt-3 rounded-lg border border-amber-300 bg-white px-4 py-2 text-sm font-medium text-amber-900 hover:bg-amber-50"
				>
					{adminReview.deactivate}
				</button>
			</form>

			<form
				method="post"
				action={`/api/admin/posts/${postId}/delete`}
				class="rounded-xl border border-red-100 bg-red-50/40 p-6"
				data-confirm={adminReview.deleteConfirm}
			>
				<p class="text-sm text-slate-700">{adminReview.deleteHint}</p>
				<button
					type="submit"
					class="mt-3 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-900 hover:bg-red-50"
				>
					{adminReview.delete}
				</button>
			</form>
		</div>
	)
}

<script>
	for (const form of document.querySelectorAll('form[data-confirm]')) {
		form.addEventListener('submit', (e) => {
			const msg = form.getAttribute('data-confirm');
			if (msg && !confirm(msg)) e.preventDefault();
		});
	}
</script>
