---
import { adminDestinations, adminSites, adminUnit } from '@/i18n';
import ChannelTestButton from '@/components/admin/ChannelTestButton.astro';
import type { UnitFormInitial } from '@/lib/admin/unit';

interface Props {
	action: string;
	submitLabel: string;
	initial?: UnitFormInitial;
	errorMessage?: string | null;
	showCredentialsNote?: boolean;
}

const { action, submitLabel, initial, errorMessage, showCredentialsNote = true } = Astro.props;
const i = initial;
---

{showCredentialsNote && (
	<p class="mb-4 rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-700">{adminUnit.credentialsNote}</p>
)}
{errorMessage && (
	<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{errorMessage}</p>
)}

<form method="post" action={action} class="max-w-2xl space-y-6" data-unit-form>
	{i && <input type="hidden" name="site_id" value={i.siteId} />}
	{i?.astro && <input type="hidden" name="astro_destination_id" value={i.astro.destinationId} />}
	<input type="hidden" name="enable_astro" value="on" />

	<section class="space-y-4 rounded-xl border bg-white p-6">
		<h2 class="text-sm font-semibold text-slate-800">{adminUnit.sections.unit}</h2>
		<label class="block text-sm">
			<span class="font-medium">{adminSites.fields.name}</span>
			<input
				name="name"
				required
				value={i?.name ?? ''}
				placeholder="UG Miedzna"
				class="mt-1 w-full rounded-lg border px-3 py-2"
			/>
		</label>
		<label class="block text-sm">
			<span class="font-medium">{adminSites.fields.slug}</span>
			<input
				name="slug"
				value={i?.slug ?? ''}
				placeholder="ug-miedzna"
				class="mt-1 w-full rounded-lg border px-3 py-2 font-mono"
			/>
		</label>
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="is_active" checked={i ? i.is_active : true} />
			{adminSites.fields.active}
		</label>
	</section>

	<section class="space-y-4 rounded-xl border bg-white p-6">
		<h2 class="text-sm font-semibold text-slate-800">{adminUnit.sections.astro}</h2>
		<div class="space-y-3 border-l-2 border-slate-100 pl-4">
			<div class="rounded-lg bg-slate-50 p-3 text-xs text-slate-700">
				<p class="font-medium">{adminUnit.astroHelp.title}</p>
				<ul class="mt-2 list-inside list-disc space-y-1">
					<li>{adminUnit.astroHelp.repo}</li>
					<li>{adminUnit.astroHelp.branch}</li>
					<li>{adminUnit.astroHelp.contentPath}</li>
					<li>{adminUnit.astroHelp.token}</li>
				</ul>
			</div>
			<label class="block text-sm">
				<span>{adminDestinations.fields.repo}</span>
				<input
					name="repo"
					id="input-repo"
					required
					value={i?.astro?.repo ?? ''}
					placeholder="mbatorowicz/gmina-miedzna.pl"
					class="mt-1 w-full rounded-lg border px-3 py-2"
				/>
			</label>
			<p class="text-xs text-slate-500">{adminDestinations.fields.repoHint}</p>
			<label class="block text-sm">
				<span>{adminDestinations.fields.branch}</span>
				<input
					name="branch"
					value={i?.astro?.branch ?? 'main'}
					class="mt-1 w-full rounded-lg border px-3 py-2"
				/>
			</label>
			<label class="block text-sm">
				<span>{adminDestinations.fields.contentPath}</span>
				<input
					name="content_path"
					value={i?.astro?.content_path ?? 'src/content/news'}
					class="mt-1 w-full rounded-lg border px-3 py-2"
				/>
			</label>
			<label class="block text-sm">
				<span>Plik kategorii Astro (w repo)</span>
				<input
					name="categories_path"
					value={i?.astro?.categories_path ?? 'src/config/omnipress-categories.json'}
					class="mt-1 w-full rounded-lg border px-3 py-2 font-mono text-sm"
				/>
			</label>
			<p class="text-xs text-slate-500">JSON z listą slug/name — OmniPress pobiera przy edycji wpisu.</p>
			<label class="block text-sm">
				<span>{adminDestinations.fields.contentLayout}</span>
				<select name="content_layout" class="mt-1 w-full rounded-lg border px-3 py-2">
					<option value="flat" selected={!i || i.astro?.content_layout !== 'folder'}>
						{adminDestinations.fields.contentLayoutFlat}
					</option>
					<option value="folder" selected={i?.astro?.content_layout === 'folder'}>
						{adminDestinations.fields.contentLayoutFolder}
					</option>
				</select>
			</label>
			<p class="text-xs text-slate-500">{adminDestinations.fields.credentialsHint}</p>
			<label class="block text-sm">
				<span>{adminDestinations.fields.githubToken}</span>
				<input
					name="github_token"
					type="password"
					autocomplete="new-password"
					class="mt-1 w-full rounded-lg border px-3 py-2"
				/>
			</label>
			<ChannelTestButton destinationId={i?.astro?.destinationId} />
		</div>
	</section>

	<button type="submit" class="rounded-lg bg-brand px-5 py-2.5 text-sm font-medium text-white">
		{submitLabel}
	</button>
</form>
