---
import { adminDestinations, adminSites, adminUnit } from '@/i18n';
import { DEFAULT_CATEGORIES_PATH, DEFAULT_NAVIGATION_PATH } from '@/lib/astro-layout/types';
import { DEFAULT_RECENT_CHANGES_PATH } from '@/lib/recent-changes/types';
import ChannelTestButton from '@/components/admin/ChannelTestButton.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import type { UnitFormInitial } from '@/lib/admin/unit';

interface Props {
	action: string;
	submitLabel: string;
	initial?: UnitFormInitial;
	errorMessage?: string | null;
	showCredentialsNote?: boolean;
	variant?: 'basic' | 'publish' | 'full';
}

const {
	action,
	submitLabel,
	initial,
	errorMessage,
	showCredentialsNote = true,
	variant = 'full',
} = Astro.props;
const i = initial;
const showBasic = variant === 'basic' || variant === 'full';
const showPublish = variant === 'publish' || variant === 'full';
const categoriesPath = i?.astro?.categories_path ?? DEFAULT_CATEGORIES_PATH;
const navigationPath = i?.astro?.navigation_path ?? DEFAULT_NAVIGATION_PATH;
const recentChangesPath = i?.astro?.recent_changes_path ?? DEFAULT_RECENT_CHANGES_PATH;
---

{showCredentialsNote && showPublish && (
	<Alert variant="info" class="ui-alert--note">{adminUnit.credentialsNote}</Alert>
)}
{errorMessage && <Alert variant="error">{errorMessage}</Alert>}

<form method="post" action={action} class="ui-form-stack max-w-2xl" data-unit-form>
	{i && <input type="hidden" name="site_id" value={i.siteId} />}
	{i?.astro && <input type="hidden" name="astro_destination_id" value={i.astro.destinationId} />}
	<input type="hidden" name="enable_astro" value="on" />

	{
		variant === 'publish' && i && (
			<>
				<input type="hidden" name="name" value={i.name} />
				<input type="hidden" name="slug" value={i.slug} />
				{i.is_active && <input type="hidden" name="is_active" value="on" />}
			</>
		)
	}

	{
		variant === 'basic' && i?.astro && (
			<>
				<input type="hidden" name="repo" value={i.astro.repo} />
				<input type="hidden" name="branch" value={i.astro.branch} />
				<input type="hidden" name="content_path" value={i.astro.content_path} />
				<input type="hidden" name="content_layout" value={i.astro.content_layout} />
				<input type="hidden" name="categories_path" value={categoriesPath} />
				<input type="hidden" name="navigation_path" value={navigationPath} />
				<input type="hidden" name="recent_changes_path" value={recentChangesPath} />
				<input type="hidden" name="vercel_project_id" value={i.astro.vercel_project_id} />
				<input type="hidden" name="vercel_team_id" value={i.astro.vercel_team_id} />
			</>
		)
	}

	{
		showBasic && (
			<Panel class="ui-form-section">
				<h2 class="ui-section-title">{adminUnit.sections.unit}</h2>
				<label class="ui-label">
					<span class="font-medium">{adminSites.fields.name}</span>
					<input name="name" required value={i?.name ?? ''} placeholder="UG Miedzna" class="ui-input" />
				</label>
				<label class="ui-label">
					<span class="font-medium">{adminSites.fields.slug}</span>
					<input
						name="slug"
						value={i?.slug ?? ''}
						placeholder="ug-miedzna"
						class="ui-input font-mono"
					/>
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="is_active" checked={i ? i.is_active : true} class="ui-checkbox" />
					{adminSites.fields.active}
				</label>
			</Panel>
		)
	}

	{
		showPublish && (
			<Panel class="ui-form-section">
				<h2 class="ui-section-title">{adminUnit.sections.astro}</h2>
				<div class="ui-form-nested">
					<div class="ui-help-box">
						<p class="font-medium">{adminUnit.astroHelp.title}</p>
						<ul class="mt-2 list-inside list-disc space-y-1">
							<li>{adminUnit.astroHelp.repo}</li>
							<li>{adminUnit.astroHelp.branch}</li>
							<li>{adminUnit.astroHelp.contentPath}</li>
							<li>{adminUnit.astroHelp.token}</li>
						</ul>
					</div>
					<label class="ui-label">
						<span>{adminDestinations.fields.repo}</span>
						<input
							name="repo"
							id="input-repo"
							required
							value={i?.astro?.repo ?? ''}
							placeholder="mbatorowicz/gmina-miedzna.pl"
							class="ui-input"
						/>
					</label>
					<p class="text-xs text-slate-500">{adminDestinations.fields.repoHint}</p>
					<label class="ui-label">
						<span>{adminDestinations.fields.branch}</span>
						<input name="branch" value={i?.astro?.branch ?? 'main'} class="ui-input" />
					</label>
					<label class="ui-label">
						<span>{adminDestinations.fields.contentPath}</span>
						<input
							name="content_path"
							value={i?.astro?.content_path ?? 'src/content/news'}
							class="ui-input"
						/>
					</label>
					<label class="ui-label">
						<span>{adminDestinations.fields.contentLayout}</span>
						<select name="content_layout" class="ui-input ui-select">
							<option value="flat" selected={!i || i.astro?.content_layout !== 'folder'}>
								{adminDestinations.fields.contentLayoutFlat}
							</option>
							<option value="folder" selected={i?.astro?.content_layout === 'folder'}>
								{adminDestinations.fields.contentLayoutFolder}
							</option>
						</select>
					</label>
					<p class="text-xs text-slate-500">{adminDestinations.fields.credentialsHint}</p>
					<label class="ui-label">
						<span>{adminDestinations.fields.githubToken}</span>
						<input
							name="github_token"
							type="password"
							autocomplete="new-password"
							class="ui-input"
						/>
					</label>
					<div class="ui-fieldset-dashed">
						<p class="text-xs font-medium text-slate-700">{adminDestinations.fields.vercelSection}</p>
						<p class="mt-1 text-xs text-slate-500">{adminDestinations.fields.vercelHint}</p>
						<label class="ui-label mt-3">
							<span>{adminDestinations.fields.vercelProjectId}</span>
							<input
								name="vercel_project_id"
								value={i?.astro?.vercel_project_id ?? ''}
								placeholder="prj_xxxxxxxxxxxx"
								class="ui-input font-mono text-sm"
							/>
						</label>
						<label class="ui-label mt-3">
							<span>{adminDestinations.fields.vercelTeamId}</span>
							<input
								name="vercel_team_id"
								value={i?.astro?.vercel_team_id ?? ''}
								placeholder="team_xxx (opcjonalnie)"
								class="ui-input font-mono text-sm"
							/>
						</label>
						<label class="ui-label mt-3">
							<span>{adminDestinations.fields.vercelToken}</span>
							<input
								name="vercel_token"
								type="password"
								autocomplete="new-password"
								class="ui-input"
							/>
						</label>
					</div>
					<details class="mt-4">
						<summary class="ui-link cursor-pointer text-sm">{adminUnit.advancedPathsTitle}</summary>
						<div class="mt-3 space-y-3">
							<label class="ui-label">
								<span>{adminDestinations.fields.categoriesPath}</span>
								<input name="categories_path" value={categoriesPath} class="ui-input font-mono text-sm" />
							</label>
							<label class="ui-label">
								<span>{adminDestinations.fields.navigationPath}</span>
								<input name="navigation_path" value={navigationPath} class="ui-input font-mono text-sm" />
							</label>
							<label class="ui-label">
								<span>{adminDestinations.fields.recentChangesPath}</span>
								<input name="recent_changes_path" value={recentChangesPath} class="ui-input font-mono text-sm" />
							</label>
						</div>
					</details>
					<ChannelTestButton destinationId={i?.astro?.destinationId} />
				</div>
			</Panel>
		)
	}

	<Button type="submit" large>{submitLabel}</Button>
</form>
