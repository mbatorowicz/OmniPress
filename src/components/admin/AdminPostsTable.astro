---
import { common } from '@/i18n';
import Button from '@/components/ui/Button.astro';

type PostRow = {
	id: string;
	title: string;
	category_name: string | null;
	category_slug: string | null;
	updated_at: string;
	created_at?: string;
	sites: { name: string } | null;
};

type Labels = {
	colTitle: string;
	colCategory: string;
	colSite: string;
	colDate: string;
	colActions: string;
	noCategory: string;
	open: string;
	selectAll: string;
	selected: string;
	bulkDeactivate: string;
	bulkDelete: string;
	bulkDeactivateConfirm: string;
	bulkDeleteConfirm: string;
};

type Props = {
	posts: PostRow[];
	labels: Labels;
	showBulkActions?: boolean;
	dateField?: 'updated_at' | 'created_at';
};

const { posts, labels, showBulkActions = false, dateField = 'updated_at' } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'short', timeStyle: 'short' });
---

{
	showBulkActions ? (
		<form
			method="post"
			action="/api/admin/posts/bulk"
			id="bulk-posts-form"
			class="space-y-3"
			data-selected-template={labels.selected}
		>
			<div class="ui-bulk-bar" data-bulk-bar>
				<span class="ui-label-muted" data-selected-label>
					{labels.selected.replace('{n}', '0')}
				</span>
				<Button
					type="submit"
					name="action"
					value="deactivate"
					variant="warning"
					disabled
					confirm={labels.bulkDeactivateConfirm}
					id="bulk-deactivate-btn"
				>
					{labels.bulkDeactivate}
				</Button>
				<Button
					type="submit"
					name="action"
					value="delete"
					variant="danger"
					disabled
					confirm={labels.bulkDeleteConfirm}
					id="bulk-delete-btn"
				>
					{labels.bulkDelete}
				</Button>
			</div>

			<div class="ui-table-wrap">
				<table class="ui-table">
					<thead class="ui-table-head">
						<tr>
							<th class="ui-table-th w-10 px-3">
								<input
									type="checkbox"
									class="ui-checkbox"
									data-select-all
									aria-label={labels.selectAll}
								/>
							</th>
							<th class="ui-table-th">{labels.colTitle}</th>
							<th class="ui-table-th">{labels.colCategory}</th>
							<th class="ui-table-th hidden sm:table-cell">{labels.colSite}</th>
							<th class="ui-table-th">{labels.colDate}</th>
							<th class="ui-table-th">{labels.colActions}</th>
						</tr>
					</thead>
					<tbody class="ui-table-body">
						{
							posts.map((p) => {
								const siteName = (p.sites as { name: string } | null)?.name ?? '—';
								const when = dateFmt.format(new Date(p[dateField] ?? p.updated_at));
								return (
									<tr class="ui-table-row">
										<td class="ui-table-td px-3">
											<input
												type="checkbox"
												name="post_id"
												value={p.id}
												class="ui-checkbox"
												data-post-checkbox
											/>
										</td>
										<td class="ui-table-td">
											<a href={`/admin/posts/${p.id}`} class="ui-link">
												{p.title || common.untitled}
											</a>
										</td>
										<td class="ui-table-td text-slate-700">
											{p.category_name ? (
												<span>
													{p.category_name}
													{p.category_slug && (
														<span class="ml-1 font-mono text-xs text-slate-400">{p.category_slug}</span>
													)}
												</span>
											) : (
												<span class="text-slate-400">{labels.noCategory}</span>
											)}
										</td>
										<td class="ui-table-td hidden text-slate-600 sm:table-cell">{siteName}</td>
										<td class="ui-table-td whitespace-nowrap text-slate-500">{when}</td>
										<td class="ui-table-td">
											<Button href={`/admin/posts/${p.id}`} variant="ghost">
												{labels.open}
											</Button>
										</td>
									</tr>
								);
							})
						}
					</tbody>
				</table>
			</div>
		</form>
	) : (
		<div class="ui-table-wrap mt-4">
			<table class="ui-table">
				<thead class="ui-table-head">
					<tr>
						<th class="ui-table-th">{labels.colTitle}</th>
						<th class="ui-table-th">{labels.colCategory}</th>
						<th class="ui-table-th hidden sm:table-cell">{labels.colSite}</th>
						<th class="ui-table-th">{labels.colDate}</th>
					</tr>
				</thead>
				<tbody class="ui-table-body">
					{
						posts.map((p) => {
							const siteName = (p.sites as { name: string } | null)?.name ?? '—';
							const when = dateFmt.format(new Date(p[dateField] ?? p.updated_at));
							return (
								<tr class="ui-table-row">
									<td class="ui-table-td">
										<a href={`/admin/posts/${p.id}`} class="ui-link">
											{p.title || common.untitled}
										</a>
									</td>
									<td class="ui-table-td text-slate-700">
										{p.category_name ? (
											<span>
												{p.category_name}
												{p.category_slug && (
													<span class="ml-1 font-mono text-xs text-slate-400">{p.category_slug}</span>
												)}
											</span>
										) : (
											<span class="text-slate-400">{labels.noCategory}</span>
										)}
									</td>
									<td class="ui-table-td hidden text-slate-600 sm:table-cell">{siteName}</td>
									<td class="ui-table-td whitespace-nowrap text-slate-500">{when}</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>
	)
}

<script>
	import { initAdminPostsBulkForm } from '@/lib/admin/posts-table';
	initAdminPostsBulkForm();
</script>
