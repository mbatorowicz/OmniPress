---
import { common } from '@/i18n';

type PostRow = {
	id: string;
	title: string;
	category_name: string | null;
	category_slug: string | null;
	updated_at: string;
	created_at?: string;
	sites: { name: string } | null;
};

type Labels = {
	colTitle: string;
	colCategory: string;
	colSite: string;
	colDate: string;
	colActions: string;
	noCategory: string;
	open: string;
	selectAll: string;
	selected: string;
	bulkDeactivate: string;
	bulkDelete: string;
	bulkDeactivateConfirm: string;
	bulkDeleteConfirm: string;
};

type Props = {
	posts: PostRow[];
	labels: Labels;
	showBulkActions?: boolean;
	dateField?: 'updated_at' | 'created_at';
};

const { posts, labels, showBulkActions = false, dateField = 'updated_at' } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'short', timeStyle: 'short' });
---

{
	showBulkActions ? (
		<form
			method="post"
			action="/api/admin/posts/bulk"
			id="bulk-posts-form"
			class="space-y-3"
			data-selected-template={labels.selected}
		>
			<div
				class="sticky top-0 z-10 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm"
				data-bulk-bar
			>
				<span class="text-sm text-slate-600" data-selected-label>
					{labels.selected.replace('{n}', '0')}
				</span>
				<button
					type="submit"
					name="action"
					value="deactivate"
					disabled
					class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-sm font-medium text-amber-900 hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-40"
					data-bulk-deactivate
					data-confirm={labels.bulkDeactivateConfirm}
				>
					{labels.bulkDeactivate}
				</button>
				<button
					type="submit"
					name="action"
					value="delete"
					disabled
					class="rounded-lg border border-red-300 bg-red-50 px-3 py-1.5 text-sm font-medium text-red-800 hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-40"
					data-bulk-delete
					data-confirm={labels.bulkDeleteConfirm}
				>
					{labels.bulkDelete}
				</button>
			</div>

			<div class="overflow-x-auto rounded-lg border border-slate-200">
				<table class="min-w-full text-left text-sm">
					<thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
						<tr>
							<th class="w-10 px-3 py-3">
								<input
									type="checkbox"
									class="rounded border-slate-300"
									data-select-all
									aria-label={labels.selectAll}
								/>
							</th>
							<th class="px-4 py-3 font-medium">{labels.colTitle}</th>
							<th class="px-4 py-3 font-medium">{labels.colCategory}</th>
							<th class="hidden px-4 py-3 font-medium sm:table-cell">{labels.colSite}</th>
							<th class="px-4 py-3 font-medium">{labels.colDate}</th>
							<th class="px-4 py-3 font-medium">{labels.colActions}</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 bg-white">
						{
							posts.map((p) => {
								const siteName = (p.sites as { name: string } | null)?.name ?? '—';
								const when = dateFmt.format(new Date(p[dateField] ?? p.updated_at));
								return (
									<tr class="hover:bg-slate-50/80">
										<td class="px-3 py-3">
											<input
												type="checkbox"
												name="post_id"
												value={p.id}
												class="rounded border-slate-300"
												data-post-checkbox
											/>
										</td>
										<td class="px-4 py-3">
											<a href={`/admin/posts/${p.id}`} class="font-medium text-brand hover:underline">
												{p.title || common.untitled}
											</a>
										</td>
										<td class="px-4 py-3 text-slate-700">
											{p.category_name ? (
												<span>
													{p.category_name}
													{p.category_slug && (
														<span class="ml-1 font-mono text-xs text-slate-400">{p.category_slug}</span>
													)}
												</span>
											) : (
												<span class="text-slate-400">{labels.noCategory}</span>
											)}
										</td>
										<td class="hidden px-4 py-3 text-slate-600 sm:table-cell">{siteName}</td>
										<td class="whitespace-nowrap px-4 py-3 text-slate-500">{when}</td>
										<td class="px-4 py-3">
											<a
												href={`/admin/posts/${p.id}`}
												class="rounded border border-slate-200 px-2 py-1 text-xs hover:bg-slate-50"
											>
												{labels.open}
											</a>
										</td>
									</tr>
								);
							})
						}
					</tbody>
				</table>
			</div>
		</form>
	) : (
		<div class="mt-4 overflow-x-auto rounded-lg border border-slate-200">
			<table class="min-w-full text-left text-sm">
				<thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
					<tr>
						<th class="px-4 py-3 font-medium">{labels.colTitle}</th>
						<th class="px-4 py-3 font-medium">{labels.colCategory}</th>
						<th class="hidden px-4 py-3 font-medium sm:table-cell">{labels.colSite}</th>
						<th class="px-4 py-3 font-medium">{labels.colDate}</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100 bg-white">
					{
						posts.map((p) => {
							const siteName = (p.sites as { name: string } | null)?.name ?? '—';
							const when = dateFmt.format(new Date(p[dateField] ?? p.updated_at));
							return (
								<tr class="hover:bg-slate-50/80">
									<td class="px-4 py-3">
										<a href={`/admin/posts/${p.id}`} class="font-medium text-brand hover:underline">
											{p.title || common.untitled}
										</a>
									</td>
									<td class="px-4 py-3 text-slate-700">
										{p.category_name ? (
											<span>
												{p.category_name}
												{p.category_slug && (
													<span class="ml-1 font-mono text-xs text-slate-400">{p.category_slug}</span>
												)}
											</span>
										) : (
											<span class="text-slate-400">{labels.noCategory}</span>
										)}
									</td>
									<td class="hidden px-4 py-3 text-slate-600 sm:table-cell">{siteName}</td>
									<td class="whitespace-nowrap px-4 py-3 text-slate-500">{when}</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>
	)
}

<script>
	import { initAdminPostsBulkForm } from '@/lib/admin/posts-table';
	initAdminPostsBulkForm();
</script>
