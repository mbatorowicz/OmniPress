---
import { adminLayout } from '@/i18n';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import NavigationSection from '@/components/admin/layout/NavigationSection.astro';
import CategoryMatrixSection from '@/components/admin/layout/CategoryMatrixSection.astro';
import VisibilitySection from '@/components/admin/layout/VisibilitySection.astro';
import LayoutSlotsSection from '@/components/admin/layout-slots/LayoutSlotsSection.astro';
import type { SiteAstroLayout } from '@/lib/astro-layout/types';

type PageOption = { path: string; title: string };

interface Props {
	siteId: string;
	layout: SiteAstroLayout;
	hasAstroChannel: boolean;
	errorMessage?: string | null;
	errorDetail?: string | null;
	syncSummary?: string | null;
	navWarningLines?: string[];
	saved?: boolean;
	synced?: boolean;
	imported?: boolean;
	publishedPages?: PageOption[];
}

const {
	siteId,
	layout,
	hasAstroChannel,
	errorMessage,
	errorDetail,
	syncSummary,
	navWarningLines = [],
	saved,
	synced,
	imported,
	publishedPages = [],
} = Astro.props;
---

{saved && (
	<Alert variant="success">
		{synced ? adminLayout.savedSynced : adminLayout.saved}
		{synced && syncSummary && (
			<p class="mt-1 text-sm font-normal opacity-90">
				{adminLayout.syncSummaryPrefix} {syncSummary}
			</p>
		)}
	</Alert>
)}
{imported && <Alert variant="success">{adminLayout.imported}</Alert>}
{errorMessage && (
	<Alert variant="error">
		{errorMessage}
		{errorDetail && <p class="mt-1 text-sm font-normal opacity-90">{errorDetail}</p>}
	</Alert>
)}
{
	navWarningLines.length > 0 && (
		<Alert variant="warning">
			<p class="font-medium">{adminLayout.navValidationHeading}</p>
			<p class="mt-1 text-sm">{adminLayout.navValidationHint}</p>
			<ul class="mt-2 list-inside list-disc text-sm">
				{navWarningLines.slice(0, 12).map((line) => (
					<li>{line}</li>
				))}
			</ul>
		</Alert>
	)
}
{!hasAstroChannel && <Alert variant="warning">{adminLayout.noAstroChannel}</Alert>}

<form method="post" action={`/api/admin/sites/${siteId}/layout/save`} class="ui-form-stack max-w-5xl">
	<NavigationSection {layout} />
	<LayoutSlotsSection slots={layout.slots} categories={layout.categories} publishedPages={publishedPages} />
	<CategoryMatrixSection {layout} />
	<VisibilitySection {layout} />

	<div class="flex flex-wrap items-center gap-4">
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="sync_github" checked={hasAstroChannel} disabled={!hasAstroChannel} />
			{adminLayout.fields.syncGitHub}
		</label>
		<Button type="submit">{adminLayout.actions.save}</Button>
	</div>
</form>

{
	hasAstroChannel && (
		<form method="post" action={`/api/admin/sites/${siteId}/layout/import`} class="mt-4">
			<button type="submit" class="ui-link text-sm">
				{adminLayout.actions.importFromGitHub}
			</button>
		</form>
	)
}
