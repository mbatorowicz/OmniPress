---
import { adminLayout } from '@/i18n';
import { ASTRO_DISPLAY_SLOTS } from '@/lib/astro-layout/slots';
import type { SiteAstroLayout } from '@/lib/astro-layout/types';

interface Props {
	siteId: string;
	layout: SiteAstroLayout;
	hasAstroChannel: boolean;
	errorMessage?: string | null;
	saved?: boolean;
	synced?: boolean;
	imported?: boolean;
}

const { siteId, layout, hasAstroChannel, errorMessage, saved, synced, imported } = Astro.props;
const navigationJson = JSON.stringify(layout.navigation, null, '\t');
---

{saved && (
	<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">
		{synced ? adminLayout.savedSynced : adminLayout.saved}
	</p>
)}
{imported && (
	<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{adminLayout.imported}</p>
)}
{errorMessage && (
	<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{errorMessage}</p>
)}

{!hasAstroChannel && (
	<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">{adminLayout.noAstroChannel}</p>
)}

<form method="post" action={`/api/admin/sites/${siteId}/layout/save`} class="max-w-4xl space-y-6">
	<section class="space-y-3 rounded-xl border bg-white p-6">
		<h2 class="text-sm font-semibold text-slate-800">{adminLayout.sections.menu}</h2>
		<p class="text-xs text-slate-500">{adminLayout.menuHint}</p>
		<label class="block text-sm">
			<span class="font-medium">{adminLayout.fields.navigationJson}</span>
			<textarea
				name="navigation_json"
				rows={16}
				class="mt-1 w-full rounded-lg border px-3 py-2 font-mono text-xs"
				required>{navigationJson}</textarea
			>
		</label>
		<p class="text-xs text-slate-500">
			{adminLayout.paths.navigation}: <code class="rounded bg-slate-100 px-1">{layout.navigationPath}</code>
		</p>
	</section>

	<section class="space-y-3 rounded-xl border bg-white p-6">
		<h2 class="text-sm font-semibold text-slate-800">{adminLayout.sections.categories}</h2>
		<p class="text-xs text-slate-500">{adminLayout.categoriesHint}</p>
		<div class="overflow-x-auto">
			<table class="w-full min-w-[28rem] text-left text-sm" id="categories-table">
				<thead>
					<tr class="border-b text-xs text-slate-500">
						<th class="py-2 pr-3">{adminLayout.fields.categorySlug}</th>
						<th class="py-2 pr-3">{adminLayout.fields.categoryName}</th>
						<th class="py-2">{adminLayout.fields.removeRow}</th>
					</tr>
				</thead>
				<tbody id="categories-body">
					{
						layout.categories.map((cat) => (
							<tr class="category-row border-b border-slate-50">
								<td class="py-2 pr-3">
									<input
										name="category_slug"
										value={cat.slug}
										required
										class="w-full rounded border px-2 py-1 font-mono text-xs"
									/>
								</td>
								<td class="py-2 pr-3">
									<input
										name="category_name"
										value={cat.name}
										required
										class="w-full rounded border px-2 py-1"
									/>
								</td>
								<td class="py-2">
									<button type="button" class="remove-category text-xs text-red-700 hover:underline">
										{adminLayout.actions.removeCategory}
									</button>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<button
			type="button"
			id="add-category"
			class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs text-slate-700 hover:border-brand"
		>
			{adminLayout.actions.addCategory}
		</button>
		<p class="text-xs text-slate-500">
			{adminLayout.paths.categories}: <code class="rounded bg-slate-100 px-1">{layout.categoriesPath}</code>
		</p>
	</section>

	<section class="space-y-3 rounded-xl border bg-white p-6">
		<h2 class="text-sm font-semibold text-slate-800">{adminLayout.sections.displays}</h2>
		<p class="text-xs text-slate-500">{adminLayout.displaysHint}</p>
		<div class="overflow-x-auto">
			<table class="w-full min-w-[32rem] text-left text-sm">
				<thead>
					<tr class="border-b text-xs text-slate-500">
						<th class="py-2 pr-4">{adminLayout.fields.category}</th>
						{
							ASTRO_DISPLAY_SLOTS.map((slot) => (
								<th class="py-2 px-2 text-center">
									<div>{slot.label}</div>
									<div class="font-normal text-[10px] text-slate-400">{slot.component}</div>
								</th>
							))
						}
					</tr>
				</thead>
				<tbody>
					{
						layout.categories.map((cat) => (
							<tr class="border-b border-slate-50">
								<td class="py-2 pr-4 font-mono text-xs">{cat.slug}</td>
								{
									ASTRO_DISPLAY_SLOTS.map((slot) => {
										const checked = layout.categoryDisplays[slot.id]?.includes(cat.slug) ?? false;
										return (
											<td class="py-2 px-2 text-center">
												<input
													type="checkbox"
													name={`display_${slot.id}_${cat.slug}`}
													checked={checked}
													class="display-checkbox"
													data-slot={slot.id}
													data-slug={cat.slug}
												/>
											</td>
										);
									})
								}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="text-xs text-amber-800">{adminLayout.displaysRefreshHint}</p>
	</section>

	<div class="flex flex-wrap items-center gap-4">
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="sync_github" checked={hasAstroChannel} disabled={!hasAstroChannel} />
			{adminLayout.fields.syncGitHub}
		</label>
		<button
			type="submit"
			class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
		>
			{adminLayout.actions.save}
		</button>
	</div>
</form>

{
	hasAstroChannel && (
		<form method="post" action={`/api/admin/sites/${siteId}/layout/import`} class="mt-4">
			<button type="submit" class="text-sm text-brand hover:underline">
				{adminLayout.actions.importFromGitHub}
			</button>
		</form>
	)
}

<script define:vars={{ addLabel: adminLayout.actions.addCategory, removeLabel: adminLayout.actions.removeCategory }}>
	const body = document.getElementById('categories-body');
	const addBtn = document.getElementById('add-category');

	function bindRemove(row) {
		const btn = row.querySelector('.remove-category');
		btn?.addEventListener('click', () => {
			if (body.querySelectorAll('.category-row').length <= 1) return;
			row.remove();
		});
	}

	body?.querySelectorAll('.category-row').forEach(bindRemove);

	addBtn?.addEventListener('click', () => {
		const tr = document.createElement('tr');
		tr.className = 'category-row border-b border-slate-50';
		tr.innerHTML = `
			<td class="py-2 pr-3"><input name="category_slug" required class="w-full rounded border px-2 py-1 font-mono text-xs" /></td>
			<td class="py-2 pr-3"><input name="category_name" required class="w-full rounded border px-2 py-1" /></td>
			<td class="py-2"><button type="button" class="remove-category text-xs text-red-700 hover:underline">${removeLabel}</button></td>
		`;
		body?.appendChild(tr);
		bindRemove(tr);
	});
</script>
