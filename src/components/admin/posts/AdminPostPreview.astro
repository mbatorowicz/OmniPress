---
import Panel from '@/components/ui/layout/Panel.astro';
import PostContentHtml from '@/components/posts/PostContentHtml.astro';
import PostGalleryPreview from '@/components/posts/preview/PostGalleryPreview.astro';
import { admin, adminReview, common } from '@/i18n';
import { formatScheduledPublishAt } from '@/lib/posts/scheduled-publish';
import type { PostAsset } from '@/lib/publish/asset-model';
import type { PostRow } from '@/lib/posts/access';

interface Props {
	post: PostRow;
	contentHtml: string;
	galleryAssets: PostAsset[];
	extraCategoryNames?: string[];
}

const { post, contentHtml, galleryAssets, extraCategoryNames = [] } = Astro.props;
const preview = admin.preview;
---

<Panel tag="article">
	<h2 class="ui-title-preview">{post.title || common.untitled}</h2>
	{
		post.category_name && (
			<p class="ui-muted mt-1">
				{preview.categoryLabel} <strong>{post.category_name}</strong>
				{post.category_slug && <span class="ui-code font-mono"> ({post.category_slug})</span>}
			</p>
		)
	}
	{
		extraCategoryNames.length > 0 && (
			<p class="ui-muted mt-1">
				{preview.extraCategoriesLabel} <strong>{extraCategoryNames.join(', ')}</strong>
			</p>
		)
	}
	{post.slug && <p class="ui-muted mt-1 font-mono">/{post.slug}</p>}
	{
		post.scheduled_publish_at && (
			<p class="ui-status-line-scheduled mt-2">
				{adminReview.scheduledAt}: <strong>{formatScheduledPublishAt(post.scheduled_publish_at)}</strong>
			</p>
		)
	}
	<div class="ui-preview-content mt-6">
		{contentHtml ? <PostContentHtml html={contentHtml} /> : <p class="ui-muted">{preview.emptyContent}</p>}
	</div>
	<PostGalleryPreview
		assets={galleryAssets}
		heading={preview.galleryHeading}
		coverLabel={preview.galleryCover}
	/>
</Panel>
