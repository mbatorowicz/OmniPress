---
import Panel from '@/components/ui/layout/Panel.astro';
import PostContentHtml from '@/components/posts/PostContentHtml.astro';
import PostGalleryPreview from '@/components/posts/preview/PostGalleryPreview.astro';
import { admin, adminReview, common } from '@/i18n';
import { formatScheduledPublishAt } from '@/lib/posts/scheduled-publish';
import type { PostAsset } from '@/lib/publish/assets';
import type { PostRow } from '@/lib/posts/access';

interface Props {
	post: PostRow;
	contentHtml: string;
	galleryAssets: PostAsset[];
}

const { post, contentHtml, galleryAssets } = Astro.props;
const preview = admin.preview;
---

<Panel tag="article">
	<h2 class="text-xl font-semibold">{post.title || common.untitled}</h2>
	{
		post.category_name && (
			<p class="mt-1 text-sm text-slate-600">
				{preview.categoryLabel} <strong>{post.category_name}</strong>
				{post.category_slug && <span class="font-mono text-slate-500"> ({post.category_slug})</span>}
			</p>
		)
	}
	{post.slug && <p class="mt-1 font-mono text-sm text-slate-500">/{post.slug}</p>}
	{
		post.scheduled_publish_at && (
			<p class="mt-2 text-sm text-violet-800">
				{adminReview.scheduledAt}: <strong>{formatScheduledPublishAt(post.scheduled_publish_at)}</strong>
			</p>
		)
	}
	<div class="mt-6 rounded-lg border border-slate-100 bg-slate-50/50 p-4">
		{contentHtml ? <PostContentHtml html={contentHtml} /> : <p class="text-sm text-slate-500">{preview.emptyContent}</p>}
	</div>
	<PostGalleryPreview
		assets={galleryAssets}
		heading={preview.galleryHeading}
		coverLabel={preview.galleryCover}
	/>
</Panel>
