---
import { admin, common } from '@/i18n';
import Badge from '@/components/ui/feedback/Badge.astro';
import Button from '@/components/ui/actions/Button.astro';
import StatusBadge from '@/components/ui/feedback/StatusBadge.astro';
import TableRow from '@/components/ui/table/TableRow.astro';
import TableCell from '@/components/ui/table/TableCell.astro';
import type { PostStatus } from '@/lib/types';

type PostRow = {
	id: string;
	title: string;
	status?: string;
	category_name: string | null;
	category_slug: string | null;
	updated_at: string;
	created_at?: string;
	scheduled_publish_at?: string | null;
	sites: { name: string } | null;
};

interface Props {
	post: PostRow;
	when: string;
	selectable?: boolean;
	section?: 'pending' | 'scheduled' | 'published';
	labels: {
		noCategory: string;
		open: string;
		approveQuick?: string;
		approveQuickConfirm?: string;
	};
}

const { post, when, selectable, section, labels } = Astro.props;
const siteName = (post.sites as { name: string } | null)?.name ?? '—';
const showQuickApprove = section === 'pending' && Boolean(labels.approveQuick);
const approveFormId = `approve-post-${post.id}`;
const status = (post.status ?? 'draft') as PostStatus;
---

<TableRow>
	{
		selectable && (
			<TableCell class="px-3">
				<input type="checkbox" name="post_id" value={post.id} class="ui-checkbox" data-post-checkbox />
			</TableCell>
		)
	}
	<TableCell>
		<a href={`/admin/posts/${post.id}`} class="ui-link">
			{post.title || common.untitled}
		</a>
		<div class="mt-1 flex flex-wrap items-center gap-1.5">
			{section !== 'pending' && post.status && <StatusBadge status={status} />}
			{post.status === 'publishing' && (
				<Badge variant="publishing">{admin.inProgressBadge}</Badge>
			)}
		</div>
	</TableCell>
	<TableCell class="ui-subheading">
		{
			post.category_name ? (
				<span>
					{post.category_name}
					{post.category_slug && (
						<span class="ui-caption ml-1 font-mono">{post.category_slug}</span>
					)}
				</span>
			) : (
				<span class="ui-caption">{labels.noCategory}</span>
			)
		}
	</TableCell>
	<TableCell class="ui-muted hidden sm:table-cell">{siteName}</TableCell>
	<TableCell class="ui-muted whitespace-nowrap">{when}</TableCell>
	{
		selectable && (
			<TableCell>
				<div class="flex flex-wrap items-center gap-2">
					{showQuickApprove && (
						<Button
							type="submit"
							variant="primary"
							form={approveFormId}
							confirm={labels.approveQuickConfirm}
						>
							{labels.approveQuick}
						</Button>
					)}
					<Button href={`/admin/posts/${post.id}`} variant="ghost">
						{labels.open}
					</Button>
				</div>
			</TableCell>
		)
	}
</TableRow>
