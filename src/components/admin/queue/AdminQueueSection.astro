---
import AdminPostsTable, { type BulkAction } from '@/components/admin/queue/AdminPostsTable.astro';
import PageHeader from '@/components/ui/layout/PageHeader.astro';
import Panel from '@/components/ui/layout/Panel.astro';

type PostRow = {
	id: string;
	title: string;
	status?: string;
	category_name: string | null;
	category_slug: string | null;
	updated_at: string;
	created_at?: string;
	scheduled_publish_at?: string | null;
	sites: { name: string } | null;
};

type Labels = {
	colTitle: string;
	colCategory: string;
	colSite: string;
	colDate: string;
	colActions: string;
	noCategory: string;
	open: string;
	selectAll: string;
	selected: string;
	bulkApprove: string;
	bulkReject: string;
	bulkRejectNote: string;
	bulkCancelSchedule: string;
	bulkDeactivate: string;
	bulkDelete: string;
	bulkApproveConfirm: string;
	bulkRejectConfirm: string;
	bulkCancelScheduleConfirm: string;
	bulkDeactivateConfirm: string;
	bulkDeleteConfirm: string;
};

interface Props {
	title: string;
	lead?: string;
	empty: string;
	posts: PostRow[] | null | undefined;
	labels: Labels;
	variant?: 'default' | 'info';
	bulkActions?: BulkAction[];
	section?: 'pending' | 'scheduled' | 'published';
	dateField?: 'updated_at' | 'created_at' | 'scheduled_publish_at';
	dateColumnLabel?: string;
	id?: string;
}

const {
	title,
	lead,
	empty,
	posts,
	labels,
	variant = 'default',
	bulkActions,
	section,
	dateField,
	dateColumnLabel,
	id,
} = Astro.props;
---

<Panel variant={variant} class="mt-6 scroll-mt-6" {id}>
	<PageHeader title={title} lead={lead} />
	{
		!posts?.length ? (
			<p class="ui-empty">{empty}</p>
		) : (
			<AdminPostsTable
				posts={posts}
				labels={labels}
				{bulkActions}
				{section}
				{dateField}
				{dateColumnLabel}
			/>
		)
	}
</Panel>
