---
import AdminQueueSection from '@/components/admin/queue/AdminQueueSection.astro';
import FlashAlerts from '@/components/shared/FlashAlerts.astro';
import WorkflowStrip from '@/components/shared/WorkflowStrip.astro';
import { admin, adminAllPosts, layout } from '@/i18n';
import type { FlashMessage } from '@/lib/ui/flash';

type PostRow = {
	id: string;
	title: string;
	status?: string;
	category_name: string | null;
	category_slug: string | null;
	updated_at: string;
	created_at?: string;
	scheduled_publish_at?: string | null;
	sites: { name: string } | null;
};

interface Props {
	pending: PostRow[] | null;
	scheduled: PostRow[] | null;
	published: PostRow[] | null;
	flashMessages: FlashMessage[];
}

const { pending, scheduled, published, flashMessages } = Astro.props;
const listLabels = admin.postList;
const pendingCount = pending?.length ?? 0;

const summary = [
	{ id: 'pending', label: admin.queueNav.pending, count: pendingCount },
	{ id: 'scheduled', label: admin.queueNav.scheduled, count: scheduled?.length ?? 0 },
	{ id: 'published', label: admin.queueNav.published, count: published?.length ?? 0 },
];

const workflowSteps = [
	{ label: admin.workflow.review, current: pendingCount > 0, done: pendingCount === 0 },
	{ label: admin.workflow.publish },
	{ label: admin.workflow.live },
];
---

<FlashAlerts messages={flashMessages} />

<WorkflowStrip steps={workflowSteps} ariaLabel={admin.workflowAria} />

<nav class="ui-queue-summary" aria-label={layout.aria.queueSections}>
	{
		summary.map((s) => (
			<a href={`#${s.id}`} class="ui-queue-summary-link">
				{s.label}
				<span class="ui-queue-summary-count">{s.count}</span>
			</a>
		))
	}
	<a href="/admin/posts" class="ui-queue-summary-link">{adminAllPosts.heading}</a>
</nav>

<AdminQueueSection
	id="pending"
	section="pending"
	title={admin.pending.heading(pendingCount)}
	lead={admin.pending.lead}
	empty={admin.pending.empty}
	posts={pending}
	labels={listLabels}
	dateField="created_at"
	bulkActions={['approve', 'reject']}
/>

<AdminQueueSection
	id="scheduled"
	section="scheduled"
	title={admin.scheduled.heading(scheduled?.length ?? 0)}
	lead={admin.scheduled.lead}
	empty={admin.scheduled.empty}
	posts={scheduled}
	labels={listLabels}
	dateField="scheduled_publish_at"
	dateColumnLabel={listLabels.colPublishAt}
	bulkActions={['cancel_schedule']}
/>

<AdminQueueSection
	id="published"
	section="published"
	title={admin.published.heading(published?.length ?? 0)}
	lead={admin.published.lead}
	empty={admin.published.empty}
	posts={published}
	labels={listLabels}
	bulkActions={['deactivate', 'delete']}
	variant="info"
/>
