---
import AdminImportSection from '@/components/admin/queue/AdminImportSection.astro';
import AdminQueueSection from '@/components/admin/queue/AdminQueueSection.astro';
import FlashAlerts from '@/components/shared/FlashAlerts.astro';
import { admin, layout } from '@/i18n';
import type { FlashMessage } from '@/lib/ui/flash';
import type { SiteRow } from '@/lib/posts/site';

type PostRow = {
	id: string;
	title: string;
	category_name: string | null;
	category_slug: string | null;
	updated_at: string;
	created_at?: string;
	scheduled_publish_at?: string | null;
	sites: { name: string } | null;
};

interface Props {
	sites: SiteRow[];
	pending: PostRow[] | null;
	scheduled: PostRow[] | null;
	publishing: PostRow[] | null;
	published: PostRow[] | null;
	flashMessages: FlashMessage[];
	defaultImportSiteId: string;
	importSiteId: string | null;
}

const {
	sites,
	pending,
	scheduled,
	publishing,
	published,
	flashMessages,
	defaultImportSiteId,
	importSiteId,
} = Astro.props;
const listLabels = admin.postList;

const summary = [
	{ id: 'pending', label: admin.queueNav.pending, count: pending?.length ?? 0 },
	{ id: 'scheduled', label: admin.queueNav.scheduled, count: scheduled?.length ?? 0 },
	{ id: 'publishing', label: admin.queueNav.publishing, count: publishing?.length ?? 0 },
	{ id: 'published', label: admin.queueNav.published, count: published?.length ?? 0 },
];
---

<FlashAlerts messages={flashMessages} />

<nav class="ui-queue-summary" aria-label={layout.aria.queueSections}>
	{
		summary.map((s) => (
			<a href={`#${s.id}`} class="ui-queue-summary-link">
				{s.label}
				<span class="ui-queue-summary-count">{s.count}</span>
			</a>
		))
	}
</nav>

<AdminQueueSection
	id="pending"
	title={admin.pending.heading(pending?.length ?? 0)}
	empty={admin.pending.empty}
	posts={pending}
	labels={listLabels}
	dateField="created_at"
/>

<AdminQueueSection
	id="scheduled"
	title={admin.scheduled.heading(scheduled?.length ?? 0)}
	lead={admin.scheduled.lead}
	empty={admin.scheduled.empty}
	posts={scheduled}
	labels={listLabels}
	dateField="scheduled_publish_at"
	dateColumnLabel={listLabels.colPublishAt}
/>

<AdminQueueSection
	id="publishing"
	title={admin.publishing.heading(publishing?.length ?? 0)}
	empty={admin.publishing.empty}
	posts={publishing}
	labels={listLabels}
	dateField="created_at"
/>

<AdminQueueSection
	id="published"
	title={admin.published.heading(published?.length ?? 0)}
	lead={admin.published.lead}
	empty={admin.published.empty}
	posts={published}
	labels={listLabels}
	showBulkActions
	variant="info"
/>

<AdminImportSection sites={sites} {defaultImportSiteId} {importSiteId} />
