---
import { getBuildInfo, getCommitUrl } from '@/config/app';

const { versionLabel, commit } = getBuildInfo();
const commitHref = commit !== 'unknown' ? getCommitUrl(commit) : null;
---

<p class="ui-caption text-center font-mono">
	{
		commitHref ? (
			<a href={commitHref} target="_blank" rel="noopener noreferrer" class="hover:text-brand">
				{versionLabel}
			</a>
		) : (
			versionLabel
		)
	}
</p>
