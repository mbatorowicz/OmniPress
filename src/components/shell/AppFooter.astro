---
import { APP, getBuildInfo, getCommitUrl } from '@/config/app';

const { version, commit, versionLabel } = getBuildInfo();
const commitHref = commit !== 'unknown' ? getCommitUrl(commit) : null;
---

<footer class="ui-footer">
	<div class="ui-footer-inner">
		<span>{APP.name}</span>
		<span class="font-mono" title={`Wersja ${version}, build ${commit}`}>
			{
				commitHref ? (
					<a
						href={commitHref}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-brand"
					>
						{versionLabel}
					</a>
				) : (
					versionLabel
				)
			}
		</span>
	</div>
</footer>
