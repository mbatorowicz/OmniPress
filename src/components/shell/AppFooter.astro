---
import { APP, getBuildInfo, getCommitUrl } from '@/config/app';

const { version, commit, versionLabel } = getBuildInfo();
const commitHref = commit !== 'unknown' ? getCommitUrl(commit) : null;
---

<footer class="mt-auto border-t border-slate-200 bg-surface">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-4 py-3 text-xs text-slate-500"
	>
		<span>{APP.name}</span>
		<span class="font-mono" title={`Wersja ${version}, build ${commit}`}>
			{
				commitHref ? (
					<a
						href={commitHref}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-brand"
					>
						{versionLabel}
					</a>
				) : (
					versionLabel
				)
			}
		</span>
	</div>
</footer>
