---
import Button from '@/components/ui/actions/Button.astro';
import Breadcrumbs, { type Crumb } from '@/components/ui/navigation/Breadcrumbs.astro';
import { adminUnit, layout } from '@/i18n';
import type { AdminUnitSection } from '@/lib/admin/unit-section';

interface Props {
	siteId: string;
	siteName: string;
	section: AdminUnitSection;
	currentLabel?: string;
}

const { siteId, siteName, section, currentLabel } = Astro.props;

const sectionLabels: Record<AdminUnitSection, string> = {
	settings: layout.breadcrumb.settings,
	layout: layout.breadcrumb.layout,
	navigation: layout.breadcrumb.navigation,
	categories: layout.breadcrumb.categories,
	components: layout.breadcrumb.components,
	pages: layout.breadcrumb.pages,
	changes: layout.breadcrumb.changes,
};

const sectionHrefs: Record<AdminUnitSection, string> = {
	settings: `/admin/units/${siteId}`,
	layout: `/admin/units/${siteId}/layout`,
	navigation: `/admin/units/${siteId}/layout#zone-header`,
	categories: `/admin/units/${siteId}/layout#zone-categories`,
	components: `/admin/units/${siteId}/layout#zone-home`,
	pages: `/admin/units/${siteId}/pages`,
	changes: `/admin/units/${siteId}/layout#zone-changes`,
};

const crumbs: Crumb[] = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: layout.breadcrumb.units, href: '/admin/sites' },
	{ label: siteName, href: `/admin/units/${siteId}` },
];

if (section !== 'settings') {
	crumbs.push({
		label: sectionLabels[section],
		href: currentLabel ? sectionHrefs[section] : undefined,
	});
}

if (currentLabel) {
	crumbs.push({ label: currentLabel });
}

const navSections: AdminUnitSection[] = ['layout', 'pages', 'settings'];

const linkLabels: Record<AdminUnitSection, string> = {
	settings: adminUnit.settingsLink,
	layout: adminUnit.layoutLink,
	navigation: adminUnit.navigationLink,
	categories: adminUnit.categoriesLink,
	components: adminUnit.componentsLink,
	pages: adminUnit.pagesLink,
	changes: adminUnit.changesLink,
};
---

<nav class="mb-6" aria-label={layout.aria.adminContext}>
	<Breadcrumbs items={crumbs} />
	<div class="ui-subnav mb-0 mt-3 flex flex-wrap items-center gap-2">
		{
			navSections.map((key) => (
				<Button
					href={sectionHrefs[key]}
					variant={key === section ? 'nav-accent' : 'secondary'}
				>
					{linkLabels[key]}
				</Button>
			))
		}
	</div>
</nav>
