---
import Button from '@/components/ui/actions/Button.astro';
import { adminUnit, layout } from '@/i18n';

export type AdminUnitSection = 'edit' | 'layout' | 'pages' | 'changes';

interface Props {
	siteId: string;
	siteName: string;
	section: AdminUnitSection;
}

const { siteId, siteName, section } = Astro.props;

const sectionLabels: Record<AdminUnitSection, string> = {
	edit: layout.breadcrumb.edit,
	layout: layout.breadcrumb.layout,
	pages: layout.breadcrumb.pages,
	changes: layout.breadcrumb.changes,
};

const links = [
	{ href: `/admin/units/${siteId}`, label: adminUnit.actions.edit, section: 'edit' as const },
	{ href: `/admin/units/${siteId}/layout`, label: adminUnit.layoutLink, section: 'layout' as const },
	{ href: `/admin/units/${siteId}/pages`, label: adminUnit.pagesLink, section: 'pages' as const },
	{ href: `/admin/units/${siteId}/changes`, label: adminUnit.changesLink, section: 'changes' as const },
];
---

<nav class="mb-6" aria-label={layout.aria.adminContext}>
	<ol class="ui-breadcrumb">
		<li>
			<a href="/admin" class="ui-link">{layout.breadcrumb.admin}</a>
		</li>
		<li class="ui-breadcrumb-sep" aria-hidden="true">/</li>
		<li>
			<a href={`/admin/units/${siteId}`} class="ui-link">{siteName}</a>
		</li>
		{
			section !== 'edit' && (
				<>
					<li class="ui-breadcrumb-sep" aria-hidden="true">/</li>
					<li class="ui-breadcrumb-current">{sectionLabels[section]}</li>
				</>
			)
		}
	</ol>
	<div class="ui-subnav mb-0 mt-3">
		{
			links.map((link) => (
				<Button
					href={link.href}
					variant={link.section === section ? 'nav-accent' : 'secondary'}
				>
					{link.label}
				</Button>
			))
		}
	</div>
</nav>
