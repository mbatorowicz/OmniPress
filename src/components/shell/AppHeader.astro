---
import Button from '@/components/ui/actions/Button.astro';
import { common, layout } from '@/i18n';

const profile = Astro.locals.profile;
const pathname = Astro.url.pathname;
const isAdmin = profile?.role === 'admin';
const adminActive = pathname.startsWith('/admin');
const helpActive = pathname === '/dashboard/help';
const panelActive = pathname.startsWith('/dashboard') && !helpActive;
---

<header class="ui-app-header">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
		<a href="/" class="ui-title-brand">{common.appName}</a>
		{
			profile && (
				<nav class="ui-header-nav" aria-label={layout.aria.mainNav}>
					{isAdmin && (
						<a
							href="/admin"
							class:list={['ui-header-nav-link', adminActive && 'ui-header-nav-link--active']}
							aria-current={adminActive ? 'page' : undefined}
						>
							{layout.navAdmin}
						</a>
					)}
					<a
						href="/dashboard"
						class:list={['ui-header-nav-link', panelActive && 'ui-header-nav-link--active']}
						aria-current={panelActive ? 'page' : undefined}
					>
						{isAdmin ? layout.navEditorPanel : layout.navPanel}
					</a>
					<a
						href="/dashboard/help"
						class:list={['ui-header-nav-link', helpActive && 'ui-header-nav-link--active']}
						aria-current={helpActive ? 'page' : undefined}
					>
						{layout.navHelp}
					</a>
					<form method="post" action="/api/auth/signout">
						<Button type="submit" variant="ghost">
							{layout.navSignOut}
						</Button>
					</form>
				</nav>
			)
		}
	</div>
</header>
