---
import PendingCountBadge from '@/components/shell/PendingCountBadge.astro';
import { layout } from '@/i18n';

interface Props {
	pendingCount?: number;
}

const { pendingCount = 0 } = Astro.props;
const pathname = Astro.url.pathname;
const nav = layout.sidebar;

type SidebarLink = {
	href: string;
	label: string;
	active: boolean;
	badge?: number;
	ariaLabel?: string;
};

const links: SidebarLink[] = [
	{
		href: '/admin',
		label: nav.queue,
		active: pathname === '/admin',
		badge: pendingCount,
		ariaLabel: pendingCount > 0 ? layout.aria.queuePending(pendingCount) : undefined,
	},
	{
		href: '/admin/posts',
		label: nav.posts,
		active: pathname.startsWith('/admin/posts'),
	},
	{
		href: '/admin/sites',
		label: nav.sites,
		active: pathname.startsWith('/admin/sites') || pathname.startsWith('/admin/units'),
	},
	{
		href: '/admin/users',
		label: nav.users,
		active: pathname.startsWith('/admin/users') || pathname.startsWith('/admin/editors'),
	},
];
---

<aside class="ui-sidebar">
	<nav class="ui-sidebar-nav" aria-label={layout.aria.sidebarNav}>
		{
			links.map((link) => (
				<a
					href={link.href}
					class:list={['ui-sidebar-link', link.active && 'ui-sidebar-link--active']}
					aria-current={link.active ? 'page' : undefined}
					aria-label={link.ariaLabel}
				>
					{link.label}
					{link.badge != null && <PendingCountBadge count={link.badge} />}
				</a>
			))
		}
	</nav>
</aside>
