---
import Icon from '@/components/ui/Icon.astro';

type Props = {
	initialMarkdown: string;
	placeholder: string;
	toolbar: {
		bold: string;
		italic: string;
		h2: string;
		h3: string;
		bulletList: string;
		orderedList: string;
		link: string;
		linkPrompt: string;
	};
};

const { initialMarkdown, placeholder, toolbar } = Astro.props;
---

<div
	class="rich-editor ui-editor-shell"
	data-rich-editor
	data-placeholder={placeholder}
	data-link-prompt={toolbar.linkPrompt}
>
	<div class="ui-editor-toolbar">
		<button type="button" data-editor-cmd="bold" class="ui-btn ui-btn--toolbar font-bold" title={toolbar.bold}>B</button>
		<button type="button" data-editor-cmd="italic" class="ui-btn ui-btn--toolbar italic" title={toolbar.italic}>I</button>
		<button type="button" data-editor-cmd="h2" class="ui-btn ui-btn--toolbar" title={toolbar.h2}>H2</button>
		<button type="button" data-editor-cmd="h3" class="ui-btn ui-btn--toolbar" title={toolbar.h3}>H3</button>
		<button type="button" data-editor-cmd="bullet" class="ui-btn ui-btn--toolbar" title={toolbar.bulletList}>{toolbar.bulletList}</button>
		<button type="button" data-editor-cmd="ordered" class="ui-btn ui-btn--toolbar" title={toolbar.orderedList}>{toolbar.orderedList}</button>
		<button type="button" data-editor-cmd="link" class="ui-btn ui-btn--toolbar ui-muted" title={toolbar.link}>
			<Icon name="link" size={16} />
		</button>
	</div>
	<div data-tiptap-mount class="min-h-[280px]"></div>
	<textarea name="content_md" class="hidden" data-content-md>{initialMarkdown}</textarea>
</div>

<script>
	import { initPostRichEditor } from '@/lib/editor/client-init';
	initPostRichEditor();
</script>
