---
type Props = {
	html: string;
	class?: string;
};

const { html, class: className = 'post-content-html' } = Astro.props;
---

<div class:list={[className]} set:html={html} />

<style is:global>
	.post-content-html :where(p) {
		margin-bottom: 1rem;
		line-height: 1.65;
	}

	.post-content-html :where(h2, h3) {
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
		font-weight: 600;
	}

	.post-content-html :where(a) {
		color: #1d4ed8;
		text-decoration: underline;
	}

	.post-content-html :where(img) {
		max-width: 100%;
		height: auto;
		border-radius: 0.375rem;
	}
</style>

<script>
	import { initPdfViewers } from '@/lib/pdf-viewer/init';
	initPdfViewers();
</script>
