---
import Icon from '@/components/ui/Icon.astro';
import IconButton from '@/components/ui/actions/IconButton.astro';
import { isPdfAsset, publicUrlForAsset, type PostAssetRow } from '@/lib/posts/assets';

type Props = {
	postId: string;
	assets: PostAssetRow[];
	labels: {
		heading: string;
		empty: string;
		add: string;
		displayLink: string;
		displayEmbed: string;
		remove: string;
		confirmRemove: string;
		removeFailed: string;
	};
};

const { postId, assets, labels } = Astro.props;
const pdfAssets = assets.filter(isPdfAsset);
---

<div
	class="ui-panel--subtle mt-4"
	data-pdf-attachments
	data-post-id={postId}
	data-label-link={labels.displayLink}
	data-label-embed={labels.displayEmbed}
	data-label-remove={labels.remove}
	data-label-confirm-remove={labels.confirmRemove}
	data-label-remove-failed={labels.removeFailed}
>
	<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
		<h3 class="ui-subheading">{labels.heading}</h3>
		<label class="ui-btn ui-btn--file">
			{labels.add}
			<input type="file" accept="application/pdf" class="hidden" data-pdf-upload />
		</label>
	</div>

	<p class:list={['ui-hint', pdfAssets.length > 0 && 'hidden']} data-pdf-empty>
		{labels.empty}
	</p>

	<ul class="space-y-2" data-pdf-list>
		{
			pdfAssets.map((asset) => {
				const url = publicUrlForAsset(asset.storage_path);
				return (
					<li
						class="ui-inline-card"
						data-asset-id={asset.id}
					>
						<div class="min-w-0 flex-1">
							<p class="ui-subheading flex items-center gap-1.5 truncate">
								<Icon name="file-text" size={16} class="ui-muted pointer-events-none" />
								{asset.filename}
							</p>
							{url && (
								<a href={url} target="_blank" rel="noopener noreferrer" class="ui-link text-xs">
									{url}
								</a>
							)}
						</div>
						<fieldset class="ui-label-muted flex shrink-0 flex-col gap-1 text-xs">
							<label class="flex cursor-pointer items-center gap-2">
								<input
									type="radio"
									name={`asset_mode_${asset.id}`}
									value="link"
									checked={asset.display_mode !== 'embed'}
									class="text-brand"
								/>
								{labels.displayLink}
							</label>
							<label class="flex cursor-pointer items-center gap-2">
								<input
									type="radio"
									name={`asset_mode_${asset.id}`}
									value="embed"
									checked={asset.display_mode === 'embed'}
									class="text-brand"
								/>
								{labels.displayEmbed}
							</label>
						</fieldset>
						<IconButton
							variant="iconDanger"
							icon="x"
							ariaLabel={labels.remove}
							dataset={{ 'pdf-remove': '' }}
						/>
					</li>
				);
			})
		}
	</ul>
</div>

<script>
	import { initPdfAttachments } from '@/lib/editor/client-init';
	initPdfAttachments();
</script>
