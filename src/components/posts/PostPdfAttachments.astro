---
import { dashboard } from '@/i18n';
import { isPdfAsset, publicUrlForAsset, type PostAssetRow } from '@/lib/posts/asset-model';

type Props = {
	postId: string;
	assets: PostAssetRow[];
	labels: {
		heading: string;
		empty: string;
		add: string;
		displayLink: string;
		displayEmbed: string;
		moveUp: string;
		moveDown: string;
		remove: string;
		confirmRemove: string;
		removeFailed: string;
	};
};

const { postId, assets, labels } = Astro.props;
const pdfAssets = assets.filter(isPdfAsset).map((a) => ({
	id: a.id,
	url: publicUrlForAsset(a.storage_path) ?? '',
	filename: a.filename,
	display_mode: a.display_mode,
}));
const initialOrder = pdfAssets.map((a) => a.id).join(',');
const ed = dashboard.editor;
---

<div
	class="ui-panel--subtle mt-4"
	data-pdf-attachments
	data-post-id={postId}
	data-initial-assets={JSON.stringify(pdfAssets)}
	data-label-link={labels.displayLink}
	data-label-embed={labels.displayEmbed}
	data-label-move-up={labels.moveUp}
	data-label-move-down={labels.moveDown}
	data-label-remove={labels.remove}
	data-label-confirm-remove={labels.confirmRemove}
	data-label-remove-failed={labels.removeFailed}
	data-label-upload-failed={ed.uploadFailed}
	data-label-network-error={ed.uploadNetworkError}
	data-label-uploading={ed.uploading}
>
	<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
		<h3 class="ui-subheading">{labels.heading}</h3>
		<label class="ui-btn ui-btn--file">
			{labels.add}
			<input type="file" accept="application/pdf" class="hidden" data-pdf-upload />
		</label>
	</div>

	<p class:list={['ui-hint', pdfAssets.length > 0 && 'hidden']} data-pdf-empty>
		{labels.empty}
	</p>

	<ul class="space-y-2" data-pdf-list></ul>

	<input type="hidden" name="pdf_order" value={initialOrder} data-pdf-order />
</div>

<script>
	import { initPdfAttachments } from '@/lib/editor/client-init';
	initPdfAttachments();
</script>
