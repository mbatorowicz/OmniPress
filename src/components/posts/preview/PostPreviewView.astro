---
import Alert from '@/components/ui/feedback/Alert.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import PostContentHtml from '@/components/posts/PostContentHtml.astro';
import PostGalleryPreview from '@/components/posts/preview/PostGalleryPreview.astro';
import PostReopenForm from '@/components/admin/PostReopenForm.astro';
import { common, dashboard } from '@/i18n';
import { formatScheduledPublishAt } from '@/lib/posts/scheduled-publish';
import type { PostAsset } from '@/lib/publish/asset-model';
import type { PostRow } from '@/lib/posts/access';

interface Props {
	post: PostRow;
	contentHtml: string;
	galleryAssets: PostAsset[];
	canReopen: boolean;
	isAdmin: boolean;
	galleryHeading: string;
	coverLabel: string;
}

const { post, contentHtml, galleryAssets, canReopen, isAdmin, galleryHeading, coverLabel } = Astro.props;
const ed = dashboard.editor;
---

<Panel tag="article">
	{post.category_name && (
		<p class="ui-muted">
			{ed.fields.category}: <strong>{post.category_name}</strong>
		</p>
	)}
	<h2 class="ui-title-preview">{post.title || common.untitled}</h2>
	{post.status === 'pending' && <p class="ui-status-line-pending mt-2">{ed.pendingLocked}</p>}
	{post.status === 'publishing' && <p class="ui-status-line-publishing mt-2">{ed.publishingLocked}</p>}
	{post.status === 'published' && <p class="ui-status-line-publishing mt-2">{ed.publishedLocked}</p>}
	{
		post.status === 'scheduled' && post.scheduled_publish_at && (
			<p class="ui-status-line-scheduled mt-2">
				{ed.scheduledLocked} <strong>{formatScheduledPublishAt(post.scheduled_publish_at)}</strong>
			</p>
		)
	}
	{
		post.status === 'pending' && post.scheduled_publish_at && (
			<p class="ui-status-line-pending mt-2">
				{ed.fields.publishAt}: <strong>{formatScheduledPublishAt(post.scheduled_publish_at)}</strong>
			</p>
		)
	}
	{
		post.rejection_note && (
			<Alert variant="error" class="mt-2">
				<strong>{ed.rejectionNote}</strong> {post.rejection_note}
			</Alert>
		)
	}
	<div class="ui-preview-content mt-4">
		{contentHtml ? <PostContentHtml html={contentHtml} /> : <p class="ui-muted">{ed.emptyContent}</p>}
	</div>
	<PostGalleryPreview assets={galleryAssets} heading={galleryHeading} {coverLabel} />
	{canReopen && <PostReopenForm postId={post.id} />}
	{
		isAdmin && post.status === 'pending' && (
			<p class="ui-muted mt-4">
				<a href={`/admin/posts/${post.id}`} class="ui-link">
					{ed.actions.goToReview}
				</a>
			</p>
		)
	}
</Panel>
