---
import SectionTitle from '@/components/ui/layout/SectionTitle.astro';
import type { PostAsset } from '@/lib/publish/asset-model';
import { publicUrlForAsset } from '@/lib/posts/asset-model';

interface Props {
	assets: PostAsset[];
	heading: string;
	coverLabel: string;
}

const { assets, heading, coverLabel } = Astro.props;
---

{
	assets.length > 0 && (
		<div class="mt-6">
			<SectionTitle>{heading}</SectionTitle>
			<div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
				{assets.map((asset, index) => {
					const url = publicUrlForAsset(asset.storage_path);
					if (!url) return null;
					return (
						<div class="ui-thumb-frame">
							{index === 0 && (
								<span class="ui-gallery-cover-badge">
									{coverLabel}
								</span>
							)}
							<img src={url} alt={asset.filename} class="aspect-[4/3] w-full object-cover" loading="lazy" />
						</div>
					);
				})}
			</div>
		</div>
	)
}
