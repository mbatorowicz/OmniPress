---
import { isGalleryImageAsset, publicUrlForAsset, type PostAssetRow } from '@/lib/posts/assets';

type Props = {
	postId: string;
	assets: PostAssetRow[];
	labels: {
		heading: string;
		hint: string;
		empty: string;
		add: string;
		cover: string;
		gallery: string;
		moveUp: string;
		moveDown: string;
		remove: string;
		confirmRemove: string;
		removeFailed: string;
	};
};

const { postId, assets, labels } = Astro.props;
const galleryAssets = assets.filter(isGalleryImageAsset).map((a) => ({
	id: a.id,
	url: publicUrlForAsset(a.storage_path) ?? '',
	filename: a.filename,
}));
const initialOrder = galleryAssets.map((a) => a.id).join(',');
---

<div
	class="ui-gallery-panel"
	data-gallery-panel
	data-post-id={postId}
	data-initial-assets={JSON.stringify(galleryAssets)}
	data-label-cover={labels.cover}
	data-label-gallery={labels.gallery}
	data-label-move-up={labels.moveUp}
	data-label-move-down={labels.moveDown}
	data-label-remove={labels.remove}
	data-label-confirm-remove={labels.confirmRemove}
	data-label-remove-failed={labels.removeFailed}
	data-label-empty={labels.empty}
	data-label-add={labels.add}
>
	<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
		<div>
			<h3 class="ui-subheading">{labels.heading}</h3>
			<p class="ui-hint mt-0.5">{labels.hint}</p>
		</div>
		<label
			class="ui-btn ui-btn--file cursor-pointer"
			data-gallery-upload-label
		>
			{labels.add}
			<input type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" data-gallery-upload multiple />
		</label>
	</div>

	<p class="ui-hint hidden" data-gallery-empty>{labels.empty}</p>

	<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4" data-gallery-grid></div>

	<input type="hidden" name="gallery_order" value={initialOrder} data-gallery-order />
</div>

<script>
	import { initPostGallery } from '@/lib/editor/client-init';
	initPostGallery();
</script>
