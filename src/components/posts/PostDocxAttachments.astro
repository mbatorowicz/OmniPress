---
import { dashboard } from '@/i18n';
import { isDocxAsset, publicUrlForAsset, type PostAssetRow } from '@/lib/posts/assets';

type Props = {
	postId: string;
	assets: PostAssetRow[];
	labels: {
		heading: string;
		empty: string;
		add: string;
		moveUp: string;
		moveDown: string;
		remove: string;
		confirmRemove: string;
		removeFailed: string;
	};
};

const { postId, assets, labels } = Astro.props;
const docxAssets = assets.filter(isDocxAsset).map((a) => ({
	id: a.id,
	url: publicUrlForAsset(a.storage_path) ?? '',
	filename: a.filename,
}));
const initialOrder = docxAssets.map((a) => a.id).join(',');
const ed = dashboard.editor;
---

<div
	class="ui-panel--subtle mt-4"
	data-docx-attachments
	data-post-id={postId}
	data-initial-assets={JSON.stringify(docxAssets)}
	data-label-move-up={labels.moveUp}
	data-label-move-down={labels.moveDown}
	data-label-remove={labels.remove}
	data-label-confirm-remove={labels.confirmRemove}
	data-label-remove-failed={labels.removeFailed}
	data-label-upload-failed={ed.uploadFailed}
	data-label-network-error={ed.uploadNetworkError}
>
	<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
		<h3 class="ui-subheading">{labels.heading}</h3>
		<label class="ui-btn ui-btn--file">
			{labels.add}
			<input
				type="file"
				accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
				class="hidden"
				data-docx-upload
			/>
		</label>
	</div>

	<p class:list={['ui-hint', docxAssets.length > 0 && 'hidden']} data-docx-empty>
		{labels.empty}
	</p>

	<ul class="space-y-2" data-docx-list></ul>

	<input type="hidden" name="docx_order" value={initialOrder} data-docx-order />
</div>

<script>
	import { initDocxAttachments } from '@/lib/editor/client-init';
	initDocxAttachments();
</script>
