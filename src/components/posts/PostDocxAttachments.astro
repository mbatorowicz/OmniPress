---
import Icon from '@/components/ui/Icon.astro';
import IconButton from '@/components/ui/actions/IconButton.astro';
import { isDocxAsset, publicUrlForAsset, type PostAssetRow } from '@/lib/posts/assets';

type Props = {
	postId: string;
	assets: PostAssetRow[];
	labels: {
		heading: string;
		empty: string;
		add: string;
		remove: string;
		confirmRemove: string;
		removeFailed: string;
	};
};

const { postId, assets, labels } = Astro.props;
const docxAssets = assets.filter(isDocxAsset);
---

<div
	class="ui-panel--subtle mt-4"
	data-docx-attachments
	data-post-id={postId}
	data-label-remove={labels.remove}
	data-label-confirm-remove={labels.confirmRemove}
	data-label-remove-failed={labels.removeFailed}
>
	<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
		<h3 class="ui-subheading">{labels.heading}</h3>
		<label class="ui-btn ui-btn--file">
			{labels.add}
			<input
				type="file"
				accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
				class="hidden"
				data-docx-upload
			/>
		</label>
	</div>

	<p class:list={['ui-hint', docxAssets.length > 0 && 'hidden']} data-docx-empty>
		{labels.empty}
	</p>

	<ul class="space-y-2" data-docx-list>
		{
			docxAssets.map((asset) => {
				const url = publicUrlForAsset(asset.storage_path);
				return (
					<li class="ui-inline-card" data-asset-id={asset.id}>
						<div class="min-w-0 flex-1">
							<p class="ui-subheading flex items-center gap-1.5 truncate">
								<Icon name="file-text" size={16} class="ui-muted pointer-events-none" />
								{asset.filename}
							</p>
							{url && (
								<a href={url} target="_blank" rel="noopener noreferrer" class="ui-link text-xs">
									{url}
								</a>
							)}
						</div>
						<IconButton
							variant="iconDanger"
							icon="x"
							ariaLabel={labels.remove}
							dataset={{ 'docx-remove': '' }}
						/>
					</li>
				);
			})
		}
	</ul>
</div>

<script>
	import { initDocxAttachments } from '@/lib/editor/client-init';
	initDocxAttachments();
</script>
