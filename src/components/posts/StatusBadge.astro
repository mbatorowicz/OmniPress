---
import { posts } from '@/i18n';
import type { PostStatus } from '@/lib/types';

interface Props {
	status: PostStatus;
}

const { status } = Astro.props;

const badgeClass: Record<PostStatus, string> = {
	draft: 'ui-badge--draft',
	pending: 'ui-badge--pending',
	scheduled: 'ui-badge--scheduled',
	publishing: 'ui-badge--publishing',
	published: 'ui-badge--published',
	rejected: 'ui-badge--rejected',
};

const labels = posts.status;
---

<span class:list={['ui-badge', badgeClass[status]]}>
	{labels[status]}
</span>
