---
import AppLayout from '@/layouts/AppLayout.astro';
import FlashAlerts from '@/components/shared/FlashAlerts.astro';
import BackLink from '@/components/ui/navigation/BackLink.astro';
import StatusBadge from '@/components/ui/feedback/StatusBadge.astro';
import PostEditorForm from '@/components/posts/editor/PostEditorForm.astro';
import PostPreviewView from '@/components/posts/preview/PostPreviewView.astro';
import { common, dashboard, layout, posts } from '@/i18n';
import { loadPostEditorPage } from '@/lib/posts/editor-page';
import type { PostStatus } from '@/lib/types';
import { parseQueryFlash } from '@/lib/ui/flash';

const { id } = Astro.params;
const profile = Astro.locals.profile!;
const user = Astro.locals.user!;

if (!id) return Astro.redirect('/dashboard');

const page = await loadPostEditorPage(Astro.locals.supabase, id, {
	userId: user.id,
	role: profile.role,
});
if (!page) return Astro.redirect('/dashboard?error=not_found');

// Cudzy wpis admin prowadzi z panelu akceptacji — tam są korekta i decyzja.
if (profile.role === 'admin' && page.post.author_id !== user.id) {
	return Astro.redirect(`/admin/posts/${id}`);
}

const { post, preview } = page;

const flashMessages = parseQueryFlash(Astro.url, {
	errorMap: posts.errors as Record<string, string>,
	saved: dashboard.editor.saved,
});

const ed = dashboard.editor;

const breadcrumbs = [
	{ label: layout.breadcrumb.dashboard, href: '/dashboard' },
	{ label: post.title || common.untitled },
];
---

<AppLayout
	title={post.title || ed.titleFallback}
	heading={page.editable ? ed.headingEdit : ed.headingView}
	{breadcrumbs}
>
	<div class="ui-muted mb-4 flex flex-wrap items-center gap-3">
		<StatusBadge status={post.status as PostStatus} />
		{page.siteName && (
			<span>
				{ed.siteLabel} <strong>{page.siteName}</strong>
			</span>
		)}
	</div>

	<FlashAlerts messages={flashMessages} />

	{
		page.editable ? (
			<PostEditorForm
				{post}
				postId={post.id}
				categories={page.categories}
				categoryWarnings={page.categoryWarnings}
				categoriesUnavailable={page.categoriesUnavailable}
				isAmendment={page.isAmendment}
				submittable={page.submittable}
				deletable={page.deletable}
				postAssets={preview.postAssets}
			/>
		) : (
			<PostPreviewView
				{post}
				contentHtml={preview.contentHtml}
				galleryAssets={preview.galleryAssets}
				canReopen={page.canReopen}
				isAdmin={profile.role === 'admin'}
				galleryHeading={ed.gallery.heading}
				coverLabel={ed.gallery.cover}
				extraCategoryNames={page.extraCategoryNames}
			/>
		)
	}

	<BackLink href="/dashboard" label={ed.backToList.replace('← ', '')} class="mt-6" />
</AppLayout>
