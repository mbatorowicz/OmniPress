---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/posts/StatusBadge.astro';
import { common, dashboard, postError } from '@/i18n';
import { loadSiteCategories } from '@/lib/categories';
import { canEditPost, canSubmitPost, getPostById } from '@/lib/posts';
import type { PostStatus } from '@/lib/types';

const { id } = Astro.params;
const profile = Astro.locals.profile!;
const user = Astro.locals.user!;

if (!id) {
	return Astro.redirect('/dashboard');
}

const post = await getPostById(Astro.locals.supabase, id);
if (!post) {
	return Astro.redirect('/dashboard?error=not_found');
}

const editable = canEditPost(post, user.id, profile.role);
const submittable = canSubmitPost(post, user.id);

const saved = Astro.url.searchParams.get('saved') === '1';
const errorCode = Astro.url.searchParams.get('error');
const errorMessage = errorCode ? postError(errorCode) : null;

const { data: site } = await Astro.locals.supabase
	.from('sites')
	.select('name')
	.eq('id', post.site_id)
	.single();

const { categories, warnings: categoryWarnings } = await loadSiteCategories(
	Astro.locals.supabase,
	post.site_id,
);
const categoriesUnavailable = categories.length === 0;

const ed = dashboard.editor;
---

<AppLayout
	title={post.title || ed.titleFallback}
	heading={editable ? ed.headingEdit : ed.headingView}
>
	<div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-slate-600">
		<StatusBadge status={post.status as PostStatus} />
		{site?.name && (
			<span>
				{ed.siteLabel} <strong>{site.name}</strong>
			</span>
		)}
	</div>

	{saved && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800" role="status">
			{ed.saved}
		</p>
	)}
	{errorMessage && (
		<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" role="alert">
			{errorMessage}
		</p>
	)}

	{
		editable ? (
			<>
				{categoryWarnings.length > 0 && (
					<div class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
						<ul class="list-inside list-disc">
							{categoryWarnings.map((w) => (
								<li>{w}</li>
							))}
						</ul>
					</div>
				)}
				{categoriesUnavailable && (
					<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">
						{ed.fields.categoryEmpty}
					</p>
				)}
				<form
					id="post-form"
					method="post"
					action={`/api/posts/${post.id}/save`}
					class="space-y-4 rounded-xl border border-slate-200 bg-white p-6"
				>
					<label class="block text-sm">
						<span class="font-medium text-slate-700">{ed.fields.category}</span>
						<select
							name="category_slug"
							required
							disabled={categoriesUnavailable}
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
						>
							<option value="">— wybierz kategorię —</option>
							{categories.map((c) => (
								<option
									value={c.slug}
									selected={post.category_slug === c.slug}
								>
									{c.name}
									{c.wpCategoryId ? ` (WP #${c.wpCategoryId})` : ''}
								</option>
							))}
						</select>
					</label>
					<p class="text-xs text-slate-500">{ed.fields.categoryHint}</p>
					<label class="block text-sm">
						<span class="font-medium text-slate-700">{ed.fields.title}</span>
						<input
							type="text"
							name="title"
							required
							value={post.title}
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
						/>
					</label>
					<label class="block text-sm">
						<span class="font-medium text-slate-700">{ed.fields.slug}</span>
						<input
							type="text"
							name="slug"
							value={post.slug ?? ''}
							placeholder={ed.fields.slugPlaceholder}
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm"
						/>
					</label>
					<div>
						<div class="mb-1 flex flex-wrap items-center justify-between gap-2">
							<span class="text-sm font-medium text-slate-700">{ed.fields.content}</span>
							<label class="cursor-pointer rounded-lg border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50">
								{ed.actions.addImage}
								<input type="file" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" class="hidden" data-upload-input />
							</label>
						</div>
						<textarea
							id="content_md"
							name="content_md"
							rows={16}
							class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm"
						>
							{post.content_md}
						</textarea>
						<p class="mt-1 text-xs text-slate-500">{ed.fields.contentHint}</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<button
							type="submit"
							class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
						>
							{ed.actions.save}
						</button>
					</div>
				</form>

				{submittable && (
					<form method="post" action={`/api/posts/${post.id}/submit`} class="mt-4">
						<button
							type="submit"
							disabled={categoriesUnavailable || !post.category_slug}
							class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-900 hover:bg-amber-100 disabled:cursor-not-allowed disabled:opacity-50"
							data-confirm={ed.actions.confirmSubmit}
						>
							{ed.actions.submit}
						</button>
					</form>
				)}
			</>
		) : (
			<article class="rounded-xl border border-slate-200 bg-white p-6">
				{post.category_name && (
					<p class="text-sm text-slate-600">
						{ed.fields.category}: <strong>{post.category_name}</strong>
					</p>
				)}
				<h2 class="text-xl font-semibold">{post.title || common.untitled}</h2>
				{post.status === 'pending' && (
					<p class="mt-2 text-sm text-amber-800">{ed.pendingLocked}</p>
				)}
				{post.status === 'publishing' && (
					<p class="mt-2 text-sm text-sky-800">{ed.publishingLocked}</p>
				)}
				{post.rejection_note && (
					<p class="mt-2 rounded-lg bg-red-50 p-3 text-sm text-red-800">
						<strong>{ed.rejectionNote}</strong> {post.rejection_note}
					</p>
				)}
				<pre class="mt-4 whitespace-pre-wrap rounded-lg bg-slate-50 p-4 text-sm text-slate-800">
					{post.content_md || ed.emptyContent}
				</pre>
			</article>
		)
	}

	<p class="mt-6">
		<a href="/dashboard" class="text-sm text-brand hover:underline">{ed.backToList}</a>
	</p>

	{
		editable && (
			<script
				define:vars={{
					postId: post.id,
					confirmSubmit: ed.actions.confirmSubmit,
					uploadFailed: ed.uploadFailed,
					uploadNetworkError: ed.uploadNetworkError,
				}}
			>
				document.querySelector('[data-confirm]')?.addEventListener('click', (e) => {
					if (!confirm(confirmSubmit)) e.preventDefault();
				});

				const input = document.querySelector('[data-upload-input]');
				const textarea = document.getElementById('content_md');

				input?.addEventListener('change', async () => {
					const file = input.files?.[0];
					if (!file || !textarea) return;

					const fd = new FormData();
					fd.append('file', file);

					const btn = input.closest('label');
					if (btn) btn.classList.add('opacity-50', 'pointer-events-none');

					try {
						const res = await fetch(`/api/posts/${postId}/upload`, {
							method: 'POST',
							body: fd,
							credentials: 'same-origin',
						});
						const data = await res.json();
						if (!res.ok) {
							alert(data.error ?? uploadFailed);
							return;
						}
						const insert = data.markdown ?? `![](${data.url})`;
						const start = textarea.selectionStart;
						const end = textarea.selectionEnd;
						const before = textarea.value.slice(0, start);
						const after = textarea.value.slice(end);
						textarea.value = `${before}\n\n${insert}\n\n${after}`;
						textarea.focus();
					} catch {
						alert(uploadNetworkError);
					} finally {
						input.value = '';
						if (btn) btn.classList.remove('opacity-50', 'pointer-events-none');
					}
				});
			</script>
		)
	}
</AppLayout>
