---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '@/components/posts/StatusBadge.astro';
import { loadAllowedSites } from '@/lib/posts';
import { getUserSites } from '@/lib/auth';
import type { PostStatus } from '@/lib/types';

const profile = Astro.locals.profile!;
const supabase = Astro.locals.supabase;
const userSites = await getUserSites(supabase, profile.id);
const allowedSites = await loadAllowedSites(supabase, profile, userSites);

const { data: posts } = await supabase
	.from('posts')
	.select('id, title, status, updated_at, sites(name)')
	.eq('author_id', profile.id)
	.order('updated_at', { ascending: false });

const submitted = Astro.url.searchParams.get('submitted') === '1';
const errorCode = Astro.url.searchParams.get('error');

const errors: Record<string, string> = {
	no_site: 'Brak przypisanej strony — poproś administratora o dostęp.',
	create_failed: 'Nie udało się utworzyć artykułu. Spróbuj ponownie.',
};
const errorMessage =
	errorCode && allowedSites.length === 0
		? errors[errorCode] ?? 'Wystąpił błąd.'
		: errorCode === 'create_failed'
			? errors.create_failed
			: null;
---

<AppLayout title="Panel redaktora" heading="Panel redaktora">
	{
		submitted && (
			<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800" role="status">
				Wpis wysłany do akceptacji administratora.
			</p>
		)
	}
	{errorMessage && (
		<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" role="alert">
			{errorMessage}
		</p>
	)}

	<section class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-6">
		<div>
			<h2 class="text-lg font-medium">Artykuły</h2>
			<p class="mt-1 text-sm text-slate-600">Twórz szkice i wysyłaj do publikacji.</p>
		</div>
		{
			allowedSites.length > 0 ? (
				<form method="post" action="/api/posts/create" class="flex flex-wrap items-end gap-2">
					{
						allowedSites.length === 1 ? (
							<input type="hidden" name="site_id" value={allowedSites[0].id} />
						) : (
							<label class="text-sm">
								<span class="text-slate-600">Strona</span>
								<select
									name="site_id"
									class="ml-2 rounded-lg border border-slate-300 px-2 py-2"
								>
									{allowedSites.map((s) => (
										<option
											value={s.id}
											selected={s.id === profile.default_site_id}
										>
											{s.name}
										</option>
									))}
								</select>
							</label>
						)
					}
					<button
						type="submit"
						class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
					>
						+ Nowy artykuł
					</button>
				</form>
			) : (
				<p class="text-sm text-slate-500">Brak strony docelowej.</p>
			)
		}
	</section>

	<section class="rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-sm font-medium uppercase tracking-wide text-slate-500">Twoje strony</h2>
		{
			allowedSites.length === 0 ? (
				<p class="mt-2 text-sm text-slate-600">Brak przypisanej strony.</p>
			) : (
				<ul class="mt-3 flex flex-wrap gap-2">
					{allowedSites.map((s) => (
						<li class="rounded-full bg-slate-100 px-3 py-1 text-sm">{s.name}</li>
					))}
				</ul>
			)
		}
	</section>

	<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-lg font-medium">Twoje wpisy</h2>
		{
			!posts?.length ? (
				<p class="mt-4 text-sm text-slate-600">Brak wpisów — utwórz pierwszy artykuł.</p>
			) : (
				<ul class="mt-4 divide-y divide-slate-100">
					{posts.map((post) => (
						<li class="flex flex-wrap items-center justify-between gap-2 py-3">
							<a
								href={`/dashboard/posts/${post.id}`}
								class="font-medium text-brand hover:underline"
							>
								{post.title || '(bez tytułu)'}
							</a>
							<div class="flex items-center gap-3 text-sm text-slate-500">
								<span>{(post.sites as { name: string } | null)?.name}</span>
								<StatusBadge status={post.status as PostStatus} />
							</div>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AppLayout>
