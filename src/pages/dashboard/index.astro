---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/ui/feedback/StatusBadge.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import PageHeader from '@/components/ui/layout/PageHeader.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import WorkflowStrip from '@/components/shared/WorkflowStrip.astro';
import { common, dashboard, postError } from '@/i18n';
import { loadAllowedSites } from '@/lib/posts';
import { getUserSites } from '@/lib/auth';
import type { PostStatus } from '@/lib/types';

const profile = Astro.locals.profile!;
const supabase = Astro.locals.supabase;
const userSites = await getUserSites(supabase, profile.id);
const allowedSites = await loadAllowedSites(supabase, profile, userSites);

const { data: posts } = await supabase
	.from('posts')
	.select('id, title, status, updated_at, sites(name)')
	.eq('author_id', profile.id)
	.order('updated_at', { ascending: false });

const submitted = Astro.url.searchParams.get('submitted') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const errorCode = Astro.url.searchParams.get('error');

const errorMessage =
	errorCode && allowedSites.length === 0
		? postError(errorCode)
		: errorCode === 'create_failed'
			? postError('create_failed')
			: null;
---

<AppLayout title={dashboard.title} heading={dashboard.title}>
	{submitted && <Alert variant="success">{dashboard.submitted}</Alert>}
	{deleted && <Alert variant="success">{dashboard.deleted}</Alert>}
	{errorMessage && <Alert variant="warning">{errorMessage}</Alert>}

	<WorkflowStrip
		ariaLabel={dashboard.workflowAria}
		steps={[
			{ label: dashboard.workflow.draft, current: true },
			{ label: dashboard.workflow.submit },
			{ label: dashboard.workflow.wait },
			{ label: dashboard.workflow.live },
		]}
	/>

	<Panel class="mb-6">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<PageHeader title={dashboard.articles.heading} lead={dashboard.articles.lead} />
			<div class="flex flex-wrap items-end gap-2">
				<Button href="/dashboard/help" variant="secondary">
					{dashboard.articles.help}
				</Button>
				{
					allowedSites.length > 0 ? (
						<form method="post" action="/api/posts/create" class="flex flex-wrap items-end gap-2">
							{
								allowedSites.length === 1 ? (
									<input type="hidden" name="site_id" value={allowedSites[0].id} />
								) : (
									<label class="ui-label-inline">
										<span class="ui-label-muted">{common.site}</span>
										<select name="site_id" class="ui-select ui-input--inline">
											{allowedSites.map((s) => (
												<option value={s.id} selected={s.id === profile.default_site_id}>
													{s.name}
												</option>
											))}
										</select>
									</label>
								)
							}
							<Button type="submit">{dashboard.articles.newPost}</Button>
						</form>
					) : (
						<p class="ui-muted">{dashboard.articles.noTargetSite}</p>
					)
				}
			</div>
		</div>
		<div class="ui-list-toolbar">
			<span class="ui-muted">{dashboard.sites.heading}:</span>
			{
				allowedSites.length === 0 ? (
					<span class="ui-muted">{dashboard.sites.empty}</span>
				) : (
					allowedSites.map((s) => <span class="ui-tag">{s.name}</span>)
				)
			}
		</div>
	</Panel>

	<Panel>
		<h2 class="ui-heading">{dashboard.posts.heading}</h2>
		{
			!posts?.length ? (
				<p class="ui-empty mt-4">{dashboard.posts.empty}</p>
			) : (
				<ul class="ui-list-divide mt-4">
					{posts.map((post) => (
						<li class="flex flex-wrap items-center justify-between gap-2 py-3">
							<a href={`/dashboard/posts/${post.id}`} class="ui-link">
								{post.title || common.untitled}
							</a>
							<div class="ui-muted flex items-center gap-3">
								<span>{(post.sites as { name: string } | null)?.name}</span>
								<StatusBadge status={post.status as PostStatus} />
							</div>
						</li>
					))}
				</ul>
			)
		}
	</Panel>
</AppLayout>
