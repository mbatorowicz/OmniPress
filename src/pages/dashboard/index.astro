---
import AppLayout from '../../layouts/AppLayout.astro';
import { getUserSites } from '../../lib/auth';

const profile = Astro.locals.profile!;
const supabase = Astro.locals.supabase;
const sites = await getUserSites(supabase, profile.id);

const { data: drafts } = await supabase
	.from('posts')
	.select('id, title, status, updated_at, sites(name)')
	.eq('author_id', profile.id)
	.order('updated_at', { ascending: false })
	.limit(10);
---

<AppLayout title="Panel redaktora" heading="Panel redaktora">
	<section class="mb-8 rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-sm font-medium uppercase tracking-wide text-slate-500">Twoje strony</h2>
		{
			sites.length === 0 ? (
				<p class="mt-2 text-sm text-slate-600">
					Brak przypisanej strony. Administrator musi dodać Cię do{' '}
					<code class="text-xs">user_sites</code> lub ustawić{' '}
					<code class="text-xs">default_site_id</code>.
				</p>
			) : (
				<ul class="mt-3 flex flex-wrap gap-2">
					{sites.map((row) => {
						const site = row.sites as { name: string; slug: string } | null;
						return site ? (
							<li class="rounded-full bg-slate-100 px-3 py-1 text-sm">{site.name}</li>
						) : null;
					})}
				</ul>
			)
		}
		<p class="mt-4 text-sm text-slate-500">
			Nowe artykuły automatycznie trafiają na przypisaną stronę (Faza 2: edytor i szkice).
		</p>
	</section>

	<section class="rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-lg font-medium">Ostatnie szkice</h2>
		{
			!drafts?.length ? (
				<p class="mt-2 text-sm text-slate-600">Brak szkiców — edytor pojawi się w Fazie 2.</p>
			) : (
				<ul class="mt-4 divide-y divide-slate-100">
					{drafts.map((post) => (
						<li class="flex justify-between py-3 text-sm">
							<span>{post.title || '(bez tytułu)'}</span>
							<span class="text-slate-500">{post.status}</span>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AppLayout>
