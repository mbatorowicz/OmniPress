---
import AppLayout from '@/layouts/AppLayout.astro';
import UsageOverview from '@/components/admin/usage/UsageOverview.astro';
import { adminUsage, layout } from '@/i18n';
import { loadUsageStats } from '@/lib/admin/usage';

const stats = await loadUsageStats(Astro.locals.supabase);
const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: layout.breadcrumb.usage },
];
---

<AppLayout title={adminUsage.title} heading={adminUsage.title} {breadcrumbs}>
	<p class="mb-6 ui-muted">{adminUsage.lead}</p>
	<UsageOverview {stats} />
</AppLayout>
