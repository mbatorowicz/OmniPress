---
import AppLayout from '@/layouts/AppLayout.astro';
import { admin, adminDestinations } from '@/i18n';
import { listDestinations } from '@/lib/admin';

const destinations = await listDestinations(Astro.locals.supabase);
const deleted = Astro.url.searchParams.get('deleted') === '1';
---

<AppLayout title={adminDestinations.title} heading={adminDestinations.title}>
	<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
		<a href="/admin" class="text-sm text-brand hover:underline">{admin.preview.back}</a>
		<a href="/admin/destinations/new" class="rounded-lg bg-brand px-4 py-2 text-sm text-white">
			{adminDestinations.newDestination}
		</a>
	</div>

	{deleted && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{adminDestinations.deleted}</p>
	)}

	<ul class="divide-y divide-slate-100 rounded-xl border bg-white">
		{
			destinations.map((d) => (
				<li class="flex justify-between px-4 py-3 text-sm">
					<a href={`/admin/destinations/${d.id}`} class="font-medium text-brand hover:underline">
						{d.name}
					</a>
					<span class="text-slate-500">{adminDestinations.types[d.type]}</span>
				</li>
			))
		}
	</ul>
</AppLayout>
