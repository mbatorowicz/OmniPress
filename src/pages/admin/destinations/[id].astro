---
import { getSiteIdByDestinationId } from '@/lib/admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sites');

const siteId = await getSiteIdByDestinationId(Astro.locals.supabase, id);
if (siteId) return Astro.redirect(`/admin/units/${siteId}`);

return Astro.redirect('/admin/sites');
---
