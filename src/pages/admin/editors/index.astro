---
import AppLayout from '@/layouts/AppLayout.astro';
import Alert from '@/components/ui/Alert.astro';
import Button from '@/components/ui/Button.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Panel from '@/components/ui/Panel.astro';
import { admin, adminEditors } from '@/i18n';
import { listEditors, listSites } from '@/lib/admin';

const editors = await listEditors(Astro.locals.supabase);
const sites = await listSites(Astro.locals.supabase);

const errorCode = Astro.url.searchParams.get('error');
const editorErrors = adminEditors.errors;
const errorMessage =
	errorCode && errorCode in editorErrors
		? editorErrors[errorCode as keyof typeof editorErrors]
		: null;
---

<AppLayout title={adminEditors.title} heading={adminEditors.title}>
	<a href="/admin" class="mb-4 inline-block text-sm ui-link">{admin.preview.back}</a>
	<p class="mb-4 ui-muted">{adminEditors.lead}</p>

	{errorMessage && <Alert variant="error">{errorMessage}</Alert>}

	<Panel class="mb-8">
		<PageHeader title={adminEditors.invite.heading} lead={adminEditors.invite.lead} />
		<form method="post" action="/api/admin/editors/create" class="mt-4 max-w-lg space-y-4">
			<label class="ui-label">
				<span class="font-medium">{adminEditors.invite.email}</span>
				<input name="email" type="email" required class="ui-input" />
			</label>
			<label class="ui-label">
				<span>{adminEditors.invite.displayName}</span>
				<input name="display_name" class="ui-input" />
			</label>
			<label class="ui-label">
				<span class="font-medium">{adminEditors.invite.password}</span>
				<input
					name="password"
					type="password"
					required
					minlength={8}
					autocomplete="new-password"
					class="ui-input"
				/>
			</label>
			{
				sites.length > 0 ? (
					<fieldset class="text-sm">
						<legend class="mb-2 font-medium">{adminEditors.invite.sites}</legend>
						<ul class="space-y-2">
							{sites.map((s) => (
								<li>
									<label class="flex items-center gap-2">
										<input type="checkbox" name="site_ids" value={s.id} class="ui-checkbox" />
										{s.name}
									</label>
								</li>
							))}
						</ul>
					</fieldset>
				) : (
					<p class="text-sm text-amber-800">Najpierw utwórz jednostkę organizacyjną (stronę).</p>
				)
			}
			{
				sites.length > 0 && (
					<label class="ui-label">
						<span>{adminEditors.invite.defaultSite}</span>
						<select name="default_site_id" class="ui-input ui-select">
							<option value="">— pierwsza zaznaczona —</option>
							{sites.map((s) => (
								<option value={s.id}>{s.name}</option>
							))}
						</select>
					</label>
				)
			}
			<Button type="submit">{adminEditors.invite.submit}</Button>
		</form>
	</Panel>

	<Panel>
		<h2 class="ui-heading">Konta redaktorów</h2>
		{
			editors.length === 0 ? (
				<p class="ui-empty">Brak redaktorów — utwórz konto powyżej.</p>
			) : (
				<ul class="ui-list-divide mt-4">
					{editors.map((e) => (
						<li class="py-3 text-sm">
							<a href={`/admin/editors/${e.id}`} class="ui-link">
								{e.display_name || e.id.slice(0, 8)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</Panel>
</AppLayout>
