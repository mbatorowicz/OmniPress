---
import AppLayout from '@/layouts/AppLayout.astro';
import { admin, adminEditors } from '@/i18n';
import { listEditors } from '@/lib/admin';

const editors = await listEditors(Astro.locals.supabase);
---

<AppLayout title={adminEditors.title} heading={adminEditors.title}>
	<a href="/admin" class="mb-4 inline-block text-sm text-brand hover:underline">{admin.preview.back}</a>
	<p class="mb-4 text-sm text-slate-600">{adminEditors.lead}</p>

	<ul class="divide-y divide-slate-100 rounded-xl border bg-white">
		{
			editors.map((e) => (
				<li class="px-4 py-3 text-sm">
					<a href={`/admin/editors/${e.id}`} class="font-medium text-brand hover:underline">
						{e.display_name || e.id.slice(0, 8)}
					</a>
				</li>
			))
		}
	</ul>
</AppLayout>
