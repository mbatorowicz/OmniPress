---
import AppLayout from '@/layouts/AppLayout.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import { adminEditors, common, layout } from '@/i18n';
import { getEditorSiteIds, listEditors, listSites } from '@/lib/admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/editors');

const editors = await listEditors(Astro.locals.supabase);
const editor = editors.find((e) => e.id === id);
if (!editor) return Astro.redirect('/admin/editors');

const sites = await listSites(Astro.locals.supabase);
const assigned = new Set(await getEditorSiteIds(Astro.locals.supabase, id));
const saved = Astro.url.searchParams.get('saved') === '1';

const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: layout.breadcrumb.editors, href: '/admin/editors' },
	{ label: editor.display_name || editor.id.slice(0, 8) },
];
---

<AppLayout
	title={adminEditors.title}
	heading={editor.display_name || adminEditors.title}
	{breadcrumbs}
>
	{saved && <Alert variant="success">{common.saved}</Alert>}

	<Panel class="space-y-4">
		<form method="post" action={`/api/admin/editors/${id}/sites`} class="space-y-4">
			<fieldset>
				<legend class="mb-2 text-sm font-medium">{adminEditors.fields.sites}</legend>
				{
					sites.map((s) => (
						<label class="flex items-center gap-2 py-1 text-sm">
							<input type="checkbox" name="site_id" value={s.id} checked={assigned.has(s.id)} class="ui-checkbox" />
							{s.name}
						</label>
					))
				}
			</fieldset>
			<label class="ui-label">
				<span class="font-medium">{adminEditors.fields.defaultSite}</span>
				<select name="default_site_id" class="ui-input ui-select max-w-xs">
					<option value="">—</option>
					{
						sites.map((s) => (
							<option value={s.id} selected={editor.default_site_id === s.id}>
								{s.name}
							</option>
						))
					}
				</select>
			</label>
			<Button type="submit">{adminEditors.actions.save}</Button>
		</form>
	</Panel>
</AppLayout>
