---
import AppLayout from '@/layouts/AppLayout.astro';
import { adminEditors } from '@/i18n';
import { getEditorSiteIds, listEditors, listSites } from '@/lib/admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/editors');

const editors = await listEditors(Astro.locals.supabase);
const editor = editors.find((e) => e.id === id);
if (!editor) return Astro.redirect('/admin/editors');

const sites = await listSites(Astro.locals.supabase);
const assigned = new Set(await getEditorSiteIds(Astro.locals.supabase, id));
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AppLayout title={adminEditors.title} heading={editor.display_name || adminEditors.title}>
	<a href="/admin/editors" class="mb-4 inline-block text-sm text-brand hover:underline">← {adminEditors.title}</a>
	{saved && <p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">Zapisano.</p>}

	<form method="post" action={`/api/admin/editors/${id}/sites`} class="space-y-4 rounded-xl border bg-white p-6">
		<fieldset>
			<legend class="mb-2 text-sm font-medium">{adminEditors.fields.sites}</legend>
			{
				sites.map((s) => (
					<label class="flex items-center gap-2 py-1 text-sm">
						<input type="checkbox" name="site_id" value={s.id} checked={assigned.has(s.id)} />
						{s.name}
					</label>
				))
			}
		</fieldset>
		<label class="block text-sm">
			<span class="font-medium">{adminEditors.fields.defaultSite}</span>
			<select name="default_site_id" class="mt-1 w-full max-w-xs rounded-lg border px-3 py-2">
				<option value="">—</option>
				{
					sites.map((s) => (
						<option value={s.id} selected={editor.default_site_id === s.id}>
							{s.name}
						</option>
					))
				}
			</select>
		</label>
		<button type="submit" class="rounded-lg bg-brand px-4 py-2 text-sm text-white">{adminEditors.actions.save}</button>
	</form>
</AppLayout>
