---
import AppLayout from '../../layouts/AppLayout.astro';
import AdminPostsTable from '@/components/admin/AdminPostsTable.astro';
import { admin, adminSites, common } from '@/i18n';
import { listSites } from '@/lib/admin';

const supabase = Astro.locals.supabase;
const sites = await listSites(supabase);

const postSelect =
	'id, title, status, category_name, category_slug, created_at, updated_at, sites(name)';

const { data: pending } = await supabase
	.from('posts')
	.select(postSelect)
	.eq('status', 'pending')
	.order('created_at', { ascending: false });

const { data: publishing } = await supabase
	.from('posts')
	.select(postSelect)
	.eq('status', 'publishing')
	.order('created_at', { ascending: false });

const { data: published } = await supabase
	.from('posts')
	.select(postSelect)
	.eq('status', 'published')
	.order('updated_at', { ascending: false })
	.limit(30);

const listLabels = admin.postList;
const deactivated = Astro.url.searchParams.get('deactivated') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const bulkDeactivated = Number(Astro.url.searchParams.get('bulk_deactivated') ?? '0');
const bulkDeleted = Number(Astro.url.searchParams.get('bulk_deleted') ?? '0');
const bulkSkipped = Number(Astro.url.searchParams.get('bulk_skipped') ?? '0');
const remoteWarning = Astro.url.searchParams.get('remote_warning') === '1';
const importImported = Number(Astro.url.searchParams.get('imported') ?? '0');
const importUpdated = Number(Astro.url.searchParams.get('updated') ?? '0');
const importWarnings = Number(Astro.url.searchParams.get('import_warnings') ?? '0');
const importErrorCode = Astro.url.searchParams.get('import_error');
const importSiteId = Astro.url.searchParams.get('site_id');
const importLabels = admin.importPosts;
const importErrorMessage =
	importErrorCode && importErrorCode in importLabels.errors
		? importLabels.errors[importErrorCode]!
		: importErrorCode
			? importErrorCode
			: null;
const errorCode = Astro.url.searchParams.get('error');
const remoteDetail = Astro.url.searchParams.get('remote_detail');
const bulkErrors: Record<string, string> = {
	none_selected: listLabels.noneSelected,
	none_published: 'Żaden z zaznaczonych wpisów nie jest opublikowany.',
	invalid_action: listLabels.invalidAction,
	not_found: 'Nie znaleziono wpisów.',
	remote_failed: listLabels.remoteFailed,
};
const errorMessage = errorCode && errorCode in bulkErrors ? bulkErrors[errorCode] : null;
const defaultImportSiteId =
	importSiteId && sites.some((s) => s.id === importSiteId) ? importSiteId : (sites[0]?.id ?? '');
---

<AppLayout title={admin.title} heading={admin.title}>
	<nav class="mb-8 flex flex-wrap gap-3 text-sm">
		<a href="/admin/units/new" class="rounded-lg border border-brand bg-brand/5 px-4 py-2 font-medium text-brand hover:bg-brand/10">
			{adminSites.wizardLink}
		</a>
		<a href="/admin/sites" class="rounded-lg border border-slate-200 bg-white px-4 py-2 hover:border-brand">
			{admin.sites.manage}
		</a>
		<a href="/admin/editors" class="rounded-lg border border-slate-200 bg-white px-4 py-2 hover:border-brand">
			{admin.editors.manage}
		</a>
	</nav>

	{deactivated && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{listLabels.deactivated}</p>
	)}
	{deleted && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{listLabels.deleted}</p>
	)}
	{bulkDeactivated > 0 && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">
			{listLabels.bulkDeactivated(bulkDeactivated)}
		</p>
	)}
	{bulkDeleted > 0 && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">
			{listLabels.bulkDeleted(bulkDeleted)}
		</p>
	)}
	{bulkSkipped > 0 && (
		<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
			{listLabels.bulkSkipped(bulkSkipped)}
		</p>
	)}
	{errorMessage && (
		<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">
			{errorMessage}
			{remoteDetail && errorCode === 'remote_failed' && (
				<span class="mt-1 block font-mono text-xs">{remoteDetail}</span>
			)}
		</p>
	)}
	{remoteWarning && (
		<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
			{listLabels.remoteWarning}
			{remoteDetail && <span class="mt-1 block font-mono text-xs">{remoteDetail}</span>}
		</p>
	)}
	{importImported + importUpdated > 0 && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">
			{importLabels.success(importImported, importUpdated)}
		</p>
	)}
	{importWarnings > 0 && (
		<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
			{importLabels.warnings(importWarnings)}
		</p>
	)}
	{importErrorMessage && (
		<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{importErrorMessage}</p>
	)}

	<section class="mb-8 rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-lg font-medium text-slate-900">{importLabels.heading}</h2>
		<p class="mt-1 text-sm text-slate-600">{importLabels.lead}</p>
		{
			sites.length === 0 ? (
				<p class="mt-4 text-sm text-slate-500">{admin.sites.empty} {admin.sites.exampleName}.</p>
			) : (
				<form
					method="post"
					action={`/api/admin/sites/${defaultImportSiteId}/posts/import`}
					class="mt-4 flex flex-wrap items-end gap-3"
					id="import-posts-form"
				>
					{
						sites.length > 1 ? (
							<label class="text-sm">
								<span class="text-slate-600">{importLabels.siteLabel}</span>
								<select
									name="site_id_display"
									class="ml-2 rounded-lg border border-slate-300 px-2 py-2"
									id="import-site-select"
								>
									{sites.map((s) => (
										<option value={s.id} selected={s.id === importSiteId}>
											{s.name}
										</option>
									))}
								</select>
							</label>
						) : (
							<input type="hidden" name="site_id_display" value={sites[0]!.id} />
						)
					}
					<button
						type="submit"
						class="rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
					>
						{importLabels.button}
					</button>
				</form>
			)
		}
	</section>

	<section class="mb-8 rounded-xl border border-brand/20 bg-brand/5 p-6">
		<h2 class="text-lg font-medium text-slate-900">{admin.content.heading}</h2>
		<p class="mt-1 text-sm text-slate-600">{admin.content.lead}</p>
		<a
			href="/dashboard"
			class="mt-4 inline-block rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white hover:bg-brand-dark"
		>
			{admin.content.openDashboard}
		</a>
	</section>

	{sites.length > 1 && (
		<script is:inline>
			(() => {
				const form = document.getElementById('import-posts-form');
				const select = document.getElementById('import-site-select');
				if (!form || !select) return;
				select.addEventListener('change', () => {
					form.action = `/api/admin/sites/${select.value}/posts/import`;
				});
			})();
		</script>
	)}

	<section class="rounded-xl border border-slate-200 bg-white p-6">
			<h2 class="text-lg font-medium">{admin.sites.heading(sites.length)}</h2>
			<p class="mt-1 text-sm text-slate-500">{admin.sites.lead}</p>
			<ul class="mt-4 space-y-2 text-sm">
				{
					sites.slice(0, 5).map((s) => (
						<li>
							<a href={`/admin/units/${s.id}`} class="text-brand hover:underline">
								{s.name}
							</a>
						</li>
					))
				}
			</ul>
		</section>

	<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-lg font-medium">{admin.pending.heading(pending?.length ?? 0)}</h2>
		{
			!pending?.length ? (
				<p class="mt-2 text-sm text-slate-600">{admin.pending.empty}</p>
			) : (
				<AdminPostsTable posts={pending} labels={listLabels} dateField="created_at" />
			)
		}
	</section>

	<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-lg font-medium">{admin.publishing.heading(publishing?.length ?? 0)}</h2>
		{
			!publishing?.length ? (
				<p class="mt-2 text-sm text-slate-600">{admin.publishing.empty}</p>
			) : (
				<AdminPostsTable posts={publishing} labels={listLabels} dateField="created_at" />
			)
		}
	</section>

	<section class="mt-6 rounded-xl border border-sky-100 bg-sky-50/30 p-6">
		<h2 class="text-lg font-medium">{admin.published.heading(published?.length ?? 0)}</h2>
		<p class="mt-1 text-sm text-slate-600">{admin.published.lead}</p>
		{
			!published?.length ? (
				<p class="mt-2 text-sm text-slate-600">{admin.published.empty}</p>
			) : (
				<AdminPostsTable posts={published} labels={listLabels} showBulkActions />
			)
		}
	</section>
</AppLayout>
