---
import AppLayout from '../../layouts/AppLayout.astro';

const supabase = Astro.locals.supabase;

const { data: sites } = await supabase.from('sites').select('id, name, slug, is_active').order('name');

const { data: destinations } = await supabase
	.from('destinations')
	.select('id, name, type, is_active')
	.order('name');

const { data: pending } = await supabase
	.from('posts')
	.select('id, title, status, created_at, sites(name)')
	.eq('status', 'pending')
	.order('created_at', { ascending: false });
---

<AppLayout title="Administracja" heading="Administracja">
	<div class="grid gap-6 lg:grid-cols-2">
		<section class="rounded-xl border border-slate-200 bg-white p-6">
			<h2 class="text-lg font-medium">Strony ({sites?.length ?? 0})</h2>
			<p class="mt-1 text-sm text-slate-500">
				Jednostki organizacyjne — redaktorzy publikują w ramach przypisanej strony.
			</p>
			{
				!sites?.length ? (
					<p class="mt-4 text-sm text-slate-600">
						Dodaj stronę w Supabase, np. <code>UG Miedzna</code> / slug{' '}
						<code>ug-miedzna</code>.
					</p>
				) : (
					<ul class="mt-4 space-y-2 text-sm">
						{sites.map((s) => (
							<li class="flex justify-between rounded-lg bg-slate-50 px-3 py-2">
								<span>{s.name}</span>
								<span class="text-slate-500">{s.slug}</span>
							</li>
						))}
					</ul>
				)
			}
		</section>

		<section class="rounded-xl border border-slate-200 bg-white p-6">
			<h2 class="text-lg font-medium">Destynacje ({destinations?.length ?? 0})</h2>
			<p class="mt-1 text-sm text-slate-500">WordPress, GitHub/Astro — konfiguracja w Fazie 3.</p>
			{
				!destinations?.length ? (
					<p class="mt-4 text-sm text-slate-600">Brak destynacji. Dodaj WP gminy i repo Astro.</p>
				) : (
					<ul class="mt-4 space-y-2 text-sm">
						{destinations.map((d) => (
							<li class="flex justify-between rounded-lg bg-slate-50 px-3 py-2">
								<span>{d.name}</span>
								<span class="text-slate-500">{d.type}</span>
							</li>
						))}
					</ul>
				)
			}
		</section>
	</div>

	<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-lg font-medium">Do akceptacji ({pending?.length ?? 0})</h2>
		{
			!pending?.length ? (
				<p class="mt-2 text-sm text-slate-600">Brak wpisów oczekujących.</p>
			) : (
				<ul class="mt-4 divide-y divide-slate-100 text-sm">
					{pending.map((p) => (
						<li class="py-3">
							<span class="font-medium">{p.title || '(bez tytułu)'}</span>
							<span class="ml-2 text-slate-500">
								— {(p.sites as { name: string } | null)?.name}
							</span>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AppLayout>
