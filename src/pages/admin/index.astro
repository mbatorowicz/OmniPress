---
import AppLayout from '@/layouts/AppLayout.astro';
import AdminQueueHub from '@/components/admin/queue/AdminQueueHub.astro';
import { admin } from '@/i18n';
import { parseAdminHubFlash } from '@/lib/admin/hub-flash';
import { loadAdminQueueHub } from '@/lib/admin/queue-hub';
import { schedulePublishWorker } from '@/lib/publish/trigger-worker';

schedulePublishWorker();

const importSiteId = Astro.url.searchParams.get('site_id');
const { sites, pending, scheduled, published, defaultImportSiteId } = await loadAdminQueueHub(
	Astro.locals.supabase,
	importSiteId,
);
const flashMessages = parseAdminHubFlash(Astro.url);
---

<AppLayout title={admin.title} heading={admin.queueHeading}>
	<AdminQueueHub
		{sites}
		{pending}
		{scheduled}
		{published}
		{flashMessages}
		{defaultImportSiteId}
		{importSiteId}
	/>
</AppLayout>
