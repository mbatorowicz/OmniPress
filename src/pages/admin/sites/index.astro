---
import AppLayout from '@/layouts/AppLayout.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import { adminSites, layout } from '@/i18n';
import { listSites } from '@/lib/admin';

const sites = await listSites(Astro.locals.supabase);
const deleted = Astro.url.searchParams.get('deleted') === '1';

const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: layout.breadcrumb.units },
];
---

<AppLayout title={adminSites.title} heading={adminSites.title} {breadcrumbs}>
	<p class="mb-6 ui-muted">{adminSites.lead}</p>

	{deleted && <Alert variant="success">{adminSites.deleted}</Alert>}

	{sites.length === 0 && <p class="ui-empty mb-4">{adminSites.empty}</p>}

	<div class="ui-tile-grid">
		{
			sites.map((s) => (
				<a href={`/admin/units/${s.id}`} class="ui-tile">
					<span class="ui-tile-title">{s.name}</span>
					<span class="ui-muted font-mono">{s.slug}</span>
					{!s.is_active && <span class="ui-tag self-start text-xs">{adminSites.fields.inactive}</span>}
				</a>
			))
		}
		<a href="/admin/units/new" class="ui-tile ui-tile--add">
			<span class="ui-tile-title text-brand">{adminSites.addTile}</span>
		</a>
	</div>
</AppLayout>
