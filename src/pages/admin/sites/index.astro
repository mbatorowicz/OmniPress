---
import AppLayout from '@/layouts/AppLayout.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import { adminSites, adminUnit, layout } from '@/i18n';
import { listSites } from '@/lib/admin';

const sites = await listSites(Astro.locals.supabase);
const deleted = Astro.url.searchParams.get('deleted') === '1';

const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: layout.breadcrumb.units },
];
---

<AppLayout title={adminSites.title} heading={adminSites.title} {breadcrumbs}>
	<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
		<p class="text-sm text-slate-600">{adminSites.lead}</p>
		<Button href="/admin/units/new">{adminSites.wizardLink}</Button>
	</div>

	{deleted && <Alert variant="success">{adminSites.deleted}</Alert>}

	<Panel>
		{
			sites.length === 0 ? (
				<p class="ui-empty">{adminSites.empty}</p>
			) : (
				<ul class="ui-list-divide">
					{sites.map((s) => (
						<li class="flex flex-wrap items-center justify-between gap-2 py-3 text-sm">
							<div>
								<a href={`/admin/units/${s.id}`} class="ui-link font-medium">
									{s.name}
								</a>
								<span class="ml-2 text-slate-500">{s.slug}</span>
								{!s.is_active && (
									<span class="ml-2 rounded bg-slate-100 px-2 py-0.5 text-xs">
										{adminSites.fields.inactive}
									</span>
								)}
							</div>
							<Button href={`/admin/units/${s.id}`} variant="secondary">
								{adminUnit.actions.edit}
							</Button>
						</li>
					))}
				</ul>
			)
		}
	</Panel>
</AppLayout>
