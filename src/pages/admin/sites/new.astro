---
import AppLayout from '@/layouts/AppLayout.astro';
import { adminSites } from '@/i18n';
import { canEncryptCredentials } from '@/lib/crypto';

const error = Astro.url.searchParams.get('error');
---

<AppLayout title={adminSites.newSite} heading={adminSites.newSite}>
	<a href="/admin/sites" class="mb-4 inline-block text-sm text-brand hover:underline">
		← {adminSites.title}
	</a>

	{
		error === 'invalid_slug' && (
			<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{adminSites.errors.invalid_slug}</p>
		)
	}
	{
		error === 'save_failed' && (
			<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{adminSites.errors.save_failed}</p>
		)
	}

	<form method="post" action="/api/admin/sites/create" class="max-w-md space-y-4 rounded-xl border bg-white p-6">
		<label class="block text-sm">
			<span class="font-medium">{adminSites.fields.name}</span>
			<input name="name" required class="mt-1 w-full rounded-lg border px-3 py-2" />
		</label>
		<label class="block text-sm">
			<span class="font-medium">{adminSites.fields.slug}</span>
			<input name="slug" placeholder="ug-miedzna" class="mt-1 w-full rounded-lg border px-3 py-2 font-mono" />
		</label>
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="is_active" checked />
			{adminSites.fields.active}
		</label>
		<button type="submit" class="rounded-lg bg-brand px-4 py-2 text-sm text-white">{adminSites.actions.create}</button>
	</form>
</AppLayout>
