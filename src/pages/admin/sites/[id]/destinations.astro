---
import AppLayout from '@/layouts/AppLayout.astro';
import { adminSites, common } from '@/i18n';
import { getSiteById, getSiteDestinations, listDestinations } from '@/lib/admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sites');

const site = await getSiteById(Astro.locals.supabase, id);
if (!site) return Astro.redirect('/admin/sites');

const allDestinations = await listDestinations(Astro.locals.supabase);
const linked = await getSiteDestinations(Astro.locals.supabase, id);
const linkedIds = new Set(linked.map((l) => l.destination_id));
const defaultId = linked.find((l) => l.is_default)?.destination_id ?? '';

const saved = Astro.url.searchParams.get('saved') === '1';
---

<AppLayout title={adminSites.destinations.title} heading={`${adminSites.destinations.title}: ${site.name}`}>
	<a href={`/admin/sites/${site.id}`} class="mb-4 inline-block text-sm text-brand hover:underline">← {site.name}</a>
	{saved && <p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{common.saved}</p>}

	<p class="mb-4 text-sm text-slate-600">{adminSites.destinations.lead}</p>

	<form method="post" action={`/api/admin/sites/${site.id}/destinations`} class="space-y-3 rounded-xl border bg-white p-6">
		{
			allDestinations.map((d) => (
				<label class="flex flex-wrap items-center gap-3 rounded-lg bg-slate-50 px-3 py-2 text-sm">
					<input type="checkbox" name="destination_id" value={d.id} checked={linkedIds.has(d.id)} />
					<span class="font-medium">{d.name}</span>
					<span class="text-slate-500">{d.type}</span>
					<span class="ml-auto flex items-center gap-1 text-xs">
						<input
							type="radio"
							name="default_destination_id"
							value={d.id}
							checked={defaultId === d.id}
						/>
						{adminSites.destinations.default}
					</span>
				</label>
			))
		}
		<button type="submit" class="rounded-lg bg-brand px-4 py-2 text-sm text-white">
			{adminSites.destinations.save}
		</button>
	</form>
</AppLayout>
