---
import AppLayout from '@/layouts/AppLayout.astro';
import UnitForm from '@/components/admin/UnitForm.astro';
import { adminSites, adminUnit } from '@/i18n';

const errorCode = Astro.url.searchParams.get('error');
const unitErrors = adminUnit.errors;
const errorMessage =
	errorCode && errorCode in unitErrors ? unitErrors[errorCode as keyof typeof unitErrors] : null;
---

<AppLayout title={adminUnit.title} heading={adminUnit.title}>
	<a href="/admin/sites" class="mb-4 inline-block text-sm text-brand hover:underline">
		← {adminSites.title}
	</a>
	<p class="mb-4 text-sm text-slate-600">{adminUnit.lead}</p>

	<UnitForm
		action="/api/admin/units/create"
		submitLabel={adminUnit.actions.create}
		errorMessage={errorMessage}
	/>
</AppLayout>
