---
import AppLayout from '@/layouts/AppLayout.astro';
import UnitForm from '@/components/admin/UnitForm.astro';
import { adminUnit, layout } from '@/i18n';

const errorCode = Astro.url.searchParams.get('error');
const unitErrors = adminUnit.errors;
const errorMessage =
	errorCode && errorCode in unitErrors ? unitErrors[errorCode as keyof typeof unitErrors] : null;

const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: layout.breadcrumb.units, href: '/admin/sites' },
	{ label: layout.breadcrumb.unitNew },
];
---

<AppLayout title={adminUnit.title} heading={adminUnit.title} {breadcrumbs}>
	<p class="ui-muted mb-4">{adminUnit.lead}</p>

	<UnitForm
		action="/api/admin/units/create"
		submitLabel={adminUnit.actions.create}
		errorMessage={errorMessage}
	/>
</AppLayout>
