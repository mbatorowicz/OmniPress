---
import AppLayout from '@/layouts/AppLayout.astro';
import UnitForm from '@/components/admin/UnitForm.astro';
import AdminContextNav from '@/components/shell/AdminContextNav.astro';
import FlashAlerts from '@/components/shared/FlashAlerts.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import Button from '@/components/ui/actions/Button.astro';
import { adminUnit, adminSites, common } from '@/i18n';
import { countSitePosts, loadUnitFormInitial } from '@/lib/admin';
import { parseQueryFlash } from '@/lib/ui/flash';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sites');

const initial = await loadUnitFormInitial(Astro.locals.supabase, id);
if (!initial) return Astro.redirect('/admin/sites');

const postCount = await countSitePosts(Astro.locals.supabase, id);
const unitErrors = { ...adminUnit.errors, ...adminSites.errors };
const flashMessages = parseQueryFlash(Astro.url, {
	saved: common.saved,
	errorMap: unitErrors as Record<string, string>,
});
---

<AppLayout title={initial.name} heading={adminUnit.editTitle}>
	<AdminContextNav siteId={id} siteName={initial.name} section="edit" />
	<FlashAlerts messages={flashMessages} />
	<p class="mb-4 ui-muted">{adminUnit.editLead}</p>

	<UnitForm
		action={`/api/admin/units/${id}/save`}
		submitLabel={adminUnit.actions.save}
		{initial}
		errorMessage={flashMessages.find((m) => m.variant === 'error')?.message ?? null}
	/>

	<Panel variant="danger" class="mt-8 max-w-2xl">
		<h3 class="text-sm font-medium text-red-900">{adminSites.delete.heading}</h3>
		<p class="mt-1 text-sm text-red-800">{adminSites.delete.lead}</p>
		{
			postCount > 0 && (
				<p class="mt-2 text-sm font-medium text-red-900">
					{adminSites.errors.has_posts} {adminSites.delete.postsCount(postCount)}
				</p>
			)
		}
		<form method="post" action={`/api/admin/sites/${id}/delete`} class="mt-4 space-y-3">
			<label class="flex items-start gap-2 text-sm text-red-900">
				<input type="checkbox" name="confirm" class="ui-checkbox mt-1" disabled={postCount > 0} />
				{adminSites.delete.confirm}
			</label>
			<Button type="submit" variant="danger" disabled={postCount > 0}>
				{adminSites.actions.delete}
			</Button>
		</form>
	</Panel>
</AppLayout>
