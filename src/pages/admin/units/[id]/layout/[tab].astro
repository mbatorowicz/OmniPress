---
import LayoutEditorShell from '@/components/admin/layout/LayoutEditorShell.astro';
import LayoutZoneForm from '@/components/admin/layout/LayoutZoneForm.astro';
import LayoutAdvancedSlotsSection from '@/components/admin/layout/LayoutAdvancedSlotsSection.astro';
import LayoutHeaderTabContent from '@/components/admin/layout/LayoutHeaderTabContent.astro';
import { loadLayoutEditorContext } from '@/lib/admin/layout-editor-context';
import {
	isLayoutEditorTab,
	layoutTabHref,
	tabToLayoutZone,
	type LayoutEditorTab,
} from '@/lib/admin/layout-editor-tabs';

const { id, tab } = Astro.params;
if (!id) return Astro.redirect('/admin/sites');

if (tab === 'menu') return Astro.redirect(layoutTabHref(id, 'header'), 301);
if (tab === 'categories') return Astro.redirect(`/admin/units/${id}/posts`, 301);
if (tab === 'topbar') return Astro.redirect(layoutTabHref(id, 'header'), 301);

if (!tab || !isLayoutEditorTab(tab)) {
	return Astro.redirect(layoutTabHref(id, 'header'));
}

const activeTab = tab as LayoutEditorTab;

let ctx;
try {
	ctx = await loadLayoutEditorContext(Astro.locals.supabase, id, {
		draftStatusScope: 'navigation',
	});
} catch {
	return Astro.redirect(layoutTabHref(id, activeTab) + '?error=layout_context_failed');
}
if (!ctx) return Astro.redirect('/admin/sites');

const zone = tabToLayoutZone(activeTab);
---

<LayoutEditorShell siteId={id} {ctx} {activeTab}>
	{
		activeTab === 'header' ? (
			<LayoutHeaderTabContent siteId={id} {ctx} />
		) : zone ? (
			<>
				<LayoutZoneForm
					siteId={id}
					returnTab={activeTab}
					{zone}
					layout={ctx.layout}
					categories={ctx.layout.categories}
					categoryDisplays={ctx.layout.categoryDisplays}
					publishedPages={ctx.publishedPages}
				/>
				{activeTab === 'home' ? (
					<LayoutAdvancedSlotsSection
						siteId={id}
						returnTab="home"
						zone="home"
						layout={ctx.layout}
						categories={ctx.layout.categories}
						categoryDisplays={ctx.layout.categoryDisplays}
						publishedPages={ctx.publishedPages}
					/>
				) : null}
			</>
		) : null
	}
</LayoutEditorShell>
