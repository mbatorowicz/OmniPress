---
import AppLayout from '@/layouts/AppLayout.astro';
import AdminContextNav from '@/components/shell/AdminContextNav.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import { adminSitePages } from '@/i18n';
import { listSitePages } from '@/lib/site-pages';
import { buildSitePagePublicPath } from '@/lib/site-pages/url';
import type { PageStatus } from '@/lib/types';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

const { data: site } = await Astro.locals.supabase
	.from('sites')
	.select('id, name')
	.eq('id', id)
	.maybeSingle();
if (!site) return Astro.redirect('/admin/sites');

const pages = await listSitePages(Astro.locals.supabase, id);
const ui = adminSitePages;
const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
	errorCode && errorCode in ui.errors
		? ui.errors[errorCode as keyof typeof ui.errors]
		: null;
const deleted = Astro.url.searchParams.get('deleted') === '1';
const seedFromNavDone = Astro.url.searchParams.has('seeded') || Astro.url.searchParams.has('published');
const layoutSynced = Astro.url.searchParams.get('layout_synced') === '1';

function statusLabel(status: PageStatus): string {
	return status === 'published' ? ui.statusPublished : ui.statusDraft;
}
---

<AppLayout title={ui.title} heading={ui.title}>
	<AdminContextNav siteId={id} siteName={site.name} section="pages" />
	<p class="ui-muted mb-4">{ui.lead}</p>

	{deleted && <Alert variant="success">{ui.deleted}</Alert>}
	{seedFromNavDone && (
		<Alert variant="success">
			{ui.seedFromNavDone}
			{layoutSynced ? ` ${ui.layoutSynced}` : ''}
		</Alert>
	)}
	{errorMessage && <Alert variant="error">{errorMessage}</Alert>}

	<div class="mb-4 flex flex-wrap gap-3">
		<form method="post" action={`/api/admin/sites/${id}/pages/create`}>
			<Button type="submit">{ui.create}</Button>
		</form>
		<form method="post" action={`/api/admin/sites/${id}/pages/seed-nav`}>
			<Button type="submit" variant="secondary">{ui.actions.seedFromNav}</Button>
		</form>
	</div>
	<p class="ui-hint mb-4">{ui.seedFromNavHint}</p>

	<Panel>
		{
			pages.length === 0 ? (
				<p class="ui-empty">{ui.empty}</p>
			) : (
				<ul class="ui-list-divide">
					{pages.map((page) => (
						<li class="flex flex-wrap items-center justify-between gap-2 py-3 text-sm">
							<div>
								<a href={`/admin/units/${id}/pages/${page.id}`} class="ui-link font-medium">
									{page.title || '—'}
								</a>
								<p class="ui-hint mt-0.5 font-mono">
									{buildSitePagePublicPath(page.path_prefix, page.slug)}
								</p>
							</div>
							<span class="ui-status-badge">
								{statusLabel(page.status as PageStatus)}
							</span>
						</li>
					))}
				</ul>
			)
		}
	</Panel>
</AppLayout>
