---
import AppLayout from '@/layouts/AppLayout.astro';
import AdminContextNav from '@/components/shell/AdminContextNav.astro';
import PostRichEditor from '@/components/posts/PostRichEditor.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import { adminSitePages, dashboard } from '@/i18n';
import { getSitePageById } from '@/lib/site-pages';
import { pageDraftLiveStatus } from '@/lib/site-pages/sync-status';
import { buildSitePagePublicPath } from '@/lib/site-pages/url';
import { ensureSiteFromGitHub } from '@/lib/sync/ensure-site';
import type { PageStatus } from '@/lib/types';

const { id, pageId } = Astro.params;
if (!id || !pageId || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

await ensureSiteFromGitHub(Astro.locals.supabase, id, Astro.locals.user?.id ?? null);
const page = await getSitePageById(Astro.locals.supabase, pageId);
if (!page || page.site_id !== id) {
	return Astro.redirect(`/admin/units/${id}/pages?error=not_found`);
}

const { data: site } = await Astro.locals.supabase
	.from('sites')
	.select('name')
	.eq('id', id)
	.maybeSingle();

const ui = adminSitePages;
const ed = dashboard.editor;
const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
	errorCode && errorCode in ui.errors
		? ui.errors[errorCode as keyof typeof ui.errors]
		: null;
const saved = Astro.url.searchParams.get('saved') === '1';
const published = Astro.url.searchParams.get('published') === '1';
const publicPath = buildSitePagePublicPath(page.path_prefix, page.slug);
const statusLabel = page.status === 'published' ? ui.statusPublished : ui.statusDraft;
const syncStatus = pageDraftLiveStatus(page);
const syncLabel =
	syncStatus === 'in_sync'
		? ui.sync.inSync
		: syncStatus === 'draft_ahead'
			? ui.sync.draftAhead
			: syncStatus === 'live_ahead'
				? ui.sync.liveAhead
				: ui.sync.unknown;
---

<AppLayout title={page.title || ui.title} heading={page.title || ui.title}>
	<AdminContextNav
		siteId={id}
		siteName={site?.name ?? ui.title}
		section="pages"
		currentLabel={page.title || ui.title}
	/>

	<p class="ui-muted mb-2">
		<span class="ui-status-badge">{statusLabel}</span>
		<span class="ui-hint ml-2">{syncLabel}</span>
		<span class="ui-hint ml-2 font-mono">{publicPath}</span>
	</p>

	{saved && <Alert variant="success">{ui.saved}</Alert>}
	{published && <Alert variant="success">{ui.published}</Alert>}
	{errorMessage && <Alert variant="error">{errorMessage}</Alert>}

	<form
		id="page-form"
		method="post"
		action={`/api/admin/sites/${id}/pages/${pageId}/save`}
		class="ui-panel ui-panel--default max-w-4xl space-y-4"
	>
		<label class="ui-label">
			<span class="font-medium ui-label-text">{ui.fields.title}</span>
			<input type="text" name="title" required value={page.title} class="ui-input" />
		</label>
		<div class="grid gap-4 sm:grid-cols-2">
			<label class="ui-label">
				<span class="font-medium ui-label-text">{ui.fields.pathPrefix}</span>
				<input
					type="text"
					name="path_prefix"
					value={page.path_prefix}
					placeholder="gmina"
					class="ui-input font-mono text-sm"
				/>
				<p class="ui-hint mt-1">{ui.fields.pathPrefixHint}</p>
			</label>
			<label class="ui-label">
				<span class="font-medium ui-label-text">{ui.fields.slug}</span>
				<input
					type="text"
					name="slug"
					required
					value={page.slug}
					class="ui-input font-mono text-sm"
				/>
			</label>
		</div>
		<p class="ui-hint">
			{ui.fields.publicPath}: <code class="ui-code">{publicPath}</code>
		</p>
		<div>
			<span class="ui-subheading">{ui.fields.content}</span>
			<p class="ui-hint mt-0.5">{ui.fields.contentHint}</p>
			<div class="mt-2">
				<PostRichEditor
					initialMarkdown={page.content_md}
					placeholder={ed.fields.contentPlaceholder}
					toolbar={ed.richText}
				/>
			</div>
		</div>
		<div class="flex flex-wrap gap-3">
			<Button type="submit">{ui.actions.save}</Button>
			<Button
				type="submit"
				formaction={`/api/admin/sites/${id}/pages/${pageId}/publish`}
				variant="nav-accent"
			>
				{ui.actions.publish}
			</Button>
		</div>
	</form>

	<form
		method="post"
		action={`/api/admin/sites/${id}/pages/${pageId}/delete`}
		class="mt-8 max-w-4xl"
	>
		<Button type="submit" variant="danger">{ui.actions.delete}</Button>
	</form>
</AppLayout>
