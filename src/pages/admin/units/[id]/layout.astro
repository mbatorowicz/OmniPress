---
import AppLayout from '@/layouts/AppLayout.astro';
import AstroLayoutForm from '@/components/admin/AstroLayoutForm.astro';
import { adminLayout, adminRecentChanges, adminSitePages } from '@/i18n';
import { loadSiteAstroDestination } from '@/lib/admin/sites';
import {
	importSiteAstroLayoutFromGitHub,
	loadSiteAstroLayout,
} from '@/lib/astro-layout/store';
import {
	buildKnownNavPaths,
	formatNavValidationIssues,
	validateNavigationLinks,
} from '@/lib/astro-layout/validate-nav';
import { listSitePages } from '@/lib/site-pages/access';
import { buildSitePagePublicPath } from '@/lib/site-pages/url';

const DEFAULT_STATIC_ROUTES = ['/', '/kontakt'];

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sites');

const { data: site } = await Astro.locals.supabase
	.from('sites')
	.select('id, name, slug')
	.eq('id', id)
	.maybeSingle();

if (!site) return Astro.redirect('/admin/sites');

let layout = await loadSiteAstroLayout(Astro.locals.supabase, id);
const emptyLayout =
	layout.navigation.length === 0 &&
	layout.categories.length === 0 &&
	layout.slots.length === 0;

const hasAstroChannel = Boolean(await loadSiteAstroDestination(Astro.locals.supabase, id));

if (emptyLayout && hasAstroChannel) {
	const imported = await importSiteAstroLayoutFromGitHub(Astro.locals.supabase, id);
	if (imported.ok) layout = imported.layout;
}

const errorCode = Astro.url.searchParams.get('error');
const syncDetail = Astro.url.searchParams.get('sync_detail');
const syncSummary = Astro.url.searchParams.get('sync_summary');
const layoutErrors = adminLayout.errors;
const errorMessage =
	errorCode && errorCode in layoutErrors
		? layoutErrors[errorCode as keyof typeof layoutErrors]
		: null;
const errorDetail = syncDetail?.trim() || null;

const saved = Astro.url.searchParams.get('saved') === '1';
const synced = Astro.url.searchParams.get('synced') === '1';
const imported = Astro.url.searchParams.get('imported') === '1';

const knownNavPaths = await buildKnownNavPaths(
	Astro.locals.supabase,
	id,
	layout.categories.map((c) => c.slug),
	DEFAULT_STATIC_ROUTES,
);
const navWarningLines = formatNavValidationIssues(
	validateNavigationLinks(layout.navigation, knownNavPaths),
);

const publishedPages = (await listSitePages(Astro.locals.supabase, id))
	.filter((p) => p.status === 'published')
	.map((p) => ({
		path: buildSitePagePublicPath(p.path_prefix, p.slug),
		title: p.title,
	}));
---

<AppLayout title={adminLayout.title} heading={adminLayout.title}>
	<a href={`/admin/units/${id}`} class="mb-4 inline-block text-sm text-brand hover:underline">
		← {site.name}
	</a>

	<p class="mb-4 text-sm text-slate-600">{adminLayout.lead}</p>

	<AstroLayoutForm
		siteId={id}
		layout={layout}
		hasAstroChannel={hasAstroChannel}
		errorMessage={errorMessage}
		errorDetail={errorDetail}
		syncSummary={syncSummary}
		navWarningLines={navWarningLines}
		saved={saved}
		synced={synced}
		imported={imported}
		publishedPages={publishedPages}
	/>

	<p class="mt-6 flex flex-wrap gap-4">
		<a href={`/admin/units/${id}/pages`} class="text-sm text-brand hover:underline">
			→ {adminSitePages.title}
		</a>
		<a href={`/admin/units/${id}/changes`} class="text-sm text-brand hover:underline">
			→ {adminRecentChanges.title}
		</a>
	</p>
</AppLayout>
