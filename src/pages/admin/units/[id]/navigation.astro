---
import AppLayout from '@/layouts/AppLayout.astro';
import AdminContextNav from '@/components/shell/AdminContextNav.astro';
import LayoutEditorStatus from '@/components/admin/layout/LayoutEditorStatus.astro';
import NavigationLayoutForm from '@/components/admin/layout/NavigationLayoutForm.astro';
import { adminLayout } from '@/i18n';
import { loadLayoutEditorContext } from '@/lib/admin/layout-editor-context';
import { parseLayoutPageFlash } from '@/lib/admin/layout-page-flash';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sites');

const ctx = await loadLayoutEditorContext(Astro.locals.supabase, id, {
	draftStatusScope: 'navigation',
});
if (!ctx) return Astro.redirect('/admin/sites');

const flash = parseLayoutPageFlash(Astro.url);
---

<AppLayout title={adminLayout.navigationTitle} heading={adminLayout.navigationTitle}>
	<AdminContextNav siteId={id} siteName={ctx.site.name} section="navigation" />
	<p class="ui-muted mb-4">{adminLayout.navigationLead}</p>

	<LayoutEditorStatus
		draftStatus={ctx.draftStatus}
		navHasMissingHref={ctx.navHasMissingHref}
		lastPublishedAt={ctx.lastPublishedAt}
		lastPublishedSha={ctx.lastPublishedSha}
		lastDraftSavedAt={ctx.lastDraftSavedAt}
		hasAstroChannel={ctx.hasAstroChannel}
		navWarningLines={ctx.navWarningLines}
		{...flash}
		imported={flash.imported || ctx.autoImported}
		importHrefCount={flash.importHrefCount ?? ctx.autoImportHrefCount ?? null}
		importPath={flash.importPath ?? ctx.autoImportPath ?? null}
		errorMessage={
			flash.errorMessage ??
			(ctx.autoImportError && ctx.autoImportError in adminLayout.errors
				? adminLayout.errors[ctx.autoImportError as keyof typeof adminLayout.errors]
				: null)
		}
	/>

	<NavigationLayoutForm
		siteId={id}
		layout={ctx.layout}
		hasAstroChannel={ctx.hasAstroChannel}
		publishedPages={ctx.publishedPages}
		draftHrefCount={ctx.draftHrefCount}
		liveHrefCount={ctx.liveHrefCount}
		navHasMissingHref={ctx.navHasMissingHref}
	/>
</AppLayout>
