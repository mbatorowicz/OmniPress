---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/posts/StatusBadge.astro';
import { getPostById } from '@/lib/posts';
import type { PostStatus } from '@/lib/types';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') {
	return Astro.redirect('/admin');
}

const post = await getPostById(Astro.locals.supabase, id);
if (!post) {
	return Astro.redirect('/admin?error=not_found');
}

const { data: site } = await Astro.locals.supabase
	.from('sites')
	.select('name')
	.eq('id', post.site_id)
	.single();

const { data: author } = await Astro.locals.supabase
	.from('profiles')
	.select('display_name')
	.eq('id', post.author_id)
	.single();
---

<AppLayout title="Podgląd wpisu" heading="Podgląd wpisu">
	<div class="mb-4 flex flex-wrap gap-3 text-sm text-slate-600">
		<StatusBadge status={post.status as PostStatus} />
		{site?.name && <span>Strona: {site.name}</span>}
		{author?.display_name && <span>Autor: {author.display_name}</span>}
	</div>

	<article class="rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-xl font-semibold">{post.title || '(bez tytułu)'}</h2>
		{post.slug && <p class="mt-1 font-mono text-sm text-slate-500">/{post.slug}</p>}
		<pre class="mt-6 whitespace-pre-wrap rounded-lg bg-slate-50 p-4 text-sm">{post.content_md}</pre>
	</article>

	<p class="mt-6 text-sm text-slate-500">
		Akceptacja i publikacja — Faza 3–4.
	</p>
	<a href="/admin" class="mt-2 inline-block text-sm text-brand hover:underline">← Administracja</a>
</AppLayout>
