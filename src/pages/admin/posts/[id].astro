---
import AppLayout from '@/layouts/AppLayout.astro';
import AdminPostPreview from '@/components/admin/posts/AdminPostPreview.astro';
import PublishLogsPanel from '@/components/admin/posts/PublishLogsPanel.astro';
import PostAdminActions from '@/components/admin/PostAdminActions.astro';
import PostReopenForm from '@/components/admin/PostReopenForm.astro';
import FlashAlerts from '@/components/shared/FlashAlerts.astro';
import BackLink from '@/components/ui/navigation/BackLink.astro';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import StatusBadge from '@/components/ui/feedback/StatusBadge.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Label from '@/components/ui/form/Label.astro';
import Textarea from '@/components/ui/form/Textarea.astro';
import { admin, adminReview, adminUsers, common, layout } from '@/i18n';
import { canReopenPost, loadSiteAstroDestination } from '@/lib/admin';
import { listPublishLogsForPost } from '@/lib/publish';
import { buildPublishedBodyMd } from '@/lib/publish/post-gallery';
import type { PostAsset } from '@/lib/publish/assets';
import {
	assetsForPreviewRender,
	getPostById,
	isGalleryImageAsset,
	isPdfAsset,
	loadPostAssetsForPost,
	publicUrlForAsset,
	renderPostContentHtml,
} from '@/lib/posts';
import type { PostStatus } from '@/lib/types';
import type { FlashMessage } from '@/lib/ui/flash';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

const post = await getPostById(Astro.locals.supabase, id);
if (!post) return Astro.redirect('/admin?error=not_found');

const { data: site } = await Astro.locals.supabase.from('sites').select('name').eq('id', post.site_id).single();
const { data: author } = post.author_id
	? await Astro.locals.supabase
			.from('profiles')
			.select('display_name')
			.eq('id', post.author_id)
			.maybeSingle()
	: { data: null };
const authorName = author?.display_name ?? (post.author_id ? null : adminUsers.deletedAuthor);

const siteChannel = await loadSiteAstroDestination(Astro.locals.supabase, post.site_id);
const publishLogs = await listPublishLogsForPost(Astro.locals.supabase, post.id);
const isPending = post.status === 'pending';
const canReopen = await canReopenPost(Astro.locals.supabase, post.id, post.status);
const preview = admin.preview;

const params = Astro.url.searchParams;
const reviewErrors = adminReview.errors;
const errorCode = params.get('error');
const flashMessages: FlashMessage[] = [];

if (params.get('approved') === '1') {
	flashMessages.push({
		variant: 'success',
		message: params.get('scheduled') === '1' ? adminReview.approvedScheduled : adminReview.approved,
	});
}
if (params.get('rejected') === '1') flashMessages.push({ variant: 'warning', message: adminReview.rejected });
if (params.get('reopened') === '1') flashMessages.push({ variant: 'info', message: adminReview.reopened });
if (params.get('deactivated') === '1') flashMessages.push({ variant: 'success', message: adminReview.deactivated });
if (params.get('deleted') === '1') flashMessages.push({ variant: 'success', message: adminReview.deleted });
if (params.get('remote_warning') === '1') flashMessages.push({ variant: 'warning', message: adminReview.remoteWarning });
if (params.get('retry') === '1') flashMessages.push({ variant: 'info', message: adminReview.publishLogs.retryQueued });
if (errorCode && errorCode in reviewErrors) {
	flashMessages.push({ variant: 'error', message: reviewErrors[errorCode as keyof typeof reviewErrors] });
}

const postAssets = await loadPostAssetsForPost(Astro.locals.supabase, post.id);
const pdfAssets = postAssets.filter(isPdfAsset);
const pdfUrlMap = new Map(
	pdfAssets.flatMap((a) => {
		const u = publicUrlForAsset(a.storage_path);
		return u ? ([[u, u]] as const) : [];
	}),
);
const previewMd = buildPublishedBodyMd(post.content_md, pdfAssets as PostAsset[], pdfUrlMap);
const contentHtml = renderPostContentHtml(previewMd, assetsForPreviewRender(post.id, pdfAssets));
const galleryAssets = postAssets.filter(isGalleryImageAsset);

const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: post.title || common.untitled },
];
---

<AppLayout title={preview.title} heading={preview.heading} {breadcrumbs}>
	<div class="ui-muted mb-4 flex flex-wrap gap-3">
		<StatusBadge status={post.status as PostStatus} />
		{site?.name && <span>{preview.siteLabel} {site.name}</span>}
		{authorName && <span>{preview.authorLabel} {authorName}</span>}
	</div>

	<FlashAlerts messages={flashMessages} />
	{
		params.get('reopened') === '1' && (
			<p class="mb-4 text-sm">
				<a href={`/dashboard/posts/${post.id}`} class="ui-link">{adminReview.openEditor}</a>
			</p>
		)
	}

	<AdminPostPreview {post} {contentHtml} {galleryAssets} />
	<PublishLogsPanel postId={post.id} logs={publishLogs} />

	{
		isPending && siteChannel && (
			<Panel class="mt-6 space-y-3">
				<p class="ui-muted">{adminReview.publishLead(siteChannel.name)}</p>
				<form method="post" action={`/api/admin/posts/${post.id}/approve`}>
					<Button type="submit">{adminReview.approve}</Button>
				</form>
			</Panel>
		)
	}

	{
		isPending && !siteChannel && (
			<Alert variant="warning" class="mt-6">
				{adminReview.errors.no_site_channel}{' '}
				<a href={`/admin/units/${post.site_id}`} class="ui-link">{adminReview.configureSite}</a>
			</Alert>
		)
	}

	{
		isPending && (
			<Panel variant="danger" class="mt-4 max-w-lg">
				<form method="post" action={`/api/admin/posts/${post.id}/reject`} class="space-y-3">
					<Label>
						<span class="font-medium">{adminReview.rejectionNote}</span>
						<Textarea name="rejection_note" required rows={3} />
					</Label>
					<Button type="submit" variant="danger">{adminReview.reject}</Button>
				</form>
			</Panel>
		)
	}

	{canReopen && <PostReopenForm postId={post.id} />}
	<PostAdminActions postId={post.id} status={post.status} />
	<BackLink href="/admin" label={preview.back.replace('← ', '')} class="mt-6" />
</AppLayout>
