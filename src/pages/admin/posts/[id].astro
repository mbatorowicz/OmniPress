---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/posts/StatusBadge.astro';
import PostContentHtml from '@/components/posts/PostContentHtml.astro';
import { admin, adminReview, common } from '@/i18n';
import { getSiteDestinations } from '@/lib/admin';
import { listPublishLogsForPost } from '@/lib/publish';
import { assetsForContentRender, getPostById, loadPostAssetsForPost, renderPostContentHtml } from '@/lib/posts';
import type { PostStatus, PublishLogStatus } from '@/lib/types';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

const post = await getPostById(Astro.locals.supabase, id);
if (!post) return Astro.redirect('/admin?error=not_found');

const { data: site } = await Astro.locals.supabase.from('sites').select('name').eq('id', post.site_id).single();
const { data: author } = await Astro.locals.supabase
	.from('profiles')
	.select('display_name')
	.eq('id', post.author_id)
	.single();

const siteDests = await getSiteDestinations(Astro.locals.supabase, post.site_id);
const publishLogs = await listPublishLogsForPost(Astro.locals.supabase, post.id);
const isPending = post.status === 'pending';
const logLabels = adminReview.logStatus;
const logsUi = adminReview.publishLogs;

const errorCode = Astro.url.searchParams.get('error');
const reviewErrors = adminReview.errors;
const errorMessage =
	errorCode && errorCode in reviewErrors
		? reviewErrors[errorCode as keyof typeof reviewErrors]
		: null;

const approved = Astro.url.searchParams.get('approved') === '1';
const rejected = Astro.url.searchParams.get('rejected') === '1';
const reopened = Astro.url.searchParams.get('reopened') === '1';
const retried = Astro.url.searchParams.get('retry') === '1';
const isPublished = post.status === 'published';
const preview = admin.preview;

const postAssets = await loadPostAssetsForPost(Astro.locals.supabase, post.id);
const contentHtml = renderPostContentHtml(post.content_md, assetsForContentRender(postAssets));
---

<AppLayout title={preview.title} heading={preview.heading}>
	<div class="mb-4 flex flex-wrap gap-3 text-sm text-slate-600">
		<StatusBadge status={post.status as PostStatus} />
		{site?.name && <span>{preview.siteLabel} {site.name}</span>}
		{author?.display_name && <span>{preview.authorLabel} {author.display_name}</span>}
	</div>

	{approved && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{adminReview.approved}</p>
	)}
	{rejected && (
		<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">{adminReview.rejected}</p>
	)}
	{reopened && (
		<p class="mb-4 rounded-lg bg-sky-50 px-3 py-2 text-sm text-sky-900">{adminReview.reopened}</p>
	)}
	{reopened && (
		<p class="mb-4 text-sm">
			<a href={`/dashboard/posts/${post.id}`} class="text-brand hover:underline">
				Otwórz edytor redaktora →
			</a>
		</p>
	)}
	{retried && (
		<p class="mb-4 rounded-lg bg-sky-50 px-3 py-2 text-sm text-sky-900">{logsUi.retryQueued}</p>
	)}
	{errorMessage && (
		<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{errorMessage}</p>
	)}

	<article class="rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-xl font-semibold">{post.title || common.untitled}</h2>
		{post.category_name && (
			<p class="mt-1 text-sm text-slate-600">
				Kategoria: <strong>{post.category_name}</strong>
				{post.category_slug && <span class="font-mono text-slate-500"> ({post.category_slug})</span>}
			</p>
		)}
		{post.slug && <p class="mt-1 font-mono text-sm text-slate-500">/{post.slug}</p>}
		<div class="mt-6 rounded-lg border border-slate-100 bg-slate-50/50 p-4">
			{contentHtml ? (
				<PostContentHtml html={contentHtml} />
			) : (
				<p class="text-sm text-slate-500">(pusta treść)</p>
			)}
		</div>
	</article>

	{
		publishLogs.length > 0 && (
			<section class="mt-6 overflow-x-auto rounded-xl border bg-white p-6">
				<h3 class="text-sm font-medium">{logsUi.heading}</h3>
				<table class="mt-4 w-full text-left text-sm">
					<thead class="border-b text-slate-500">
						<tr>
							<th class="pb-2 pr-4">{logsUi.destination}</th>
							<th class="pb-2 pr-4">{logsUi.status}</th>
							<th class="pb-2 pr-4">{logsUi.summary}</th>
							<th class="pb-2 pr-4">{logsUi.retries}</th>
							<th class="pb-2">{logsUi.retry}</th>
						</tr>
					</thead>
					<tbody class="divide-y">
						{publishLogs.map((log) => {
							const st = log.status as PublishLogStatus;
							const failed = st === 'failed';
							return (
								<tr class={failed ? 'bg-red-50/50' : ''}>
									<td class="py-2 pr-4">
										{log.destinations?.name}
										<span class="ml-1 text-slate-400">({log.destinations?.type})</span>
									</td>
									<td class="py-2 pr-4">{logLabels[st]}</td>
									<td class="py-2 pr-4 text-slate-600">{log.response_summary ?? '—'}</td>
									<td class="py-2 pr-4">{log.retry_count}</td>
									<td class="py-2">
										{failed && (
											<form method="post" action={`/api/admin/posts/${post.id}/publish-logs/${log.id}/retry`}>
												<button type="submit" class="text-brand hover:underline">
													{logsUi.retry}
												</button>
											</form>
										)}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</section>
		)
	}

	{
		isPending && siteDests.length > 0 && (
			<form method="post" action={`/api/admin/posts/${post.id}/approve`} class="mt-6 space-y-3 rounded-xl border bg-white p-6">
				<p class="text-sm font-medium">{adminReview.destinations}</p>
				{
					siteDests.map((link) => (
						<label class="flex items-center gap-2 text-sm">
							<input
								type="checkbox"
								name="destination_id"
								value={link.destination_id}
								checked={link.is_default}
							/>
							{link.destinations?.name} ({link.destinations?.type})
						</label>
					))
				}
				<button type="submit" class="rounded-lg bg-brand px-4 py-2 text-sm text-white">
					{adminReview.approve}
				</button>
			</form>
		)
	}

	{
		isPending && (
			<form method="post" action={`/api/admin/posts/${post.id}/reject`} class="mt-4 max-w-lg space-y-3 rounded-xl border border-red-100 bg-white p-6">
				<label class="block text-sm">
					<span class="font-medium">{adminReview.rejectionNote}</span>
					<textarea name="rejection_note" required rows={3} class="mt-1 w-full rounded-lg border px-3 py-2" />
				</label>
				<button type="submit" class="rounded-lg border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-900">
					{adminReview.reject}
				</button>
			</form>
		)
	}

	{
		isPublished && (
			<form
				method="post"
				action={`/api/admin/posts/${post.id}/reopen`}
				class="mt-6 space-y-3 rounded-xl border border-sky-100 bg-sky-50/40 p-6"
				data-reopen-form
			>
				<p class="text-sm text-slate-700">{adminReview.reopenHint}</p>
				<button
					type="submit"
					class="rounded-lg border border-sky-300 bg-white px-4 py-2 text-sm font-medium text-sky-900 hover:bg-sky-50"
				>
					{adminReview.reopen}
				</button>
			</form>
		)
	}

	<a href="/admin" class="mt-6 inline-block text-sm text-brand hover:underline">{preview.back}</a>

	<script define:vars={{ reopenConfirm: adminReview.reopenConfirm }}>
		document.querySelector('[data-reopen-form]')?.addEventListener('submit', (e) => {
			if (!confirm(reopenConfirm)) e.preventDefault();
		});
	</script>
</AppLayout>
