---
import AppLayout from '@/layouts/AppLayout.astro';
import AdminPostPreview from '@/components/admin/posts/AdminPostPreview.astro';
import PublishLogsPanel from '@/components/admin/posts/PublishLogsPanel.astro';
import PostAdminActions from '@/components/admin/PostAdminActions.astro';
import PostPinnedPanel from '@/components/admin/posts/PostPinnedPanel.astro';
import PostReopenForm from '@/components/admin/PostReopenForm.astro';
import FlashAlerts from '@/components/shared/FlashAlerts.astro';
import BackLink from '@/components/ui/navigation/BackLink.astro';
import Button from '@/components/ui/actions/Button.astro';
import Panel from '@/components/ui/layout/Panel.astro';
import StatusBadge from '@/components/ui/feedback/StatusBadge.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Label from '@/components/ui/form/Label.astro';
import Textarea from '@/components/ui/form/Textarea.astro';
import { admin, adminReview, adminSitePages, common, layout } from '@/i18n';
import { pageDraftLiveStatus } from '@/lib/site-pages/sync-status';
import { parsePostReviewFlash } from '@/lib/admin/post-review-flash';
import { loadPostReviewPage } from '@/lib/admin/post-review-page';
import type { PostStatus } from '@/lib/types';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

const page = await loadPostReviewPage(Astro.locals.supabase, id);
if (!page) return Astro.redirect('/admin?error=not_found');

const { post, siteChannel, canApprove, isPending, preview } = page;
const notReady = page.missingForPublish;
const notReadyMessage = notReady ? adminReview.notReady[notReady] : null;
const flashMessages = parsePostReviewFlash(Astro.url);
const previewLabels = admin.preview;
const postSync = pageDraftLiveStatus({
	status: post.status === 'published' ? 'published' : 'draft',
	content_md: post.content_md,
	live_blob_sha: post.live_blob_sha ?? null,
	published_content_sha: post.published_content_sha ?? null,
});
const postSyncLabel =
	postSync === 'in_sync'
		? adminSitePages.sync.inSync
		: postSync === 'draft_ahead'
			? adminSitePages.sync.draftAhead
			: postSync === 'live_ahead'
				? adminSitePages.sync.liveAhead
				: adminSitePages.sync.unknown;

const breadcrumbs = [
	{ label: layout.breadcrumb.admin, href: '/admin' },
	{ label: post.title || common.untitled },
];
---

<AppLayout title={previewLabels.title} heading={previewLabels.heading} {breadcrumbs}>
	<div class="ui-muted mb-4 flex flex-wrap gap-3">
		<StatusBadge status={post.status as PostStatus} />
		<span class="ui-hint">{postSyncLabel}</span>
		{page.siteName && <span>{previewLabels.siteLabel} {page.siteName}</span>}
		{page.authorName && <span>{previewLabels.authorLabel} {page.authorName}</span>}
	</div>

	<FlashAlerts messages={flashMessages} />

	{
		page.canEdit && (
			<Panel class="mb-6 space-y-3">
				<p class="ui-muted">{adminReview.editHint}</p>
				{!isPending && canApprove && <p class="ui-hint">{adminReview.submitHint}</p>}
				<Button href={`/admin/posts/${post.id}/edit`} variant="secondary">
					{adminReview.edit}
				</Button>
			</Panel>
		)
	}

	{
		canApprove && !siteChannel && (
			<Alert variant="warning" class="mb-6">
				{adminReview.errors.no_site_channel}{' '}
				<a href={`/admin/units/${post.site_id}`} class="ui-link">{adminReview.configureSite}</a>
			</Alert>
		)
	}

	{
		canApprove && (
			<div class="ui-review-actions">
				{siteChannel && (
					<Panel class="space-y-3">
						<p class="ui-muted">
							{isPending
								? adminReview.publishLead(siteChannel.name)
								: adminReview.publishDraftLead(siteChannel.name)}
						</p>
						{notReadyMessage && <Alert variant="warning">{notReadyMessage}</Alert>}
						<form method="post" action={`/api/admin/posts/${post.id}/approve`} class="space-y-3">
							<label class="flex items-center gap-2">
								<input type="checkbox" name="pinned" />
								<span>{adminReview.pinned.label}</span>
							</label>
							<p class="ui-hint">{adminReview.pinned.hint}</p>
							<Button type="submit" disabled={Boolean(notReady)}>
								{isPending ? adminReview.approve : adminReview.approveDraft}
							</Button>
						</form>
					</Panel>
				)}
				{isPending && (
					<Panel variant="danger" class="space-y-3">
						<form method="post" action={`/api/admin/posts/${post.id}/reject`} class="space-y-3">
							<Label>
								<span class="font-medium">{adminReview.rejectionNote}</span>
								<Textarea name="rejection_note" required rows={3} />
							</Label>
							<Button type="submit" variant="danger">{adminReview.reject}</Button>
						</form>
					</Panel>
				)}
			</div>
		)
	}

	<AdminPostPreview {post} contentHtml={preview.contentHtml} galleryAssets={preview.galleryAssets} />
	{page.canManagePinned && <PostPinnedPanel postId={post.id} pinned={post.pinned} />}
	<PublishLogsPanel postId={post.id} logs={page.publishLogs} />

	{page.canReopen && <PostReopenForm postId={post.id} />}
	<PostAdminActions postId={post.id} status={post.status} />
	<BackLink href="/admin" label={previewLabels.back.replace('← ', '')} class="mt-6" />
</AppLayout>
