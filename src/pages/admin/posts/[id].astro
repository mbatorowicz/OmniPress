---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/posts/StatusBadge.astro';
import PostContentHtml from '@/components/posts/PostContentHtml.astro';
import PostReopenForm from '@/components/admin/PostReopenForm.astro';
import PostAdminActions from '@/components/admin/PostAdminActions.astro';
import Alert from '@/components/ui/Alert.astro';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import { admin, adminReview, common } from '@/i18n';
import { canReopenPost, loadSiteAstroDestination } from '@/lib/admin';
import { listPublishLogsForPost } from '@/lib/publish';
import { buildPublishedBodyMd } from '@/lib/publish/post-gallery';
import type { PostAsset } from '@/lib/publish/assets';
import { assetsForContentRender, getPostById, isGalleryImageAsset, isPdfAsset, loadPostAssetsForPost, publicUrlForAsset, renderPostContentHtml } from '@/lib/posts';
import type { PostStatus, PublishLogStatus } from '@/lib/types';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

const post = await getPostById(Astro.locals.supabase, id);
if (!post) return Astro.redirect('/admin?error=not_found');

const { data: site } = await Astro.locals.supabase.from('sites').select('name').eq('id', post.site_id).single();
const { data: author } = await Astro.locals.supabase
	.from('profiles')
	.select('display_name')
	.eq('id', post.author_id)
	.single();

const siteChannel = await loadSiteAstroDestination(Astro.locals.supabase, post.site_id);
const publishLogs = await listPublishLogsForPost(Astro.locals.supabase, post.id);
const isPending = post.status === 'pending';
const logLabels = adminReview.logStatus;
const logsUi = adminReview.publishLogs;

const errorCode = Astro.url.searchParams.get('error');
const reviewErrors = adminReview.errors;
const errorMessage =
	errorCode && errorCode in reviewErrors
		? reviewErrors[errorCode as keyof typeof reviewErrors]
		: null;

const approved = Astro.url.searchParams.get('approved') === '1';
const rejected = Astro.url.searchParams.get('rejected') === '1';
const reopened = Astro.url.searchParams.get('reopened') === '1';
const deactivated = Astro.url.searchParams.get('deactivated') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const remoteWarning = Astro.url.searchParams.get('remote_warning') === '1';
const retried = Astro.url.searchParams.get('retry') === '1';
const canReopen = await canReopenPost(Astro.locals.supabase, post.id, post.status);
const preview = admin.preview;

const postAssets = await loadPostAssetsForPost(Astro.locals.supabase, post.id);
const pdfAssets = postAssets.filter(isPdfAsset);
const pdfUrlMap = new Map(
	pdfAssets.flatMap((a) => {
		const u = publicUrlForAsset(a.storage_path);
		return u ? ([[u, u]] as const) : [];
	}),
);
const previewMd = buildPublishedBodyMd(post.content_md, pdfAssets as PostAsset[], pdfUrlMap);
const contentHtml = renderPostContentHtml(previewMd, assetsForContentRender(pdfAssets));
const galleryAssets = postAssets.filter(isGalleryImageAsset);
---

<AppLayout title={preview.title} heading={preview.heading}>
	<div class="mb-4 flex flex-wrap gap-3 text-sm text-slate-600">
		<StatusBadge status={post.status as PostStatus} />
		{site?.name && <span>{preview.siteLabel} {site.name}</span>}
		{author?.display_name && <span>{preview.authorLabel} {author.display_name}</span>}
	</div>

	{approved && <Alert variant="success">{adminReview.approved}</Alert>}
	{rejected && <Alert variant="warning">{adminReview.rejected}</Alert>}
	{reopened && <Alert variant="info">{adminReview.reopened}</Alert>}
	{deactivated && <Alert variant="success">{adminReview.deactivated}</Alert>}
	{deleted && <Alert variant="success">{adminReview.deleted}</Alert>}
	{remoteWarning && <Alert variant="warning">{adminReview.remoteWarning}</Alert>}
	{reopened && (
		<p class="mb-4 text-sm">
			<a href={`/dashboard/posts/${post.id}`} class="ui-link">
				Otwórz edytor redaktora →
			</a>
		</p>
	)}
	{retried && <Alert variant="info">{logsUi.retryQueued}</Alert>}
	{errorMessage && <Alert variant="error">{errorMessage}</Alert>}

	<Panel tag="article">
		<h2 class="text-xl font-semibold">{post.title || common.untitled}</h2>
		{post.category_name && (
			<p class="mt-1 text-sm text-slate-600">
				Kategoria: <strong>{post.category_name}</strong>
				{post.category_slug && <span class="font-mono text-slate-500"> ({post.category_slug})</span>}
			</p>
		)}
		{post.slug && <p class="mt-1 font-mono text-sm text-slate-500">/{post.slug}</p>}
		<div class="mt-6 rounded-lg border border-slate-100 bg-slate-50/50 p-4">
			{contentHtml ? (
				<PostContentHtml html={contentHtml} />
			) : (
				<p class="text-sm text-slate-500">(pusta treść)</p>
			)}
		</div>
		{
			galleryAssets.length > 0 && (
				<div class="mt-6">
					<h3 class="text-sm font-medium text-slate-700">Galeria zdjęć (pod wpisem na stronie)</h3>
					<div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
						{galleryAssets.map((asset, index) => {
							const url = publicUrlForAsset(asset.storage_path);
							if (!url) return null;
							return (
								<div class="relative overflow-hidden rounded-lg border border-slate-200">
									{index === 0 && (
										<span class="absolute left-2 top-2 z-10 rounded bg-brand px-2 py-0.5 text-xs font-medium text-white">
											Zajawka
										</span>
									)}
									<img src={url} alt={asset.filename} class="aspect-[4/3] w-full object-cover" loading="lazy" />
								</div>
							);
						})}
					</div>
				</div>
			)
		}
	</Panel>

	{
		publishLogs.length > 0 && (
			<Panel class="mt-6 overflow-x-auto">
				<h3 class="text-sm font-medium">{logsUi.heading}</h3>
				<table class="ui-table mt-4">
					<thead class="ui-table-head">
						<tr>
							<th class="ui-table-th">{logsUi.destination}</th>
							<th class="ui-table-th">{logsUi.status}</th>
							<th class="ui-table-th">{logsUi.summary}</th>
							<th class="ui-table-th">{logsUi.retries}</th>
							<th class="ui-table-th">{logsUi.retry}</th>
						</tr>
					</thead>
					<tbody class="ui-table-body">
						{publishLogs.map((log) => {
							const st = log.status as PublishLogStatus;
							const failed = st === 'failed';
							return (
								<tr class={`ui-table-row ${failed ? 'bg-red-50/50' : ''}`}>
									<td class="ui-table-td">
										{log.destinations?.name}
										<span class="ml-1 text-slate-400">({log.destinations?.type})</span>
									</td>
									<td class="ui-table-td">{logLabels[st]}</td>
									<td class="ui-table-td text-slate-600">{log.response_summary ?? '—'}</td>
									<td class="ui-table-td">{log.retry_count}</td>
									<td class="ui-table-td">
										{failed && (
											<form method="post" action={`/api/admin/posts/${post.id}/publish-logs/${log.id}/retry`}>
												<button type="submit" class="ui-link border-0 bg-transparent p-0">
													{logsUi.retry}
												</button>
											</form>
										)}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</Panel>
		)
	}

	{
		isPending && siteChannel && (
			<Panel class="mt-6 space-y-3">
				<p class="ui-muted">{adminReview.publishLead(siteChannel.name)}</p>
				<form method="post" action={`/api/admin/posts/${post.id}/approve`}>
					<Button type="submit">{adminReview.approve}</Button>
				</form>
			</Panel>
		)
	}

	{
		isPending && !siteChannel && (
			<Alert variant="warning" class="mt-6">
				{adminReview.errors.no_site_channel}{' '}
				<a href={`/admin/units/${post.site_id}`} class="ui-link">
					{adminReview.configureSite}
				</a>
			</Alert>
		)
	}

	{
		isPending && (
			<Panel variant="danger" class="mt-4 max-w-lg">
				<form method="post" action={`/api/admin/posts/${post.id}/reject`} class="space-y-3">
					<label class="ui-label">
						<span class="font-medium">{adminReview.rejectionNote}</span>
						<textarea name="rejection_note" required rows={3} class="ui-input" />
					</label>
					<Button type="submit" variant="danger">{adminReview.reject}</Button>
				</form>
			</Panel>
		)
	}

	{canReopen && <PostReopenForm postId={post.id} />}

	<PostAdminActions postId={post.id} status={post.status} />

	<a href="/admin" class="ui-link mt-6 inline-block text-sm">{preview.back}</a>
</AppLayout>
