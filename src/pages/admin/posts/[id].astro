---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/posts/StatusBadge.astro';
import { admin, adminReview, common } from '@/i18n';
import { getSiteDestinations } from '@/lib/admin';
import { getPostById } from '@/lib/posts';
import type { PostStatus } from '@/lib/types';

const { id } = Astro.params;
if (!id || Astro.locals.profile?.role !== 'admin') return Astro.redirect('/admin');

const post = await getPostById(Astro.locals.supabase, id);
if (!post) return Astro.redirect('/admin?error=not_found');

const { data: site } = await Astro.locals.supabase.from('sites').select('name').eq('id', post.site_id).single();
const { data: author } = await Astro.locals.supabase
	.from('profiles')
	.select('display_name')
	.eq('id', post.author_id)
	.single();

const siteDests = await getSiteDestinations(Astro.locals.supabase, post.site_id);
const isPending = post.status === 'pending';

const errorCode = Astro.url.searchParams.get('error');
const reviewErrors = adminReview.errors;
const errorMessage =
	errorCode && errorCode in reviewErrors
		? reviewErrors[errorCode as keyof typeof reviewErrors]
		: null;

const approved = Astro.url.searchParams.get('approved') === '1';
const rejected = Astro.url.searchParams.get('rejected') === '1';
const preview = admin.preview;
---

<AppLayout title={preview.title} heading={preview.heading}>
	<div class="mb-4 flex flex-wrap gap-3 text-sm text-slate-600">
		<StatusBadge status={post.status as PostStatus} />
		{site?.name && <span>{preview.siteLabel} {site.name}</span>}
		{author?.display_name && <span>{preview.authorLabel} {author.display_name}</span>}
	</div>

	{approved && (
		<p class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800">{adminReview.approved}</p>
	)}
	{rejected && (
		<p class="mb-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">{adminReview.rejected}</p>
	)}
	{errorMessage && (
		<p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{errorMessage}</p>
	)}

	<article class="rounded-xl border border-slate-200 bg-white p-6">
		<h2 class="text-xl font-semibold">{post.title || common.untitled}</h2>
		{post.slug && <p class="mt-1 font-mono text-sm text-slate-500">/{post.slug}</p>}
		<pre class="mt-6 whitespace-pre-wrap rounded-lg bg-slate-50 p-4 text-sm">{post.content_md}</pre>
	</article>

	{
		isPending && siteDests.length > 0 && (
			<form method="post" action={`/api/admin/posts/${post.id}/approve`} class="mt-6 space-y-3 rounded-xl border bg-white p-6">
				<p class="text-sm font-medium">{adminReview.destinations}</p>
				{
					siteDests.map((link) => (
						<label class="flex items-center gap-2 text-sm">
							<input
								type="checkbox"
								name="destination_id"
								value={link.destination_id}
								checked={link.is_default}
							/>
							{link.destinations?.name} ({link.destinations?.type})
						</label>
					))
				}
				<button type="submit" class="rounded-lg bg-brand px-4 py-2 text-sm text-white">
					{adminReview.approve}
				</button>
			</form>
		)
	}

	{
		isPending && (
			<form method="post" action={`/api/admin/posts/${post.id}/reject`} class="mt-4 max-w-lg space-y-3 rounded-xl border border-red-100 bg-white p-6">
				<label class="block text-sm">
					<span class="font-medium">{adminReview.rejectionNote}</span>
					<textarea name="rejection_note" required rows={3} class="mt-1 w-full rounded-lg border px-3 py-2" />
				</label>
				<button type="submit" class="rounded-lg border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-900">
					{adminReview.reject}
				</button>
			</form>
		)
	}

	<p class="mt-6 text-sm text-slate-500">{adminReview.phase4Note}</p>
	<a href="/admin" class="mt-2 inline-block text-sm text-brand hover:underline">{preview.back}</a>
</AppLayout>
