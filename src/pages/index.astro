---
import '../styles/global.css';
import VersionBadge from '@/components/layout/VersionBadge.astro';
import { isSupabaseConfigured } from '../lib/supabase/env';

const setup = Astro.url.searchParams.get('setup') === '1';
const configured = isSupabaseConfigured();
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>OmniPress</title>
	</head>
	<body class="flex min-h-screen flex-col items-center justify-center gap-4 bg-slate-100 p-6 font-sans">
		<div class="w-full max-w-md rounded-xl bg-white p-8 shadow-sm">
			<h1 class="text-2xl font-semibold text-brand">OmniPress</h1>
			<p class="mt-2 text-slate-600">Headless CMS do publikacji na WordPress i Astro.</p>
			{
				!configured || setup ? (
					<div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
						<p class="font-medium">Konfiguracja wymagana</p>
						<p class="mt-1">
							Utwórz plik <code class="rounded bg-amber-100 px-1">.env</code> na podstawie{' '}
							<code class="rounded bg-amber-100 px-1">.env.example</code>, uruchom migrację SQL w
							Supabase, potem <code class="rounded bg-amber-100 px-1">npm run dev</code>.
						</p>
					</div>
				) : (
					<p class="mt-6">
						<a href="/login" class="font-medium text-brand hover:underline">
							Przejdź do logowania →
						</a>
					</p>
				)
			}
		</div>
		<VersionBadge />
	</body>
</html>
