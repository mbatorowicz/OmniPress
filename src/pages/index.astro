---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import { common, home } from '@/i18n';
import { isSupabaseConfigured } from '@/lib/supabase/env';

const setup = Astro.url.searchParams.get('setup') === '1';
const configured = isSupabaseConfigured();
---

<PublicLayout>
	<h1 class="ui-title-page">{common.appName}</h1>
	<p class="ui-muted mt-2">{home.tagline}</p>
	{
		!configured || setup ? (
			<Alert variant="warning" class="mt-6 mb-0">
				<p class="font-medium">{home.setup.heading}</p>
				<p class="mt-1">{home.setup.body}</p>
			</Alert>
		) : (
			<p class="mt-6">
				<Button href="/login">{home.goToLogin}</Button>
			</p>
		)
	}
</PublicLayout>
