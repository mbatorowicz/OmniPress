---
import '../styles/global.css';
import VersionBadge from '@/components/layout/VersionBadge.astro';
import { common, home } from '@/i18n';
import { isSupabaseConfigured } from '@/lib/supabase/env';

const setup = Astro.url.searchParams.get('setup') === '1';
const configured = isSupabaseConfigured();
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{common.appName}</title>
	</head>
	<body class="flex min-h-screen flex-col items-center justify-center gap-4 bg-slate-100 p-6 font-sans">
		<div class="w-full max-w-md rounded-xl bg-white p-8 shadow-sm">
			<h1 class="text-2xl font-semibold text-brand">{common.appName}</h1>
			<p class="mt-2 text-slate-600">{home.tagline}</p>
			{
				!configured || setup ? (
					<div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
						<p class="font-medium">{home.setup.heading}</p>
						<p class="mt-1">{home.setup.body}</p>
					</div>
				) : (
					<p class="mt-6">
						<a href="/login" class="font-medium text-brand hover:underline">
							{home.goToLogin}
						</a>
					</p>
				)
			}
		</div>
		<VersionBadge />
	</body>
</html>
