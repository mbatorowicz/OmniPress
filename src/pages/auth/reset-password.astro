---
import '../../styles/global.css';
import { getSupabaseEnv } from '../../lib/supabase/env';

const code = Astro.url.searchParams.get('code');
let sessionReady = false;
let exchangeError: string | null = null;

if (code && Astro.locals.supabase) {
	const { error } = await Astro.locals.supabase.auth.exchangeCodeForSession(code);
	if (!error) {
		sessionReady = true;
	} else {
		exchangeError = error.message;
	}
}

let supabaseUrl = '';
let supabaseAnonKey = '';

try {
	const env = getSupabaseEnv();
	supabaseUrl = env.url;
	supabaseAnonKey = env.anonKey;
} catch {
	/* SSR na Vercel */
}

const showForm = sessionReady;
const showClientFallback = !sessionReady && !exchangeError && Boolean(supabaseUrl);
---


<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Nowe hasło · OmniPress</title>
	</head>
	<body
		class="flex min-h-screen items-center justify-center bg-slate-100 p-6 font-sans"
		data-supabase-url={supabaseUrl}
		data-supabase-key={supabaseAnonKey}
	>
		<div class="w-full max-w-sm rounded-xl bg-white p-8 shadow-sm">
			<h1 class="text-xl font-semibold text-brand">Ustaw hasło</h1>
			<p class="mt-1 text-sm text-slate-600">Wpisz nowe hasło do konta OmniPress.</p>

			<form id="reset-form" class:list={['mt-6 space-y-4', !showForm && 'hidden']}>
				<label class="block text-sm">
					<span class="text-slate-700">Nowe hasło</span>
					<input
						type="password"
						id="password"
						required
						minlength="8"
						autocomplete="new-password"
						class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
					/>
				</label>
				<label class="block text-sm">
					<span class="text-slate-700">Powtórz hasło</span>
					<input
						type="password"
						id="password2"
						required
						minlength="8"
						autocomplete="new-password"
						class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
					/>
				</label>
				<p id="form-error" class="hidden text-sm text-red-700" role="alert"></p>
				<button
					type="submit"
					class="w-full rounded-lg bg-brand px-4 py-2 font-medium text-white hover:bg-brand-dark"
				>
					Zapisz hasło
				</button>
			</form>

			{
				exchangeError && (
					<p class="mt-4 text-sm text-red-700" role="alert">
						{exchangeError}
						<a href="/login?mode=reset" class="mt-2 block text-brand underline">
							Wyślij nowy link
						</a>
					</p>
				)
			}
			<p id="loading" class:list={['mt-4 text-sm text-slate-600', (showForm || exchangeError) && 'hidden']}>
				Weryfikacja linku…
			</p>
			<p id="link-error" class="mt-4 hidden text-sm text-red-700">
				Link wygasł lub jest nieprawidłowy.
				<a href="/login?mode=reset" class="text-brand underline">Wyślij nowy link</a>
			</p>
		</div>

		{
			showClientFallback && supabaseUrl && supabaseAnonKey && (
				<script>
					import { createBrowserClient } from '@supabase/ssr';

					const body = document.body;
					const supabase = createBrowserClient(
						body.dataset.supabaseUrl!,
						body.dataset.supabaseKey!,
					);

					const form = document.getElementById('reset-form');
					const loading = document.getElementById('loading');
					const linkError = document.getElementById('link-error');
					const formError = document.getElementById('form-error');

					async function initSession() {
						const hash = window.location.hash.replace(/^#/, '');
						if (hash) {
							const params = new URLSearchParams(hash);
							const access_token = params.get('access_token');
							const refresh_token = params.get('refresh_token');
							if (access_token && refresh_token) {
								const { error } = await supabase.auth.setSession({
									access_token,
									refresh_token,
								});
								if (error) {
									loading.classList.add('hidden');
									linkError.classList.remove('hidden');
									return;
								}
								history.replaceState(null, '', window.location.pathname);
								loading.classList.add('hidden');
								form.classList.remove('hidden');
								return;
							}
						}

						const code = new URL(window.location.href).searchParams.get('code');
						if (code) {
							const { error } = await supabase.auth.exchangeCodeForSession(code);
							if (error) {
								loading.classList.add('hidden');
								linkError.classList.remove('hidden');
								return;
							}
							history.replaceState(null, '', window.location.pathname);
							loading.classList.add('hidden');
							form.classList.remove('hidden');
							return;
						}

						const {
							data: { session },
						} = await supabase.auth.getSession();
						if (session) {
							loading.classList.add('hidden');
							form.classList.remove('hidden');
							return;
						}

						loading.classList.add('hidden');
						linkError.classList.remove('hidden');
					}

					form?.addEventListener('submit', async (e) => {
						e.preventDefault();
						formError.classList.add('hidden');
						const p1 = document.getElementById('password').value;
						const p2 = document.getElementById('password2').value;
						if (p1 !== p2) {
							formError.textContent = 'Hasła muszą być takie same.';
							formError.classList.remove('hidden');
							return;
						}
						if (p1.length < 8) {
							formError.textContent = 'Hasło musi mieć co najmniej 8 znaków.';
							formError.classList.remove('hidden');
							return;
						}
						const { error } = await supabase.auth.updateUser({ password: p1 });
						if (error) {
							formError.textContent = error.message;
							formError.classList.remove('hidden');
							return;
						}
						window.location.href = '/';
					});

					initSession();
				</script>
			)
		}
	</body>
</html>
