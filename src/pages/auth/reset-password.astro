---
import '../../styles/global.css';
import VersionBadge from '@/components/layout/VersionBadge.astro';
import Alert from '@/components/ui/Alert.astro';
import Button from '@/components/ui/Button.astro';
import { auth, common, mapAuthError } from '@/i18n';

const code = Astro.url.searchParams.get('code');
const errorParam = Astro.url.searchParams.get('error');
const rp = auth.resetPassword;

let sessionReady = false;
let exchangeError: string | null = null;

if (code && Astro.locals.supabase) {
	const { error } = await Astro.locals.supabase.auth.exchangeCodeForSession(code);
	if (!error) {
		sessionReady = true;
	} else {
		exchangeError = mapAuthError(error.message);
	}
} else if (Astro.locals.user) {
	sessionReady = true;
}

const showServerForm = sessionReady && !exchangeError;
const showHashBridge = !sessionReady && !exchangeError && !code;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{rp.pageTitle} · {common.appName}</title>
	</head>
	<body class="ui-auth-shell font-sans">
		<div class="ui-auth-card">
			<h1 class="ui-auth-title">{rp.heading}</h1>
			<p class="mt-1 text-sm text-slate-600">{rp.lead}</p>

			{
				errorParam && (
					<Alert variant="error" class="mt-4 mb-0">
						{decodeURIComponent(errorParam)}
					</Alert>
				)
			}
			{
				exchangeError && (
					<Alert variant="error" class="mt-4 mb-0">
						{exchangeError}
						<a href="/login?mode=reset" class="mt-2 block ui-link underline">
							{rp.requestNewShort}
						</a>
					</Alert>
				)
			}

			{
				showServerForm ? (
					<form action="/api/auth/set-password" method="post" class="mt-6 space-y-4">
						<label class="ui-label">
							<span class="ui-label-text">{rp.newPassword}</span>
							<input
								type="password"
								name="password"
								required
								minlength="8"
								autocomplete="new-password"
								class="ui-input"
							/>
						</label>
						<label class="ui-label">
							<span class="ui-label-text">{rp.confirmPassword}</span>
							<input
								type="password"
								name="password_confirm"
								required
								minlength="8"
								autocomplete="new-password"
								class="ui-input"
							/>
						</label>
						<Button type="submit" block>
							{rp.submit}
						</Button>
					</form>
				) : (
					!exchangeError && (
						<p id="status" class="mt-4 text-sm text-slate-600">
							{showHashBridge ? rp.activating : rp.noSession}
						</p>
					)
				)
			}

			{
				!showServerForm && !exchangeError && (
					<p class="mt-4 text-center text-sm">
						<a href="/login?mode=reset" class="ui-link">
							{rp.requestNew}
						</a>
					</p>
				)
			}
		</div>
		<VersionBadge />

		{
			showHashBridge && (
				<script
					define:vars={{
						hashNoToken: rp.hashNoToken,
						hashInvalid: rp.hashInvalid,
					}}
				>
					(() => {
						const hash = window.location.hash.replace(/^#/, '');
						const status = document.getElementById('status');
						if (!hash) {
							status.textContent = hashNoToken;
							return;
						}
						const params = new URLSearchParams(hash);
						const access_token = params.get('access_token');
						const refresh_token = params.get('refresh_token');
						if (!access_token || !refresh_token) {
							status.textContent = hashInvalid;
							return;
						}
						const form = document.createElement('form');
						form.method = 'POST';
						form.action = '/api/auth/establish-session';
						for (const [name, value] of [
							['access_token', access_token],
							['refresh_token', refresh_token],
						]) {
							const input = document.createElement('input');
							input.type = 'hidden';
							input.name = name;
							input.value = value;
							form.appendChild(input);
						}
						document.body.appendChild(form);
						form.submit();
					})();
				</script>
			)
		}
	</body>
</html>
