---
/**
 * Pomocnicza trasa: użytkownik z linku na złym hoście może wejść tutaj z ?code=
 * np. po ręcznej podmianie localhost:3000 → omni-press.vercel.app/auth/recover?code=...
 */
const code = Astro.url.searchParams.get('code');
if (code) {
	return Astro.redirect(`/auth/reset-password?code=${encodeURIComponent(code)}`);
}
return Astro.redirect('/login?mode=reset');
---
