---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { auth, callbackPage } from '@/i18n';
import { getProfile, roleHomePath } from '@/lib/auth';
import { getSupabaseEnv } from '@/lib/supabase/env';

const code = Astro.url.searchParams.get('code');
const errorParam = Astro.url.searchParams.get('error_description');

let supabaseUrl = '';
let supabaseAnonKey = '';

try {
	const env = getSupabaseEnv();
	supabaseUrl = env.url;
	supabaseAnonKey = env.anonKey;
} catch {
	// env wstrzyknięte przy SSR na Vercel
}

// Przepływ PKCE (?code=) — sesja w ciasteczkach po stronie serwera
if (code && Astro.locals.supabase) {
	const { error } = await Astro.locals.supabase.auth.exchangeCodeForSession(code);
	if (!error) {
		const {
			data: { user },
		} = await Astro.locals.supabase.auth.getUser();
		const profile = user ? await getProfile(Astro.locals.supabase, user.id) : null;
		const role = profile?.role ?? 'editor';
		return Astro.redirect(roleHomePath(role));
	}
}

const hasCode = Boolean(code);
const authError =
	errorParam ?? (Astro.url.searchParams.get('error') ? auth.callback.failed : null);
---

<AuthLayout title={callbackPage.pageTitle} heading={callbackPage.pageTitle}>
	<div
		id="auth-callback-root"
		class="text-center"
		data-supabase-url={supabaseUrl}
		data-supabase-key={supabaseAnonKey}
		data-has-code={hasCode ? '1' : '0'}
	>
		{
			authError ? (
				<>
					<p class="ui-hint--error">{authError}</p>
					<a href="/login" class="ui-link mt-4 inline-block">
						{callbackPage.backToLogin}
					</a>
				</>
			) : (
				<>
					<p class="ui-subheading">{callbackPage.processing}</p>
					<p class="ui-muted mt-2">{callbackPage.redirectHint}</p>
				</>
			)
		}
	</div>
	{
		!authError && !hasCode && supabaseUrl && supabaseAnonKey && (
			<script>
				import { createBrowserClient } from '@supabase/ssr';

				const root = document.getElementById('auth-callback-root');
				if (!root) throw new Error('auth-callback-root missing');
				const url = root.dataset.supabaseUrl!;
				const key = root.dataset.supabaseKey!;

				const supabase = createBrowserClient(url, key);

				async function finishAuth() {
					const hash = window.location.hash.replace(/^#/, '');
					if (hash) {
						const params = new URLSearchParams(hash);
						const access_token = params.get('access_token');
						const refresh_token = params.get('refresh_token');
						if (access_token && refresh_token) {
							const { error } = await supabase.auth.setSession({
								access_token,
								refresh_token,
							});
							if (error) {
								window.location.href = '/login?error=session';
								return;
							}
							window.location.replace('/');
							return;
						}
					}
					const code = new URL(window.location.href).searchParams.get('code');
					if (code) {
						window.location.reload();
						return;
					}
					window.location.href = '/login?error=missing_token';
				}

				finishAuth();
			</script>
		)
	}
</AuthLayout>
