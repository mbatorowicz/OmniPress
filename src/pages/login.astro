---
import '../styles/global.css';
import VersionBadge from '@/components/layout/VersionBadge.astro';
import { isSupabaseConfigured } from '../lib/supabase/env';

const configured = isSupabaseConfigured();
let errorMessage: string | null = null;
let infoMessage: string | null = null;

const mode = Astro.url.searchParams.get('mode');
const errorParam = Astro.url.searchParams.get('error');
const successParam = Astro.url.searchParams.get('success');
const sent = Astro.url.searchParams.get('sent') === '1';

if (errorParam === 'missing') {
	errorMessage = 'Podaj e-mail i hasło.';
}
if (errorParam === 'missing_email') {
	errorMessage = 'Podaj adres e-mail.';
}
if (errorParam === 'session') {
	errorMessage = 'Logowanie nie powiodło się — spróbuj ponownie.';
}
if (errorParam && !['missing', 'missing_email', 'session'].includes(errorParam)) {
	try {
		errorMessage = decodeURIComponent(errorParam);
	} catch {
		errorMessage = errorParam;
	}
}
if (successParam) {
	try {
		infoMessage = decodeURIComponent(successParam);
	} catch {
		infoMessage = successParam;
	}
}
if (sent) {
	infoMessage =
		'Jeśli konto istnieje, wysłaliśmy link do ustawienia hasła. Sprawdź skrzynkę (także spam).';
}

const showReset = mode === 'reset';
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Logowanie · OmniPress</title>
	</head>
	<body class="flex min-h-screen flex-col items-center justify-center gap-4 bg-slate-100 p-6">
		<div class="w-full max-w-sm rounded-xl bg-white p-8 shadow-sm">
			<h1 class="text-xl font-semibold text-brand">OmniPress</h1>
			<p class="mt-1 text-sm text-slate-600">
				{showReset ? 'Odzyskaj dostęp do konta' : 'Zaloguj się e-mailem i hasłem'}
			</p>

			{
				!configured ? (
					<p class="mt-4 text-sm text-amber-800">
						Brak połączenia z Supabase — skontaktuj się z administratorem.
					</p>
				) : (
					<>
						{errorMessage && (
							<p class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" role="alert">
								{errorMessage}
							</p>
						)}
						{infoMessage && (
							<p class="mt-4 rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800" role="status">
								{infoMessage}
							</p>
						)}

						{
							showReset ? (
								<form action="/api/auth/reset" method="post" class="mt-6 space-y-4">
									<label class="block text-sm">
										<span class="text-slate-700">E-mail</span>
										<input
											type="email"
											name="email"
											required
											autocomplete="username"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
										/>
									</label>
									<button
										type="submit"
										class="w-full rounded-lg bg-brand px-4 py-2 font-medium text-white hover:bg-brand-dark"
									>
										Wyślij link do ustawienia hasła
									</button>
									<p class="text-center text-sm">
										<a href="/login" class="text-brand hover:underline">
											← Wróć do logowania
										</a>
									</p>
								</form>
							) : (
								<form action="/api/auth/login" method="post" class="mt-6 space-y-4">
									<label class="block text-sm">
										<span class="text-slate-700">E-mail</span>
										<input
											type="email"
											name="email"
											required
											autocomplete="username"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
										/>
									</label>
									<label class="block text-sm">
										<span class="text-slate-700">Hasło</span>
										<input
											type="password"
											name="password"
											required
											autocomplete="current-password"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"
										/>
									</label>
									<button
										type="submit"
										class="w-full rounded-lg bg-brand px-4 py-2 font-medium text-white hover:bg-brand-dark"
									>
										Zaloguj
									</button>
									<p class="text-center text-sm">
										<a href="/login?mode=reset" class="text-slate-600 hover:text-brand">
											Zapomniałem hasła / pierwsze logowanie
										</a>
									</p>
								</form>
							)
						}
					</>
				)
			}
		</div>
		<VersionBadge />
	</body>
</html>
