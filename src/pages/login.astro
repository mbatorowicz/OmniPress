---
import AuthLayout from '@/layouts/AuthLayout.astro';
import Alert from '@/components/ui/feedback/Alert.astro';
import Button from '@/components/ui/actions/Button.astro';
import Label from '@/components/ui/form/Label.astro';
import Input from '@/components/ui/form/Input.astro';
import { auth, common } from '@/i18n';
import { isSupabaseConfigured } from '@/lib/supabase/env';

const configured = isSupabaseConfigured();
let errorMessage: string | null = null;
let infoMessage: string | null = null;

const mode = Astro.url.searchParams.get('mode');
const errorParam = Astro.url.searchParams.get('error');
const successParam = Astro.url.searchParams.get('success');
const sent = Astro.url.searchParams.get('sent') === '1';
const loginErrors = auth.login.errors;
const loginErrorKeys = Object.keys(loginErrors) as (keyof typeof loginErrors)[];

if (errorParam && loginErrorKeys.includes(errorParam as keyof typeof loginErrors)) {
	errorMessage = loginErrors[errorParam as keyof typeof loginErrors];
} else if (errorParam) {
	try {
		errorMessage = decodeURIComponent(errorParam);
	} catch {
		errorMessage = errorParam;
	}
}
if (successParam) {
	try {
		infoMessage = decodeURIComponent(successParam);
	} catch {
		infoMessage = successParam;
	}
}
if (sent) infoMessage = auth.login.resetSent;

const showReset = mode === 'reset';
---

<AuthLayout
	title={auth.login.pageTitle}
	lead={showReset ? auth.login.headingReset : auth.login.headingSignIn}
>
	{
		!configured ? (
			<p class="ui-warning-text mt-4">{auth.login.notConfigured}</p>
		) : (
			<>
				{errorMessage && <Alert variant="error" class="mt-4 mb-0">{errorMessage}</Alert>}
				{infoMessage && <Alert variant="success" class="mt-4 mb-0">{infoMessage}</Alert>}
				{
					showReset ? (
						<form action="/api/auth/reset" method="post" class="mt-6 space-y-4">
							<Label>
								<span>{common.email}</span>
								<Input type="email" name="email" required autocomplete="username" />
							</Label>
							<Button type="submit" block>{auth.login.submitReset}</Button>
							<p class="text-center text-sm">
								<a href="/login" class="ui-link">{auth.login.backToLogin}</a>
							</p>
						</form>
					) : (
						<form action="/api/auth/login" method="post" class="mt-6 space-y-4">
							<Label>
								<span>{common.email}</span>
								<Input type="email" name="email" required autocomplete="username" />
							</Label>
							<Label>
								<span>{common.password}</span>
								<Input type="password" name="password" required autocomplete="current-password" />
							</Label>
							<Button type="submit" block>{auth.login.submitSignIn}</Button>
							<p class="text-center text-sm">
								<a href="/login?mode=reset" class="ui-link">{auth.login.forgotPassword}</a>
							</p>
						</form>
					)
				}
			</>
		)
	}
</AuthLayout>
