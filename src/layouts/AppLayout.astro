---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppHeader from '@/components/shell/AppHeader.astro';
import AppFooter from '@/components/shell/AppFooter.astro';

interface Props {
	title: string;
	heading?: string;
}

const { title, heading } = Astro.props;
---

<BaseLayout title={title} bodyClass="ui-app-shell">
	<AppHeader />
	<main class="ui-app-main">
		{heading && <h1 class="ui-page-heading">{heading}</h1>}
		<slot />
	</main>
	<AppFooter />
</BaseLayout>
