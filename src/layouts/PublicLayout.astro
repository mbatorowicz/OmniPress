---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VersionBadge from '@/components/shell/VersionBadge.astro';
import { common } from '@/i18n';

interface Props {
	title?: string;
}

const { title = common.appName } = Astro.props;
---

<BaseLayout title={title} bodyClass="ui-auth-shell font-sans">
	<main id="main-content" class="ui-public-card" tabindex="-1">
		<slot />
	</main>
	<VersionBadge />
</BaseLayout>
