# --- Lokalny development (skopiuj do .env) ---
# Z Supabase: Settings → API → Project URL i anon public

PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
PUBLIC_SUPABASE_ANON_KEY=twoj-anon-key

# --- Vercel + integracja Supabase ---
# Po podłączeniu integracji NIE musisz nic wpisywać ręcznie —
# aplikacja odczyta SUPABASE_URL i SUPABASE_ANON_KEY automatycznie.
# Prefiks Custom Prefix w Vercel zostaw PUSTY.

# --- Tylko serwer (Vercel Production / worker) ---
# SUPABASE_SERVICE_ROLE_KEY=  # worker publikacji — nie w UI
# ENCRYPTION_KEY=             # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRON_SECRET=                # losowy string — Vercel Cron + /api/worker/publish
# VERCEL_TOKEN=               # opcjonalnie — weryfikacja buildu stron Astro
# RESEND_API_KEY=             # Receiving — GET treści maila
# RESEND_WEBHOOK_SECRET=      # Svix webhooka email.received (whsec_…)
# INBOUND_ALLOWED_FROM=       # allowlista From, przecinki / nowe linie
# INBOUND_DEFAULT_SITE_SLUG=  # slug jednostki (np. gmina-miedzna-pl)
# INBOUND_FALLBACK_AUTHOR_ID= # UUID profilu, gdy nadawca nie ma konta
# INBOUND_AI_MODEL=           # pusty = wyłącz Grok; brak = xai/grok-4.1-fast-non-reasoning
# INBOUND_SITE_BY_DOMAIN=     # gminamiedzna.pl:gmina-miedzna,sp-miedzna.pl:sp-miedzna
# INBOUND_SITE_BY_EMAIL=      # opcjonalnie dokładny adres:slug
# AI_GATEWAY_API_KEY=         # lokalnie; na Vercel OIDC
