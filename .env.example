# --- Lokalny development (skopiuj do .env) ---
# Z Supabase: Settings → API → Project URL i anon public

PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
PUBLIC_SUPABASE_ANON_KEY=twoj-anon-key

# --- Vercel + integracja Supabase ---
# Po podłączeniu integracji NIE musisz nic wpisywać ręcznie —
# aplikacja odczyta SUPABASE_URL i SUPABASE_ANON_KEY automatycznie.
# Prefiks Custom Prefix w Vercel zostaw PUSTY (nie używaj STORAGE).

# Opcjonalnie (później, tylko serwer):
# SUPABASE_SERVICE_ROLE_KEY=
# ENCRYPTION_KEY=   # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRON_SECRET=      # losowy string — Vercel Cron + /api/worker/publish
# VERCEL_TOKEN=     # opcjonalnie — weryfikacja buildu stron Astro po publikacji (alternatywa: token w destynacji)
# SUPABASE_SERVICE_ROLE_KEY=  # tylko worker (nie w UI)
