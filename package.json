{
  "name": "omnipress",
  "type": "module",
  "version": "0.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:pdf-viewer": "node scripts/build-pdf-viewer.mjs",
    "build": "npm run build:pdf-viewer && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "setup:remote": "node scripts/setup-remote.mjs",
    "setup:password": "node scripts/set-admin-password.mjs",
    "setup:auth-urls": "node scripts/fix-auth-config.mjs",
    "setup:storage": "node scripts/apply-migration.mjs supabase/migrations/20250604000000_storage_post_assets.sql",
    "setup:storage-pdf": "node scripts/apply-migration.mjs supabase/migrations/20250609000000_storage_post_assets_pdf.sql",
    "setup:storage-docx": "node scripts/apply-migration.mjs supabase/migrations/20250622000000_storage_post_assets_docx.sql",
    "setup:asset-display": "node scripts/apply-migration.mjs supabase/migrations/20250610000000_asset_display_mode.sql",
    "setup:asset-sort": "node scripts/apply-migration.mjs supabase/migrations/20250611000000_asset_sort_order.sql",
    "setup:phase3": "node scripts/apply-migration.mjs supabase/migrations/20250605000000_phase3_post_slug_unique.sql",
    "setup:phase4": "node scripts/apply-migration.mjs supabase/migrations/20250606000000_phase4_publish_worker.sql",
    "setup:categories": "node scripts/apply-migration.mjs supabase/migrations/20250607000000_post_categories.sql",
    "setup:layout": "node scripts/apply-migration.mjs supabase/migrations/20250608000000_site_astro_layout.sql",
    "setup:remove-wordpress": "node scripts/apply-migration.mjs supabase/migrations/20250612000000_remove_wordpress.sql",
    "setup:profiles-guard": "node scripts/apply-migration.mjs supabase/migrations/20250613000000_profiles_self_update_guard.sql",
    "setup:scheduled-publish": "node scripts/apply-migration.mjs supabase/migrations/20250614000000_post_scheduled_publish.sql",
    "setup:site-pages": "node scripts/apply-migration.mjs supabase/migrations/20250615000000_site_pages.sql",
    "seed:nav-pages": "node scripts/seed-nav-pages.mjs --db-only",
    "setup:storage-import-admin": "node scripts/apply-migration.mjs supabase/migrations/20250616000000_storage_import_admin.sql",
    "setup:author-on-delete": "node scripts/apply-migration.mjs supabase/migrations/20250617000000_author_on_delete_set_null.sql",
    "setup:posts-delete-own": "node scripts/apply-migration.mjs supabase/migrations/20250618000000_posts_delete_own.sql",
    "setup:fix-kgw-slug": "node scripts/apply-migration.mjs supabase/migrations/20250621000000_fix_kgw_post_slug.sql",
    "setup:posts-rejected-resubmit": "node scripts/apply-migration.mjs supabase/migrations/20250619000000_posts_rejected_resubmit.sql",
    "setup:assets-delete-own": "node scripts/apply-migration.mjs supabase/migrations/20250620000000_assets_delete_own.sql",
    "setup:auth-rate-limits": "node scripts/apply-migration.mjs supabase/migrations/20250707000000_auth_rate_limits.sql",
    "setup:auth-mfa": "node scripts/setup-auth-mfa.mjs",
    "verify:auth-rate-limits": "node scripts/verify-rate-limits.mjs",
    "verify:auth-mfa": "node scripts/verify-mfa-enabled.mjs",
    "env:pull": "vercel env pull .env.local --yes",
    "version": "node -e \"import('./scripts/lib/git-info.mjs').then(m=>console.log(m.getVersionLabel()))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && node scripts/lint-ui-classes.mjs",
    "lint:ui": "node scripts/lint-ui-classes.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "astro": "^6.4.3",
    "marked": "^18.0.5",
    "pdfjs-dist": "^6.0.227",
    "tailwindcss": "^4.3.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  }
}
